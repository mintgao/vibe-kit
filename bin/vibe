class VibeError(RuntimeError):
    """A user-facing CLI error."""

    def __init__(
        self,
        message: str,
        code: str = "operation_error",
        write_state: str = "none",
        recovery: Optional[Dict[str, object]] = None,
    ) -> None:
        super().__init__(message)
        self.code = code
        if write_state not in WRITE_STATES:
            raise ValueError(f"unknown write state: {write_state}")
        self.write_state = write_state
        self.recovery = recovery


class RemoteFeedbackError(RuntimeError):
    """A recoverable remote feedback operation failure."""


def source_root() -> Path:
    return Path(__file__).resolve().parent.parent


def framework_version(root: Path) -> str:
    path = root / ".vibe/core/version"
    if not path.is_file():
        raise VibeError(f"Framework version is missing: {path}")
    return path.read_text(encoding="utf-8").strip()


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def atomic_write_text(path: Path, content: str, mode: Optional[int] = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=str(path.parent), delete=False
    ) as handle:
        handle.write(content)
        temporary = Path(handle.name)
    if mode is not None:
        os.chmod(temporary, mode)
    os.replace(temporary, path)


def atomic_write_bytes(path: Path, content: bytes, mode: Optional[int] = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("wb", dir=str(path.parent), delete=False) as handle:
        handle.write(content)
        temporary = Path(handle.name)
    if mode is not None:
        os.chmod(temporary, mode)
    os.replace(temporary, path)


def atomic_copy(source: Path, target: Path) -> None:
    if source.resolve() == target.resolve():
        return
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("wb", dir=str(target.parent), delete=False) as handle:
        temporary = Path(handle.name)
        with source.open("rb") as incoming:
            shutil.copyfileobj(incoming, handle)
    shutil.copymode(source, temporary)
    os.replace(temporary, target)


def atomic_write_json(path: Path, value: object) -> None:
    atomic_write_text(
        path,
        json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
    )


def print_json(value: object) -> None:
    print(json.dumps(value, ensure_ascii=False, sort_keys=True))


def result_envelope(command: str, status: str, **values: object) -> Dict[str, object]:
    allowed_statuses = AGENT_COMMAND_STATUSES.get(command)
    if allowed_statuses is not None and status not in allowed_statuses:
        raise ValueError(f"unknown {command} result status: {status}")
    result: Dict[str, object] = {
        "schema_version": AGENT_RESULT_SCHEMA,
        "command": command,
        "status": status,
    }
    result.update(values)
    return result


def writes_performed(write_state: str) -> bool:
    if write_state not in WRITE_STATES:
        raise ValueError(f"unknown write state: {write_state}")
    return write_state != "none"


def mutation_recovery(target: Path) -> Dict[str, object]:
    return {
        "action": "inspect-before-retry",
        "target": str(target),
        "steps": [
            "Inspect the scoped Vibe Kit paths and preserve any conflict evidence.",
            f"Run {target / 'bin/vibe'} doctor {target} when the installed CLI is runnable.",
            "Recover with Git or the same selected trusted payload; do not blindly retry.",
        ],
    }


def mutation_filesystem_error(
    operation: str, target: Path, error: BaseException
) -> VibeError:
    return VibeError(
        f"{operation} encountered a filesystem error after project mutation began: {error}",
        "filesystem_error",
        "unknown-partial",
        mutation_recovery(target),
    )


def validate_source_provenance(
    source_type: str,
    source_ref: Optional[str],
    artifact_sha256: Optional[str],
    version: str,
) -> Dict[str, object]:
    if source_type not in SOURCE_TYPES:
        raise VibeError(
            f"source type must be one of {', '.join(SOURCE_TYPES)}",
            "invalid_source_type",
        )
    normalized_ref = source_ref.strip() if source_ref is not None else None
    normalized_digest = (
        artifact_sha256.strip().lower() if artifact_sha256 is not None else None
    )
    if source_ref is not None and not normalized_ref:
        raise VibeError("source ref must not be empty", "invalid_source_ref")
    if artifact_sha256 is not None and not re.fullmatch(
        r"[0-9a-f]{64}", normalized_digest or ""
    ):
        raise VibeError(
            "artifact SHA-256 must contain exactly 64 hexadecimal characters",
            "invalid_artifact_sha256",
        )
    immutable_ref = False
    if normalized_ref is not None:
        immutable_ref = bool(
            re.fullmatch(r"[0-9a-fA-F]{40,64}", normalized_ref)
            or re.fullmatch(r"v?\d+\.\d+\.\d+", normalized_ref)
            or re.fullmatch(
                r"https://github\.com/mintgao/vibe-kit/(?:releases/tag|tree)/v?\d+\.\d+\.\d+/?",
                normalized_ref,
            )
        )
        if not immutable_ref:
            raise VibeError(
                "source ref must be an exact SemVer tag, canonical Release/tag URL, or commit digest",
                "invalid_source_ref",
            )
        ref_version_match = re.search(r"v?(\d+\.\d+\.\d+)/?$", normalized_ref)
        if ref_version_match and ref_version_match.group(1) != version:
            raise VibeError(
                f"source ref version {ref_version_match.group(1)} does not match payload version {version}",
                "source_version_mismatch",
            )
    if source_type in ("github-release", "offline-bundle"):
        if normalized_ref is None:
            raise VibeError(
                f"{source_type} requires an immutable source ref",
                "missing_source_ref",
            )
        if normalized_digest is None:
            raise VibeError(
                f"{source_type} requires the verified artifact SHA-256",
                "missing_artifact_sha256",
            )
    if source_type == "plugin-bundled" and normalized_ref is None:
        normalized_ref = version
    return {
        "type": source_type,
        "ref": normalized_ref,
        "artifact_sha256": normalized_digest,
        "payload_tree_sha256": payload_tree_sha256(source_root()),
    }


def is_iso8601(value: object) -> bool:
    if not isinstance(value, str) or not value.strip():
        return False
    candidate = value.strip()
    try:
        dt.datetime.fromisoformat(candidate.replace("Z", "+00:00"))
        return True
    except ValueError:
        try:
            dt.date.fromisoformat(candidate)
            return True
        except ValueError:
            return False


def onboarding_readiness(target: Path) -> Tuple[str, List[str]]:
    path = target / ONBOARDING_PATH
    if not path.is_file():
        return "review-required", [
            "onboarding state is missing; review repository context before substantive work"
        ]
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise VibeError(
            f"invalid onboarding state {path}: {error}",
            "invalid_onboarding_state",
        ) from error
    if not isinstance(value, dict) or value.get("schema_version") != 1:
        raise VibeError(
            f"invalid onboarding state {path}: expected schema_version 1 object",
            "invalid_onboarding_state",
        )
    status = value.get("status")
    if status not in ONBOARDING_STATUSES:
        raise VibeError(
            f"invalid onboarding status in {path}; expected one of {', '.join(ONBOARDING_STATUSES)}",
            "invalid_onboarding_state",
        )
    if status == "complete":
        evidence = value.get("evidence")
        if not is_iso8601(value.get("updated_at")):
            raise VibeError(
                f"invalid onboarding state {path}: complete requires an ISO-8601 updated_at value",
                "invalid_onboarding_state",
            )
        if not isinstance(evidence, list) or not evidence or any(
            not isinstance(item, str) or not item.strip() for item in evidence
        ):
            raise VibeError(
                f"invalid onboarding state {path}: complete requires a non-empty string list of evidence paths",
                "invalid_onboarding_state",
            )
    return str(status), []


def onboarding_result(target: Path) -> Dict[str, object]:
    try:
        status, _ = onboarding_readiness(target)
    except VibeError:
        return {"status": "invalid", "kind": "derived"}
    kind = "persisted" if status in ONBOARDING_STATUSES else "derived"
    return {"status": status, "kind": kind}


def managed_source_files(root: Path) -> List[Path]:
    files: List[Path] = []
    for relative in ("AGENT_INSTALL.md", "agent-install.json", "bin/vibe"):
        explicit = root / relative
        if explicit.is_file():
            files.append(explicit)

    core = root / ".vibe/core"
    if core.is_dir():
        files.extend(path for path in core.rglob("*") if path.is_file())

    agents = root / ".codex/agents"
    if agents.is_dir():
        files.extend(path for path in agents.glob("vibe-*.toml") if path.is_file())

    skills = root / ".agents/skills"
    if skills.is_dir():
        for directory in skills.glob("vibe-*"):
            if directory.is_dir():
                files.extend(path for path in directory.rglob("*") if path.is_file())

    unique = {path.relative_to(root): path for path in files}
    return [unique[key] for key in sorted(unique, key=lambda item: item.as_posix())]


def extract_agents_block(text: str) -> Optional[str]:
    start_count = text.count(AGENTS_START)
    end_count = text.count(AGENTS_END)
    if start_count == 0 and end_count == 0:
        return None
    if start_count != 1 or end_count != 1:
        raise VibeError("AGENTS.md has malformed Vibe Kit managed markers.")
    start = text.index(AGENTS_START)
    end = text.index(AGENTS_END, start) + len(AGENTS_END)
    return text[start:end]


def incoming_agents_block(root: Path) -> str:
    source = root / "AGENTS.md"
    if not source.is_file():
        raise VibeError(f"Framework AGENTS.md is missing: {source}")
    block = extract_agents_block(source.read_text(encoding="utf-8"))
    if block is None:
        raise VibeError("Framework AGENTS.md does not contain managed markers.")
    return block


def strict_semver(value: object) -> bool:
    return isinstance(value, str) and re.fullmatch(r"\d+\.\d+\.\d+", value) is not None


def canonical_json_sha256(value: object) -> str:
    encoded = json.dumps(
        value, ensure_ascii=False, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def reject_duplicate_json_keys(pairs: Sequence[Tuple[str, object]]) -> Dict[str, object]:
    result: Dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON object key")
        result[key] = value
    return result


def load_json_object_strict(path: Path) -> Dict[str, object]:
    try:
        raw = path.read_bytes()
        text = raw.decode("utf-8")
        value = json.loads(text, object_pairs_hook=reject_duplicate_json_keys)
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
        raise VibeError(f"invalid JSON object: {path}") from error
    if not isinstance(value, dict):
        raise VibeError(f"invalid JSON object: {path}")
    return value


def payload_tree_sha256_from_hashes(hashes: Dict[str, str]) -> str:
    digest = hashlib.sha256()
    for relative, file_hash in sorted(hashes.items()):
        digest.update(relative.encode("utf-8"))
        digest.update(b"\0")
        digest.update(file_hash.encode("ascii"))
        digest.update(b"\n")
    return digest.hexdigest()


def payload_tree_sha256(root: Path) -> str:
    version = framework_version(root)
    hashes = {
        path.relative_to(root).as_posix(): sha256(path)
        for path in release_payload_files(root, version)
    }
    return payload_tree_sha256_from_hashes(hashes)


def load_agent_install_contract(root: Path) -> Dict[str, object]:
    path = root / "agent-install.json"
    try:
        return load_json_object_strict(path)
    except VibeError as error:
        raise VibeError(f"Agent-install contract is invalid: {path}") from error


def safe_project_relative_path(relative: object) -> Optional[PurePosixPath]:
    if not isinstance(relative, str) or not relative or "\\" in relative or ":" in relative:
        return None
    value = PurePosixPath(relative)
    if value.is_absolute() or any(part in ("", ".", "..") for part in value.parts):
        return None
    return value


def authenticated_path_state(
    root: Path, relative: str
) -> Tuple[str, Optional[str]]:
    """Return absent/regular/invalid without following a project-internal symlink."""
    value = safe_project_relative_path(relative)
    if value is None:
        return "invalid", None
    components: List[Tuple[Path, Tuple[int, int, int, int, int]]] = []
    current = root
    try:
        for index, part in enumerate(value.parts):
            current = current / part
            metadata = os.lstat(str(current))
            if stat.S_ISLNK(metadata.st_mode):
                return "invalid", None
            leaf = index == len(value.parts) - 1
            if leaf:
                if not stat.S_ISREG(metadata.st_mode):
                    return "invalid", None
            elif not stat.S_ISDIR(metadata.st_mode):
                return "invalid", None
            components.append(
                (
                    current,
                    (
                        metadata.st_mode,
                        metadata.st_dev,
                        metadata.st_ino,
                        metadata.st_size,
                        metadata.st_mtime_ns,
                    ),
                )
            )
    except FileNotFoundError:
        return "absent", None
    except OSError:
        return "invalid", None

    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    digest = hashlib.sha256()
    try:
        descriptor = os.open(str(current), flags)
        with os.fdopen(descriptor, "rb") as handle:
            opened = os.fstat(handle.fileno())
            if not stat.S_ISREG(opened.st_mode):
                return "invalid", None
            leaf_signature = components[-1][1]
            if (opened.st_mode, opened.st_dev, opened.st_ino, opened.st_size) != (
                leaf_signature[0],
                leaf_signature[1],
                leaf_signature[2],
                leaf_signature[3],
            ):
                return "invalid", None
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
        for path, signature in components:
            metadata = os.lstat(str(path))
            if stat.S_ISLNK(metadata.st_mode) or (
                metadata.st_mode,
                metadata.st_dev,
                metadata.st_ino,
                metadata.st_size,
                metadata.st_mtime_ns,
            ) != signature:
                return "invalid", None
    except OSError:
        return "invalid", None
    return "regular", digest.hexdigest()


def predecessor_migration_evidence(phase: str) -> Dict[str, object]:
    entry = PREDECESSOR_MIGRATION_ENTRY
    predecessor = entry["predecessor"]
    return {
        "schema_version": 1,
        "migration_id": entry["migration_id"],
        "phase": phase,
        "authentication": "target-cli-compiled-registry",
        "from_version": predecessor["framework_version"],
        "to_version": entry["target"]["framework_version"],
        "paths": list(PREDECESSOR_MIGRATION_PATHS),
        "predecessor_install_identity_sha256": predecessor[
            "install_identity_sha256"
        ],
        "predecessor_contract_set_sha256": "5ae7da78e4799f23056afc16b8b1511384b12db50dfb5209a64e5b465a71b15d",
        "registry_sha256": PREDECESSOR_MIGRATION_REGISTRY_SHA256,
    }


def validate_target_predecessor_migration_contract(root: Path) -> None:
    if framework_version(root) != "0.6.0":
        raise VibeError("predecessor migration is supported only by target 0.6.0")
    contract = load_agent_install_contract(root)
    try:
        protocol = load_json_object_strict(root / ".vibe/core/protocol.json")
    except VibeError as error:
        raise VibeError("target predecessor-migration protocol mirror is invalid") from error
    bridge = contract.get("maintenance_bridge")
    contract_mirror = (
        bridge.get("predecessor_migrations") if isinstance(bridge, dict) else None
    )
    protocol_mirror = protocol.get("predecessor_migrations")
    if (
        PREDECESSOR_MIGRATION_REGISTRY_SHA256
        != EXPECTED_PREDECESSOR_MIGRATION_REGISTRY_SHA256
        or not valid_predecessor_migration_mirror(contract_mirror)
        or not valid_predecessor_migration_mirror(protocol_mirror)
        or contract_mirror != protocol_mirror
    ):
        raise VibeError("target predecessor-migration registry mirror is invalid")


def authenticate_v050_predecessor(target: Path) -> bool:
    entry = PREDECESSOR_MIGRATION_ENTRY
    predecessor = entry["predecessor"]
    try:
        manifest_state, manifest_hash = authenticated_path_state(
            target, MANIFEST_PATH.as_posix()
        )
        installed_state, installed_hash = authenticated_path_state(
            target, INSTALLED_VERSION_PATH.as_posix()
        )
        core_version_state, core_version_hash = authenticated_path_state(
            target, ".vibe/core/version"
        )
        protocol_state, protocol_hash = authenticated_path_state(
            target, ".vibe/core/protocol.json"
        )
        agents_state, agents_hash = authenticated_path_state(target, "AGENTS.md")
        if (
            manifest_state != "regular"
            or installed_state != "regular"
            or core_version_state != "regular"
            or protocol_state != "regular"
            or agents_state != "regular"
        ):
            return False
        manifest = load_json_object_strict(target / MANIFEST_PATH)
        if authenticated_path_state(target, MANIFEST_PATH.as_posix()) != (
            "regular",
            manifest_hash,
        ):
            return False
        if (
            type(manifest.get("schema_version")) is not int
            or manifest.get("schema_version") != predecessor["manifest_schema"]
            or manifest.get("framework_version") != predecessor["framework_version"]
        ):
            return False
        official_version_hash = hashlib.sha256(b"0.5.0\n").hexdigest()
        if installed_hash != official_version_hash or core_version_hash != (
            official_version_hash
        ):
            return False
        managed_files = manifest.get("managed_files")
        agents_block_hash = manifest.get("agents_block_hash")
        if (
            not isinstance(managed_files, dict)
            or not isinstance(agents_block_hash, str)
            or re.fullmatch(r"[0-9a-f]{64}", agents_block_hash) is None
            or any(path in managed_files for path in PREDECESSOR_MIGRATION_PATHS)
        ):
            return False
        normalized_managed: Dict[str, str] = {}
        for relative, expected in managed_files.items():
            if (
                safe_project_relative_path(relative) is None
                or not isinstance(expected, str)
                or re.fullmatch(r"[0-9a-f]{64}", expected) is None
            ):
                return False
            state, actual = authenticated_path_state(target, relative)
            if state != "regular" or actual != expected:
                return False
            normalized_managed[relative] = expected
        if normalized_managed.get(".vibe/core/protocol.json") != protocol_hash:
            return False
        protocol = load_json_object_strict(target / ".vibe/core/protocol.json")
        if authenticated_path_state(target, ".vibe/core/protocol.json") != (
            "regular",
            protocol_hash,
        ):
            return False
        codex = (
            protocol.get("adapters", {}).get("codex", {})
            if isinstance(protocol.get("adapters"), dict)
            else {}
        )
        if (
            protocol.get("manifest_schema") != predecessor["manifest_schema"]
            or protocol.get("core_protocol") != predecessor["core_protocol"]
            or protocol.get("agent_install_protocol")
            != predecessor["agent_install_protocol"]
            or not isinstance(codex, dict)
            or codex.get("version") != predecessor["adapter_protocol"]
            or codex.get("core_protocol") != predecessor["core_protocol"]
        ):
            return False
        agents_text = (target / "AGENTS.md").read_text(encoding="utf-8")
        if authenticated_path_state(target, "AGENTS.md") != (
            "regular",
            agents_hash,
        ):
            return False
        agents_block = extract_agents_block(agents_text)
        if agents_block is None or sha256_text(agents_block) != agents_block_hash:
            return False
        identity = {
            "agents_block_hash": agents_block_hash,
            "framework_version": manifest["framework_version"],
            "managed_files": dict(sorted(normalized_managed.items())),
            "schema_version": manifest["schema_version"],
        }
        if canonical_json_sha256(identity) != predecessor["install_identity_sha256"]:
            return False
        for relative, expected in entry["paths"].items():
            state, actual = authenticated_path_state(target, relative)
            if state != "regular" or actual != expected:
                return False
    except (OSError, UnicodeError, VibeError, KeyError, TypeError):
        return False
    return True


def predecessor_migration_decision(target: Path) -> str:
    official_members = 0
    for relative, expected in PREDECESSOR_MIGRATION_ENTRY["paths"].items():
        state, actual = authenticated_path_state(target, relative)
        if state == "regular" and actual == expected:
            official_members += 1
    if official_members == 0:
        return "ordinary"
    if official_members != len(PREDECESSOR_MIGRATION_PATHS):
        return "conflict"
    return "eligible" if authenticate_v050_predecessor(target) else "conflict"


def normalized_agent_install_sha256(path: Path) -> str:
    value = load_json_object_strict(path)
    activation = value.get("activation")
    if not isinstance(activation, dict):
        raise VibeError("Agent-install activation contract is missing")
    declared = activation.get("activation_set_sha256")
    if not isinstance(declared, str) or re.fullmatch(r"[0-9a-f]{64}", declared) is None:
        raise VibeError("Agent-install activation-set digest is invalid")
    normalized = copy.deepcopy(value)
    normalized_activation = normalized["activation"]
    if not isinstance(normalized_activation, dict):
        raise VibeError("Agent-install activation contract is missing")
    normalized_activation["activation_set_sha256"] = ACTIVATION_DIGEST_SENTINEL
    encoded = json.dumps(
        normalized,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def normalized_agent_install_bytes_sha256(content: bytes) -> str:
    try:
        value = json.loads(
            content.decode("utf-8"), object_pairs_hook=reject_duplicate_json_keys
        )
    except (UnicodeError, json.JSONDecodeError, ValueError) as error:
        raise VibeError("Agent-install contract bytes are invalid") from error
    if not isinstance(value, dict) or not isinstance(value.get("activation"), dict):
        raise VibeError("Agent-install activation contract bytes are invalid")
    normalized = copy.deepcopy(value)
    normalized["activation"]["activation_set_sha256"] = ACTIVATION_DIGEST_SENTINEL
    canonical = json.dumps(
        normalized, ensure_ascii=False, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")
    return hashlib.sha256(canonical).hexdigest()


def reference_activation_identity_from_entries(
    entries: Dict[str, bytes], contract: Dict[str, object], protocol: Dict[str, object]
) -> Tuple[List[str], Dict[str, str], str]:
    """Independently recompute release activation identity from actual entry bytes."""
    paths = sorted(
        [
            relative
            for relative in entries
            if relative in ("AGENT_INSTALL.md", "agent-install.json", "bin/vibe")
            or relative.startswith(".vibe/core/")
            or relative.startswith(".agents/skills/vibe-")
            or relative.startswith(".codex/agents/vibe-")
        ]
        + ["AGENTS.md#managed-block"]
    )
    hashes: Dict[str, str] = {}
    for relative in paths:
        if relative == "AGENTS.md#managed-block":
            try:
                block = extract_agents_block(entries["AGENTS.md"].decode("utf-8"))
            except (KeyError, UnicodeError, VibeError) as error:
                raise VibeError("release AGENTS.md managed block is invalid") from error
            if block is None:
                raise VibeError("release AGENTS.md managed block is missing")
            hashes[relative] = hashlib.sha256(block.encode("utf-8")).hexdigest()
        elif relative == "agent-install.json":
            hashes[relative] = normalized_agent_install_bytes_sha256(entries[relative])
        else:
            hashes[relative] = hashlib.sha256(entries[relative]).hexdigest()
    adapter = contract.get("adapter")
    if not isinstance(adapter, dict):
        raise VibeError("release Agent-install adapter is invalid")
    fingerprint = {
        "kit_version": contract.get("kit_version"),
        "core_protocol": protocol.get("core_protocol"),
        "agent_install_schema": contract.get("schema_version"),
        "agent_install_protocol": contract.get("protocol_version"),
        "adapter_name": adapter.get("name"),
        "adapter_protocol": adapter.get("protocol"),
    }
    canonical = json.dumps(
        {"fingerprint": fingerprint, "path_hashes": dict(sorted(hashes.items()))},
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    return paths, dict(sorted(hashes.items())), hashlib.sha256(canonical).hexdigest()


def activation_paths(root: Path) -> List[str]:
    paths = [
        path.relative_to(root).as_posix()
        for path in managed_source_files(root)
    ]
    paths.append("AGENTS.md#managed-block")
    return sorted(paths)


def activation_path_hashes(root: Path, paths: Sequence[str]) -> Dict[str, str]:
    hashes: Dict[str, str] = {}
    for relative in paths:
        if relative == "AGENTS.md#managed-block":
            hashes[relative] = sha256_text(incoming_agents_block(root))
            continue
        path = root / relative
        if not path.is_file():
            raise VibeError(f"Activation path is missing: {relative}")
        hashes[relative] = (
            normalized_agent_install_sha256(path)
            if relative == "agent-install.json"
            else sha256(path)
        )
    return dict(sorted(hashes.items()))


def activation_fingerprint_base(root: Path) -> Dict[str, object]:
    protocol = release_protocol(root)
    contract = load_agent_install_contract(root)
    adapter = contract.get("adapter")
    if not isinstance(adapter, dict):
        raise VibeError("Agent-install adapter contract is missing")
    return {
        "kit_version": framework_version(root),
        "core_protocol": protocol.get("core_protocol"),
        "agent_install_schema": contract.get("schema_version"),
        "agent_install_protocol": contract.get("protocol_version"),
        "adapter_name": adapter.get("name"),
        "adapter_protocol": adapter.get("protocol"),
    }


def activation_set_digest(
    fingerprint: Dict[str, object], path_hashes: Dict[str, str]
) -> str:
    return canonical_json_sha256(
        {"fingerprint": fingerprint, "path_hashes": dict(sorted(path_hashes.items()))}
    )


def source_activation_identity(root: Path) -> Dict[str, object]:
    paths = activation_paths(root)
    path_hashes = activation_path_hashes(root, paths)
    fingerprint = activation_fingerprint_base(root)
    digest = activation_set_digest(fingerprint, path_hashes)
    return {
        "fingerprint": {
            **fingerprint,
            "manifest_sha256": None,
            "activation_set_sha256": digest,
        },
        "paths": paths,
        "path_hashes": path_hashes,
        "activation_set_sha256": digest,
    }


def merge_agents_text(current: str, incoming_block: str) -> str:
    current_block = extract_agents_block(current)
    if current_block is None:
        if not current.strip():
            return incoming_block + "\n\n"
        return incoming_block + "\n\n" + current.lstrip()
    return current.replace(current_block, incoming_block, 1)


def json_scalar(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def detect_package_manager(target: Path) -> str:
    if (target / "pnpm-lock.yaml").exists():
        return "pnpm"
    if (target / "yarn.lock").exists():
        return "yarn"
    if (target / "bun.lockb").exists() or (target / "bun.lock").exists():
        return "bun"
    return "npm"


def js_script_command(manager: str, script: str) -> str:
    if manager == "npm":
        return f"npm run {script}"
    if manager == "bun":
        return f"bun run {script}"
    return f"{manager} {script}"


def detect_project(target: Path) -> Tuple[str, str, Dict[str, str]]:
    language = "Unknown"
    framework = "Unknown"
    commands = {"install": "", "lint": "", "typecheck": "", "test": "", "build": ""}

    package_path = target / "package.json"
    if package_path.is_file():
        language = "TypeScript" if (target / "tsconfig.json").exists() else "JavaScript"
        framework = "Node.js"
        try:
            package = json.loads(package_path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            package = {}
        dependencies: Dict[str, object] = {}
        for key in ("dependencies", "devDependencies", "peerDependencies"):
            value = package.get(key, {}) if isinstance(package, dict) else {}
            if isinstance(value, dict):
                dependencies.update(value)
        if "next" in dependencies:
            framework = "Next.js"
        elif "nuxt" in dependencies:
            framework = "Nuxt"
        elif "@sveltejs/kit" in dependencies:
            framework = "SvelteKit"
        elif "vite" in dependencies:
            framework = "Vite"
        elif "react" in dependencies:
            framework = "React"
        elif "vue" in dependencies:
            framework = "Vue"

        manager = detect_package_manager(target)
        if manager == "pnpm":
            commands["install"] = "pnpm install --frozen-lockfile"
        elif manager == "yarn":
            commands["install"] = "yarn install --frozen-lockfile"
        elif manager == "bun":
            commands["install"] = "bun install --frozen-lockfile"
        elif (target / "package-lock.json").exists():
            commands["install"] = "npm ci"
        else:
            commands["install"] = "npm install"

        scripts = package.get("scripts", {}) if isinstance(package, dict) else {}
        if isinstance(scripts, dict):
            for key in VERIFY_ORDER:
                if key in scripts:
                    commands[key] = js_script_command(manager, key)
            if not commands["typecheck"] and "check" in scripts:
                commands["typecheck"] = js_script_command(manager, "check")
        return language, framework, commands

    pyproject = target / "pyproject.toml"
    requirements = target / "requirements.txt"
    if pyproject.is_file() or requirements.is_file() or (target / "setup.py").is_file():
        language = "Python"
        framework = "Python"
        evidence = ""
        for path in (pyproject, requirements):
            if path.is_file():
                evidence += path.read_text(encoding="utf-8", errors="ignore").lower()
        if "django" in evidence:
            framework = "Django"
        elif "fastapi" in evidence:
            framework = "FastAPI"
        elif "flask" in evidence:
            framework = "Flask"
        if "ruff" in evidence:
            commands["lint"] = "ruff check ."
        if "mypy" in evidence:
            commands["typecheck"] = "mypy ."
        if "pytest" in evidence or (target / "pytest.ini").exists():
            commands["test"] = "pytest"
        return language, framework, commands

    if (target / "Cargo.toml").is_file():
        return "Rust", "Cargo", {
            "install": "",
            "lint": "cargo fmt --check",
            "typecheck": "cargo check",
            "test": "cargo test",
            "build": "cargo build",
        }
    if (target / "go.mod").is_file():
        return "Go", "Go modules", {
            "install": "go mod download",
            "lint": "gofmt -l .",
            "typecheck": "go vet ./...",
            "test": "go test ./...",
            "build": "go build ./...",
        }
    if (target / "Package.swift").is_file():
        return "Swift", "Swift Package Manager", {
            "install": "swift package resolve",
            "lint": "",
            "typecheck": "",
            "test": "swift test",
            "build": "swift build",
        }
    return language, framework, commands


def project_yaml(
    target: Path, lifecycle: str, name: Optional[str] = None
) -> Tuple[str, str, str]:
    language, framework, commands = detect_project(target)
    project_name = name or target.resolve().name
    lines = [
        "schema_version: 1",
        "project:",
        f"  name: {json_scalar(project_name)}",
        f"  lifecycle: {json_scalar(lifecycle)}",
        "stack:",
        f"  language: {json_scalar(language)}",
        f"  framework: {json_scalar(framework)}",
        "commands:",
    ]
    for key in ("install",) + VERIFY_ORDER:
        lines.append(f"  {key}: {json_scalar(commands.get(key, ''))}")
    lines.extend(("feedback:", '  mode: "ask"'))
    return "\n".join(lines) + "\n", language, framework


def render_template(source: Path, replacements: Dict[str, str]) -> str:
    content = source.read_text(encoding="utf-8")
    for key, value in replacements.items():
        content = content.replace("{{" + key + "}}", value)
    return content


def ensure_project_owned_files(
    source: Path,
    target: Path,
    lifecycle: str,
    name: Optional[str],
) -> List[Path]:
    created: List[Path] = []
    yaml_content, language, framework = project_yaml(target, lifecycle, name)
    project_config = target / ".vibe/project.yaml"
    if not project_config.exists():
        atomic_write_text(project_config, yaml_content)
        created.append(project_config)

    rules = target / ".vibe/project-rules.md"
    if not rules.exists():
        atomic_copy(source / "templates/project/project-rules.md", rules)
        created.append(rules)

    onboarding = target / ONBOARDING_PATH
    if not onboarding.exists():
        atomic_copy(source / "templates/project/onboarding.json", onboarding)
        created.append(onboarding)

    replacements = {"LANGUAGE": language, "FRAMEWORK": framework}
    for filename in ("product.md", "architecture.md", "design-system.md"):
        destination = target / "docs/context" / filename
        if not destination.exists():
            content = render_template(source / "templates/context" / filename, replacements)
            atomic_write_text(destination, content)
            created.append(destination)

    work_index = target / "docs/work-items/index.md"
    if not work_index.exists():
        atomic_write_text(
            work_index,
            "# Work items\n\nCreate one with `./bin/vibe work-item <slug> --size M`.\n",
        )
        created.append(work_index)
    decision_index = target / "docs/decisions/index.md"
    if not decision_index.exists():
        atomic_write_text(
            decision_index,
            "# Decision records\n\nRecord durable architectural choices here when the tradeoff matters beyond one work item.\n",
        )
        created.append(decision_index)
    return created


def write_manifest(
    target: Path,
    version: str,
    managed_hashes: Dict[str, str],
    agents_block_hash: str,
    provenance: Dict[str, object],
) -> None:
    activation = source_activation_identity(source_root())
    manifest = {
        "schema_version": 1,
        "framework_version": version,
        "managed_files": dict(sorted(managed_hashes.items())),
        "agents_block_hash": agents_block_hash,
        "source": provenance,
        "target_fingerprint": activation["fingerprint"],
        "activation": {
            "algorithm": ACTIVATION_SET_ALGORITHM,
            "paths": activation["paths"],
            "path_hashes": activation["path_hashes"],
            "activation_set_sha256": activation["activation_set_sha256"],
            "runtime_discovery_roots": list(RUNTIME_DISCOVERY_ROOTS),
        },
    }
    atomic_write_text(
        target / MANIFEST_PATH,
        json.dumps(manifest, ensure_ascii=False, indent=2) + "\n",
    )
    atomic_write_text(target / INSTALLED_VERSION_PATH, version + "\n")


def load_manifest(target: Path) -> Dict[str, object]:
    path = target / MANIFEST_PATH
    if not path.is_file():
        raise VibeError(f"Vibe Kit is not installed: {path} is missing.")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as error:
        raise VibeError(f"Cannot read manifest {path}: {error}") from error
    if not isinstance(data.get("managed_files"), dict):
        raise VibeError(f"Invalid managed file manifest: {path}")
    return data


def read_version_file(path: Path) -> Tuple[Optional[str], str]:
    if not path.is_file():
        return None, "<missing>"
    try:
        value = path.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError) as error:
        return None, f"<unreadable: {error}>"
    if not value:
        return None, "<empty>"
    return value, value


def read_manifest_for_doctor(
    target: Path,
) -> Tuple[Optional[Dict[str, object]], Optional[str], str]:
    path = target / MANIFEST_PATH
    if not path.is_file():
        return None, None, "<missing>"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError, UnicodeError) as error:
        return None, None, f"<unreadable: {error}>"
    if not isinstance(data, dict):
        return None, None, "<invalid: expected JSON object>"
    raw_version = data.get("framework_version")
    if raw_version is None:
        return data, None, "<missing>"
    value = str(raw_version).strip()
    if not value:
        return data, None, "<empty>"
    return data, value, value


def version_integrity(
    target: Path, manifest_version: Optional[str], manifest_display: str
) -> Tuple[bool, str]:
    installed, installed_display = read_version_file(target / INSTALLED_VERSION_PATH)
    core, core_display = read_version_file(target / ".vibe/core/version")
    values = (installed, manifest_version, core)
    if all(value is not None for value in values) and len(set(values)) == 1:
        return True, str(installed)

    quoted_target = shlex.quote(str(target))
    quoted_cli = shlex.quote(str(target / "bin/vibe"))
    diagnostic = "\n".join(
        (
            "Vibe Kit version integrity failed:",
            f"  .vibe/version: {installed_display}",
            f"  manifest.framework_version: {manifest_display}",
            f"  .vibe/core/version: {core_display}",
            "Repair from the trusted Vibe Kit checkout for the version you intend to install:",
            f"  /path/to/vibe-kit/bin/vibe upgrade {quoted_target}",
            "Then rerun:",
            f"  {quoted_cli} doctor {quoted_target}",
        )
    )
    return False, diagnostic


def install(
    command: str,
    target: Path,
    name: Optional[str],
    output_format: str,
    source_type: str,
    source_ref: Optional[str],
    artifact_sha256: Optional[str],
) -> int:
    source = source_root()
    version = framework_version(source)
    provenance = validate_source_provenance(
        source_type, source_ref, artifact_sha256, version
    )
    target = target.resolve()
    if command == "adopt" and (not target.is_dir() or not any(target.iterdir())):
        raise VibeError("adopt requires a non-empty existing project; use init instead.")
    if (target / MANIFEST_PATH).exists():
        raise VibeError("Vibe Kit is already installed; use upgrade instead.")

    files = managed_source_files(source)
    if not files:
        raise VibeError("No managed framework files were found in the source checkout.")
    collisions: List[str] = []
    for incoming in files:
        relative = incoming.relative_to(source)
        existing = target / relative
        if existing.exists() and existing.resolve() != incoming.resolve():
            if not existing.is_file() or sha256(existing) != sha256(incoming):
                collisions.append(relative.as_posix())
    agents_path = target / "AGENTS.md"
    current_agents = ""
    if agents_path.exists():
        current_agents = agents_path.read_text(encoding="utf-8")
        extract_agents_block(current_agents)
    if collisions:
        joined = "\n  - ".join(collisions)
        raise VibeError(
            "Installation stopped before making changes because managed paths already exist:\n"
            f"  - {joined}\nMove or rename them, then retry."
        )

    block = incoming_agents_block(source)
    try:
        target.mkdir(parents=True, exist_ok=True)
        for incoming in files:
            atomic_copy(incoming, target / incoming.relative_to(source))

        atomic_write_text(agents_path, merge_agents_text(current_agents, block))
        lifecycle = "new" if command == "init" else "existing"
        created = ensure_project_owned_files(source, target, lifecycle, name)

        managed_hashes = {
            incoming.relative_to(source).as_posix(): sha256(
                target / incoming.relative_to(source)
            )
            for incoming in files
        }
        write_manifest(target, version, managed_hashes, sha256_text(block), provenance)
    except (OSError, UnicodeError) as error:
        raise mutation_filesystem_error(command, target, error) from error
    if output_format == "json":
        write_state = "project-files-written"
        activation = source_activation_identity(source)
        print_json(
            result_envelope(
                command,
                "success",
                operation=command,
                target=str(target),
                kit_version=version,
                source=provenance,
                write_state=write_state,
                writes_performed=writes_performed(write_state),
                managed_files_installed=len(managed_hashes),
                project_owned_files_created=len(created),
                onboarding=onboarding_result(target),
                target_fingerprint=activation["fingerprint"],
                activation={
                    "state": "not-proven",
                    "path": "none",
                    "manual_new_task_supported": True,
                    "same_task_reload_claimed": False,
                    "automatic_successor_handoff_claimed": False,
                },
                handoff={
                    "required": True,
                    "action": "create-new-project-task",
                    "instruction": "Open one new Codex task in this project; the new task loads the installed rules.",
                },
            )
        )
        return 0
    print(f"Vibe Kit {version} {command} complete: {target}")
    print(f"Managed files installed: {len(managed_hashes)}")
    print(f"Project-owned files created: {len(created)}")
    print("Start a new Codex task so AGENTS.md and repository skills are loaded.")
    print("In the new task, state the development goal normally; onboarding is automatic.")
    return 0


PROJECT_OWNED_INSTALL_PATHS = (
    ".vibe/project.yaml",
    ".vibe/project-rules.md",
    ONBOARDING_PATH.as_posix(),
    "docs/context/product.md",
    "docs/context/architecture.md",
    "docs/context/design-system.md",
    "docs/work-items/index.md",
    "docs/decisions/index.md",
)


def plan_entry(action: str, relative: str, note: str = "") -> Dict[str, str]:
    return {"action": action, "path": relative, "note": note}


def install_plan(operation: str, target: Path) -> Tuple[List[Dict[str, str]], str, str]:
    source = source_root()
    target = target.resolve()
    version = framework_version(source)
    if target.exists() and not target.is_dir():
        raise VibeError(f"target is not a directory: {target}")
    if operation == "adopt" and (
        not target.is_dir() or not any(target.iterdir())
    ):
        raise VibeError("adopt requires a non-empty existing project; use init instead.")
    if (target / MANIFEST_PATH).exists():
        raise VibeError("Vibe Kit is already installed; use plan upgrade instead.")

    entries: List[Dict[str, str]] = []
    for incoming in managed_source_files(source):
        relative = incoming.relative_to(source).as_posix()
        existing = target / relative
        if not existing.exists():
            entries.append(plan_entry("create", relative, "framework-managed"))
        elif existing.is_file() and sha256(existing) == sha256(incoming):
            entries.append(plan_entry("no-op", relative, "identical managed content"))
        else:
            entries.append(plan_entry("conflict", relative, "managed path already exists"))

    agents_path = target / "AGENTS.md"
    incoming_block = incoming_agents_block(source)
    if not agents_path.exists():
        entries.append(plan_entry("create", "AGENTS.md", "managed block"))
    elif not agents_path.is_file():
        entries.append(plan_entry("conflict", "AGENTS.md", "path is not a file"))
    else:
        current = agents_path.read_text(encoding="utf-8")
        current_block = extract_agents_block(current)
        merged = merge_agents_text(current, incoming_block)
        action = "no-op" if merged == current else "update"
        note = "managed block already current" if action == "no-op" else "merge managed block; preserve project instructions"
        entries.append(plan_entry(action, "AGENTS.md", note))

    for relative in PROJECT_OWNED_INSTALL_PATHS:
        action = "preserve" if (target / relative).exists() else "create"
        entries.append(plan_entry(action, relative, "project-owned"))
    for relative in (MANIFEST_PATH.as_posix(), INSTALLED_VERSION_PATH.as_posix()):
        action = "update" if (target / relative).exists() else "create"
        entries.append(plan_entry(action, relative, "installation state"))
    return entries, "<not installed>", version


def upgrade_plan(
    target: Path,
) -> Tuple[List[Dict[str, str]], str, str, List[Dict[str, object]]]:
    source = source_root()
    target = target.resolve()
    version = framework_version(source)
    if version == "0.6.0":
        validate_target_predecessor_migration_contract(source)
        migration_decision = predecessor_migration_decision(target)
    else:
        migration_decision = "ordinary"
    try:
        manifest = load_manifest(target)
    except VibeError:
        if migration_decision == "conflict":
            return (
                [
                    plan_entry(
                        "conflict", relative, PREDECESSOR_MIGRATION_CONFLICT_NOTE
                    )
                    for relative in PREDECESSOR_MIGRATION_PATHS
                ],
                "<invalid>",
                version,
                [],
            )
        raise
    previous = {str(key): str(value) for key, value in manifest["managed_files"].items()}
    incoming_files = managed_source_files(source)
    incoming_by_relative = {
        path.relative_to(source).as_posix(): path for path in incoming_files
    }
    entries: List[Dict[str, str]] = []

    for relative, incoming in incoming_by_relative.items():
        if relative in PREDECESSOR_MIGRATION_PATHS:
            if migration_decision == "eligible":
                entries.append(plan_entry("update", relative, PREDECESSOR_MIGRATION_NOTE))
                continue
            if migration_decision == "conflict":
                entries.append(
                    plan_entry(
                        "conflict", relative, PREDECESSOR_MIGRATION_CONFLICT_NOTE
                    )
                )
                continue
        destination = target / relative
        incoming_hash = sha256(incoming)
        recorded_hash = previous.get(relative)
        path_state, current_hash = authenticated_path_state(target, relative)
        if path_state == "absent":
            entries.append(plan_entry("create", relative, "missing managed file"))
            continue
        if path_state != "regular" or current_hash is None:
            entries.append(plan_entry("conflict", relative, "managed path is not a file"))
            continue
        if recorded_hash is None and current_hash != incoming_hash:
            entries.append(plan_entry("conflict", relative, "untracked managed path differs"))
        elif (
            recorded_hash is not None
            and current_hash != recorded_hash
            and incoming_hash != recorded_hash
            and current_hash != incoming_hash
        ):
            entries.append(plan_entry("conflict", relative, "local and incoming content both changed"))
        elif (
            recorded_hash is not None
            and current_hash != recorded_hash
            and incoming_hash == recorded_hash
        ):
            entries.append(plan_entry("preserve", relative, "local modification; source unchanged"))
        elif current_hash == incoming_hash:
            entries.append(plan_entry("no-op", relative, "already matches target release"))
        else:
            entries.append(plan_entry("update", relative, "managed release change"))

    for relative in sorted(set(previous) - set(incoming_by_relative)):
        entries.append(plan_entry("preserve", relative, "stale managed path; manual review"))

    agents_path = target / "AGENTS.md"
    incoming_block = incoming_agents_block(source)
    recorded_block_hash = str(manifest.get("agents_block_hash", ""))
    if not agents_path.exists():
        entries.append(plan_entry("create", "AGENTS.md", "missing managed block"))
    elif not agents_path.is_file():
        entries.append(plan_entry("conflict", "AGENTS.md", "path is not a file"))
    else:
        current_text = agents_path.read_text(encoding="utf-8")
        current_block = extract_agents_block(current_text)
        current_hash = sha256_text(current_block) if current_block is not None else ""
        incoming_hash = sha256_text(incoming_block)
        if recorded_block_hash and (
            current_hash != recorded_block_hash
            and incoming_hash != recorded_block_hash
            and current_hash != incoming_hash
        ):
            entries.append(plan_entry("conflict", "AGENTS.md", "local and incoming managed block both changed"))
        elif not recorded_block_hash and current_block is not None and current_hash != incoming_hash:
            entries.append(plan_entry("conflict", "AGENTS.md", "untracked managed block differs"))
        elif recorded_block_hash and current_hash != recorded_block_hash and incoming_hash == recorded_block_hash:
            entries.append(plan_entry("preserve", "AGENTS.md", "local managed-block modification; source unchanged"))
        else:
            merged = merge_agents_text(current_text, incoming_block)
            action = "no-op" if merged == current_text else "update"
            entries.append(plan_entry(action, "AGENTS.md", "managed block"))

    current_version = str(manifest.get("framework_version", "<unknown>"))
    for relative in (MANIFEST_PATH.as_posix(), INSTALLED_VERSION_PATH.as_posix()):
        path = target / relative
        expected_version = version + "\n" if relative == INSTALLED_VERSION_PATH.as_posix() else None
        if expected_version is not None and path.is_file() and path.read_text(encoding="utf-8") == expected_version:
            action = "no-op"
        else:
            action = "update"
        entries.append(plan_entry(action, relative, "installation state"))
    migrations = (
        [predecessor_migration_evidence("planned")]
        if migration_decision == "eligible"
        else []
    )
    return entries, current_version, version, migrations


def print_plan(
    operation: str,
    target: Path,
    entries: Sequence[Dict[str, str]],
    current: str,
    target_version: str,
    output_format: str,
    provenance: Dict[str, object],
    compatibility_migrations: Sequence[Dict[str, object]] = (),
) -> int:
    conflicts = [entry for entry in entries if entry["action"] == "conflict"]
    counts: Dict[str, int] = {}
    for entry in entries:
        counts[entry["action"]] = counts.get(entry["action"], 0) + 1
    if output_format == "json":
        values: Dict[str, object] = {
            "operation": operation,
            "target": str(target.resolve()),
            "current_version": current,
            "target_version": target_version,
            "source": provenance,
            "entries": list(entries),
            "counts": dict(sorted(counts.items())),
            "files_changed": False,
            "recovery": (
                {
                    "action": "inspect-conflicts",
                    "paths": [entry["path"] for entry in conflicts],
                }
                if conflicts
                else None
            ),
        }
        if compatibility_migrations:
            values["compatibility_migrations"] = list(compatibility_migrations)
        print_json(
            result_envelope(
                "plan",
                "blocked" if conflicts else "safe",
                **values,
            )
        )
        return 2 if conflicts else 0
    print(f"Vibe Kit plan: {operation}")
    print(f"Target: {target.resolve()}")
    print(f"Current version: {current}")
    print(f"Target version: {target_version}")
    print(f"Status: {'blocked' if conflicts else 'safe'}")
    for entry in entries:
        suffix = f" — {entry['note']}" if entry.get("note") else ""
        print(f"{entry['action'].upper():8} {entry['path']}{suffix}")
    summary = ", ".join(f"{key}={counts[key]}" for key in sorted(counts))
    print(f"Summary: {summary}")
    print("No files were changed.")
    return 2 if conflicts else 0


def plan(
    operation: str,
    target: Path,
    output_format: str,
    source_type: str,
    source_ref: Optional[str],
    artifact_sha256: Optional[str],
) -> int:
    version = framework_version(source_root())
    provenance = validate_source_provenance(
        source_type, source_ref, artifact_sha256, version
    )
    if operation in ("init", "adopt"):
        entries, current, target_version = install_plan(operation, target)
        compatibility_migrations: List[Dict[str, object]] = []
    else:
        entries, current, target_version, compatibility_migrations = upgrade_plan(
            target
        )
    return print_plan(
        operation,
        target,
        entries,
        current,
        target_version,
        output_format,
        provenance,
        compatibility_migrations,
    )


def write_conflict_candidates(
    source: Path, target: Path, conflicts: Sequence[Tuple[str, Optional[Path]]]
) -> Path:
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    root = target / ".vibe/conflicts" / stamp
    for relative, incoming in conflicts:
        candidate = root / (relative + ".incoming")
        if incoming is None:
            atomic_write_text(candidate, incoming_agents_block(source) + "\n")
        else:
            atomic_copy(incoming, candidate)
    return root


def unique_conflicts(
    conflicts: Sequence[Tuple[str, Optional[Path]]]
) -> List[Tuple[str, Optional[Path]]]:
    result: List[Tuple[str, Optional[Path]]] = []
    seen = set()
    for relative, incoming in conflicts:
        if relative not in seen:
            result.append((relative, incoming))
            seen.add(relative)
    return result


def report_upgrade_conflicts(
    source: Path,
    target: Path,
    version: str,
    provenance: Dict[str, object],
    conflicts: Sequence[Tuple[str, Optional[Path]]],
    output_format: str,
) -> int:
    conflicts = unique_conflicts(conflicts)
    try:
        root = write_conflict_candidates(source, target, conflicts)
    except (OSError, UnicodeError) as error:
        raise mutation_filesystem_error("upgrade", target, error) from error
    if output_format == "json":
        write_state = "conflict-evidence-written"
        print_json(
            result_envelope(
                "upgrade",
                "blocked",
                target=str(target),
                kit_version=version,
                source=provenance,
                write_state=write_state,
                writes_performed=writes_performed(write_state),
                managed_files_changed=False,
                conflict_candidates=str(root),
                conflicts=[relative for relative, _ in conflicts],
                recovery={"action": "inspect-conflict-candidates"},
            )
        )
        return 2
    print("Upgrade aborted; no managed framework files were changed.", file=sys.stderr)
    print(f"Incoming conflict candidates: {root}", file=sys.stderr)
    for relative, _ in conflicts:
        print(f"  - {relative}", file=sys.stderr)
    return 2


def report_upgrade_unknown_partial_migration(
    target: Path,
    version: str,
    provenance: Dict[str, object],
    error: BaseException,
    output_format: str,
) -> int:
    failure = mutation_filesystem_error("upgrade", target, error)
    if output_format == "json":
        print_json(
            result_envelope(
                "upgrade",
                "error",
                operation="upgrade",
                target=str(target),
                kit_version=version,
                source=provenance,
                error={"code": failure.code, "message": str(failure)},
                write_state=failure.write_state,
                writes_performed=True,
                recovery=failure.recovery,
                compatibility_migrations=[
                    predecessor_migration_evidence("unknown-partial")
                ],
            )
        )
        return 2
    print(f"error: {failure}", file=sys.stderr)
    return 2


def upgrade(
    target: Path,
    output_format: str,
    source_type: str,
    source_ref: Optional[str],
    artifact_sha256: Optional[str],
) -> int:
    source = source_root()
    target = target.resolve()
    version = framework_version(source)
    provenance = validate_source_provenance(
        source_type, source_ref, artifact_sha256, version
    )
    if version == "0.6.0":
        validate_target_predecessor_migration_contract(source)
        migration_decision = predecessor_migration_decision(target)
    else:
        migration_decision = "ordinary"
    try:
        manifest = load_manifest(target)
    except VibeError:
        if migration_decision == "conflict":
            return report_upgrade_conflicts(
                source,
                target,
                version,
                provenance,
                [
                    (relative, source / relative)
                    for relative in PREDECESSOR_MIGRATION_PATHS
                ],
                output_format,
            )
        raise
    previous = {str(key): str(value) for key, value in manifest["managed_files"].items()}
    incoming_files = managed_source_files(source)
    incoming_by_relative = {
        path.relative_to(source).as_posix(): path for path in incoming_files
    }
    conflicts: List[Tuple[str, Optional[Path]]] = []

    for relative, incoming in incoming_by_relative.items():
        if relative in PREDECESSOR_MIGRATION_PATHS:
            if migration_decision == "eligible":
                continue
            if migration_decision == "conflict":
                conflicts.append((relative, incoming))
                continue
        destination = target / relative
        incoming_hash = sha256(incoming)
        recorded_hash = previous.get(relative)
        if relative in PREDECESSOR_MIGRATION_PATHS:
            path_state, current_hash = authenticated_path_state(target, relative)
            if path_state == "absent":
                continue
            if path_state != "regular" or current_hash is None:
                conflicts.append((relative, incoming))
                continue
        else:
            if not destination.exists():
                continue
            if not destination.is_file():
                conflicts.append((relative, incoming))
                continue
            current_hash = sha256(destination)
        if recorded_hash is None:
            if current_hash != incoming_hash:
                conflicts.append((relative, incoming))
        elif (
            current_hash != recorded_hash
            and incoming_hash != recorded_hash
            and current_hash != incoming_hash
        ):
            conflicts.append((relative, incoming))

    agents_path = target / "AGENTS.md"
    incoming_block = incoming_agents_block(source)
    recorded_block_hash = str(manifest.get("agents_block_hash", ""))
    current_block: Optional[str] = None
    if agents_path.is_file():
        current_block = extract_agents_block(agents_path.read_text(encoding="utf-8"))
    incoming_block_hash = sha256_text(incoming_block)
    current_block_hash = sha256_text(current_block) if current_block is not None else ""
    if recorded_block_hash:
        if (
            current_block_hash != recorded_block_hash
            and incoming_block_hash != recorded_block_hash
            and current_block_hash != incoming_block_hash
        ):
            conflicts.append(("AGENTS.md", None))
    elif current_block is not None and current_block_hash != incoming_block_hash:
        conflicts.append(("AGENTS.md", None))

    if conflicts:
        return report_upgrade_conflicts(
            source, target, version, provenance, conflicts, output_format
        )

    if migration_decision == "eligible":
        try:
            validate_target_predecessor_migration_contract(source)
        except VibeError:
            return report_upgrade_conflicts(
                source,
                target,
                version,
                provenance,
                [
                    (relative, incoming_by_relative[relative])
                    for relative in PREDECESSOR_MIGRATION_PATHS
                ],
                output_format,
            )
        if predecessor_migration_decision(target) != "eligible":
            return report_upgrade_conflicts(
                source,
                target,
                version,
                provenance,
                [
                    (relative, incoming_by_relative[relative])
                    for relative in PREDECESSOR_MIGRATION_PATHS
                ],
                output_format,
            )

    project_mutation_started = False
    migration_mutation_started = False
    try:
        updated = 0
        preserved_local = 0
        new_hashes: Dict[str, str] = {}
        ordered_relatives = list(incoming_by_relative)
        if migration_decision == "eligible":
            ordered_relatives = list(PREDECESSOR_MIGRATION_PATHS) + [
                relative
                for relative in ordered_relatives
                if relative not in PREDECESSOR_MIGRATION_PATHS
            ]
        for relative in ordered_relatives:
            incoming = incoming_by_relative[relative]
            destination = target / relative
            incoming_hash = sha256(incoming)
            recorded_hash = previous.get(relative)
            if migration_decision == "eligible" and relative in (
                PREDECESSOR_MIGRATION_PATHS
            ):
                expected_predecessor_hash = PREDECESSOR_MIGRATION_ENTRY["paths"][
                    relative
                ]
                path_state, current_hash = authenticated_path_state(target, relative)
                if path_state != "regular" or current_hash != expected_predecessor_hash:
                    if project_mutation_started:
                        return report_upgrade_unknown_partial_migration(
                            target,
                            version,
                            provenance,
                            VibeError("predecessor migration member changed during apply"),
                            output_format,
                        )
                    return report_upgrade_conflicts(
                        source,
                        target,
                        version,
                        provenance,
                        [
                            (path, incoming_by_relative[path])
                            for path in PREDECESSOR_MIGRATION_PATHS
                        ],
                        output_format,
                    )
            else:
                current_hash = sha256(destination) if destination.is_file() else None
            if (
                recorded_hash is not None
                and current_hash is not None
                and current_hash != recorded_hash
                and incoming_hash == recorded_hash
            ):
                new_hashes[relative] = recorded_hash
                preserved_local += 1
                continue
            if current_hash != incoming_hash:
                project_mutation_started = True
                if relative in PREDECESSOR_MIGRATION_PATHS:
                    migration_mutation_started = True
                atomic_copy(incoming, destination)
                updated += 1
            new_hashes[relative] = incoming_hash

        stale = sorted(set(previous) - set(incoming_by_relative))
        for relative in stale:
            new_hashes[relative] = previous[relative]

        current_agents_text = (
            agents_path.read_text(encoding="utf-8") if agents_path.exists() else ""
        )
        if (
            recorded_block_hash
            and current_block_hash != recorded_block_hash
            and incoming_block_hash == recorded_block_hash
        ):
            new_block_hash = recorded_block_hash
            preserved_local += 1
        else:
            merged = merge_agents_text(current_agents_text, incoming_block)
            if merged != current_agents_text:
                project_mutation_started = True
                atomic_write_text(agents_path, merged)
                updated += 1
            new_block_hash = incoming_block_hash

        project_mutation_started = True
        write_manifest(target, version, new_hashes, new_block_hash, provenance)
    except (OSError, UnicodeError) as error:
        if migration_decision == "eligible" and migration_mutation_started:
            return report_upgrade_unknown_partial_migration(
                target, version, provenance, error, output_format
            )
        raise mutation_filesystem_error("upgrade", target, error) from error
    if output_format == "json":
        write_state = "project-files-written"
        activation = source_activation_identity(source)
        values: Dict[str, object] = {
            "target": str(target),
            "kit_version": version,
            "source": provenance,
            "write_state": write_state,
            "writes_performed": writes_performed(write_state),
            "managed_files_updated": updated,
            "locally_modified_entries_preserved": preserved_local,
            "stale_managed_paths_preserved": stale,
            "target_fingerprint": activation["fingerprint"],
            "activation": {
                "state": "not-proven",
                "path": "none",
                "manual_new_task_supported": True,
                "same_task_reload_claimed": False,
                "automatic_successor_handoff_claimed": False,
            },
        }
        if migration_decision == "eligible":
            values["compatibility_migrations"] = [
                predecessor_migration_evidence("applied")
            ]
        print_json(
            result_envelope(
                "upgrade",
                "success",
                **values,
            )
        )
        return 0
    print(f"Vibe Kit upgrade complete: {target}")
    print(f"Framework version: {version}")
    print(f"Managed files updated: {updated}")
    if preserved_local:
        print(f"Locally modified managed entries preserved: {preserved_local}")
    if stale:
        print(f"Stale managed paths preserved for manual review: {len(stale)}")
    return 0


def validate_skill(path: Path) -> List[str]:
    errors: List[str] = []
    content = path.read_text(encoding="utf-8", errors="replace")
    if not content.startswith("---\n"):
        errors.append(f"{path}: missing YAML frontmatter")
        return errors
    parts = content.split("---", 2)
    frontmatter = parts[1] if len(parts) == 3 else ""
    name_match = re.search(r"(?m)^name:\s*([^\s]+)\s*$", frontmatter)
    if not name_match:
        errors.append(f"{path}: missing skill name")
    else:
        name = name_match.group(1)
        if not re.fullmatch(r"[a-z0-9-]{1,63}", name):
            errors.append(f"{path}: invalid skill name {name!r}")
        if name != path.parent.name:
            errors.append(f"{path}: skill name does not match its folder")
    if not re.search(r"(?m)^description:\s*\S+", frontmatter):
        errors.append(f"{path}: missing skill description")
    if re.search(r"(?i)\b(TODO|TBD)\b", content):
        errors.append(f"{path}: unfinished placeholder")
    return errors


def validate_agent(path: Path) -> List[str]:
    content = path.read_text(encoding="utf-8", errors="replace")
    errors = []
    for key in ("name", "description", "developer_instructions"):
        if not re.search(rf"(?m)^{key}\s*=", content):
            errors.append(f"{path}: missing {key}")
    return errors


def bounded_diagnostic_detail(target: Path, detail: str) -> str:
    sanitized = detail.replace(str(target.resolve()), ".")
    sanitized = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", sanitized)
    sanitized = "".join(
        character
        for character in sanitized
        if character in "\n\t" or ord(character) >= 32
    )
    encoded = sanitized.encode("utf-8", errors="replace")
    if len(encoded) > 512:
        encoded = encoded[:509]
        while True:
            try:
                sanitized = encoded.decode("utf-8") + "..."
                break
            except UnicodeDecodeError:
                encoded = encoded[:-1]
    else:
        sanitized = encoded.decode("utf-8", errors="replace")
    return sanitized


def doctor_diagnostic(
    target: Path, code: str, path: Optional[str], detail: str
) -> Dict[str, object]:
    registry = DIAGNOSTIC_REGISTRY.get(code)
    if registry is None:
        raise ValueError(f"unknown doctor diagnostic code: {code}")
    level, readiness_effect = registry
    return {
        "code": code,
        "level": level,
        "readiness_effect": readiness_effect,
        "path": path,
        "detail": bounded_diagnostic_detail(target, detail),
    }


def runtime_discovery_path(relative: str) -> bool:
    return (
        relative in ("AGENT_INSTALL.md", "agent-install.json", "bin/vibe")
        or relative.startswith(".vibe/core/")
        or relative.startswith(".agents/skills/")
        or relative.startswith(".codex/agents/")
        or relative == "AGENTS.md#managed-block"
    )


def doctor(target: Path, output_format: str) -> int:
    target = target.resolve()
    errors: List[str] = []
    warnings: List[str] = []
    diagnostics: List[Dict[str, object]] = []
    readiness = "review-required"
    readiness_kind = "derived"

    def add(code: str, detail: str, path: Optional[str] = None) -> None:
        diagnostic = doctor_diagnostic(target, code, path, detail)
        diagnostics.append(diagnostic)
        if diagnostic["level"] == "warning":
            warnings.append(detail)
        else:
            errors.append(detail)

    manifest, manifest_version, manifest_display = read_manifest_for_doctor(target)
    versions_ok, version_result = version_integrity(
        target, manifest_version, manifest_display
    )
    if not versions_ok:
        add("version-integrity-failed", version_result)

    if manifest is None:
        add(
            "manifest-missing-or-invalid",
            f"installation manifest is missing or invalid: {MANIFEST_PATH.as_posix()}",
            MANIFEST_PATH.as_posix(),
        )
    else:
        managed_files = manifest.get("managed_files")
        if not isinstance(managed_files, dict):
            add(
                "manifest-missing-or-invalid",
                f"invalid managed file manifest: {MANIFEST_PATH.as_posix()}",
                MANIFEST_PATH.as_posix(),
            )
            managed_files = {}
        for relative, expected in managed_files.items():
            relative_text = str(relative)
            path = target / relative_text
            if not path.is_file():
                add(
                    "managed-file-missing",
                    f"missing managed file: {relative_text}",
                    relative_text,
                )
            elif sha256(path) != str(expected):
                add(
                    "managed-file-hash-mismatch",
                    f"locally modified managed file: {relative_text}",
                    relative_text,
                )
        agents = target / "AGENTS.md"
        if not agents.is_file():
            add("agents-file-missing", "missing AGENTS.md", "AGENTS.md")
        else:
            try:
                block = extract_agents_block(agents.read_text(encoding="utf-8"))
            except (OSError, UnicodeError, VibeError) as error:
                block = None
                add(
                    "agents-block-missing",
                    f"invalid Vibe Kit block in AGENTS.md: {error}",
                    "AGENTS.md#managed-block",
                )
            if block is None:
                if not any(
                    item["code"] == "agents-block-missing" for item in diagnostics
                ):
                    add(
                        "agents-block-missing",
                        "missing Vibe Kit block in AGENTS.md",
                        "AGENTS.md#managed-block",
                    )
            elif manifest.get("agents_block_hash") and sha256_text(block) != manifest.get(
                "agents_block_hash"
            ):
                add(
                    "agents-block-hash-mismatch",
                    "locally modified Vibe Kit block in AGENTS.md",
                    "AGENTS.md#managed-block",
                )

        guide_path = target / "AGENT_INSTALL.md"
        guide_expected = managed_files.get("AGENT_INSTALL.md")
        if not guide_path.is_file() or not validate_agent_install_guide_bytes(
            guide_path.read_bytes() if guide_path.is_file() else b""
        ) or guide_expected != (sha256(guide_path) if guide_path.is_file() else None):
            add(
                "agent-install-guide-invalid",
                "installed Agent-install guide is missing, modified, or malformed",
                "AGENT_INSTALL.md",
            )

        contract_path = target / "agent-install.json"
        contract_value: Optional[Dict[str, object]] = None
        try:
            contract_value = load_agent_install_contract(target)
        except VibeError:
            pass
        protocol_value: Dict[str, object] = {}
        try:
            protocol_value = release_protocol(target)
        except VibeError:
            pass
        contract_takeover = (
            contract_value.get("takeover") if isinstance(contract_value, dict) else None
        )
        contract_activation = (
            contract_value.get("activation") if isinstance(contract_value, dict) else None
        )
        contract_expected = managed_files.get("agent-install.json")
        contract_valid = (
            isinstance(contract_value, dict)
            and contract_expected == sha256(contract_path)
            and not validate_agent_install_contract_shape(contract_value)
            and contract_value.get("kit_version") == manifest_version
            and protocol_value.get("core_protocol") == CORE_PROTOCOL
            and protocol_value.get("agent_install_protocol") == AGENT_INSTALL_PROTOCOL
            and protocol_value.get("takeover_contract_registry_sha256")
            == TAKEOVER_CONTRACT_REGISTRY_SHA256
            and valid_predecessor_migration_mirror(
                protocol_value.get("predecessor_migrations")
            )
            and isinstance(contract_takeover, dict)
            and contract_takeover.get("contract_registry_sha256")
            == TAKEOVER_CONTRACT_REGISTRY_SHA256
            and isinstance(contract_activation, dict)
        )
        if not contract_valid:
            add(
                "agent-install-contract-invalid",
                "installed Agent-install machine contract is missing, modified, or inconsistent",
                "agent-install.json",
            )

        activation = manifest.get("activation")
        fingerprint_value = manifest.get("target_fingerprint")
        activation_valid = isinstance(activation, dict) and isinstance(
            fingerprint_value, dict
        )
        if activation_valid:
            paths = activation.get("paths")
            expected_hashes = activation.get("path_hashes")
            expected_digest = activation.get("activation_set_sha256")
            roots = activation.get("runtime_discovery_roots")
            base_fingerprint = {
                key: fingerprint_value.get(key)
                for key in (
                    "kit_version",
                    "core_protocol",
                    "agent_install_schema",
                    "agent_install_protocol",
                    "adapter_name",
                    "adapter_protocol",
                )
            }
            activation_valid = (
                isinstance(paths, list)
                and paths == sorted(set(paths))
                and all(isinstance(item, str) and item for item in paths)
                and isinstance(expected_hashes, dict)
                and set(expected_hashes) == set(paths)
                and all(
                    isinstance(value, str)
                    and re.fullmatch(r"[0-9a-f]{64}", value)
                    for value in expected_hashes.values()
                )
                and isinstance(expected_digest, str)
                and re.fullmatch(r"[0-9a-f]{64}", expected_digest) is not None
                and activation.get("algorithm") == ACTIVATION_SET_ALGORITHM
                and roots == list(RUNTIME_DISCOVERY_ROOTS)
                and base_fingerprint
                == {
                    "kit_version": manifest_version,
                    "core_protocol": CORE_PROTOCOL,
                    "agent_install_schema": AGENT_INSTALL_SCHEMA,
                    "agent_install_protocol": AGENT_INSTALL_PROTOCOL,
                    "adapter_name": "codex",
                    "adapter_protocol": CODEX_ADAPTER_PROTOCOL,
                }
                and activation_set_digest(base_fingerprint, expected_hashes)
                == expected_digest
                and fingerprint_value.get("activation_set_sha256")
                == expected_digest
                and isinstance(contract_activation, dict)
                and contract_activation.get("activation_set_algorithm")
                == ACTIVATION_SET_ALGORITHM
                and contract_activation.get("activation_paths") == paths
                and contract_activation.get("activation_set_sha256") == expected_digest
            )
        if not activation_valid:
            add(
                "manifest-missing-or-invalid",
                "installation manifest activation identity is missing, unknown, or inconsistent",
                MANIFEST_PATH.as_posix(),
            )
        else:
            expected_paths = set(activation["paths"])
            stale_candidates = set(str(key) for key in managed_files) - expected_paths
            try:
                discovered = {
                    path.relative_to(target).as_posix()
                    for path in managed_source_files(target)
                }
                stale_candidates.update(discovered - expected_paths)
            except (OSError, UnicodeError) as error:
                add(
                    "diagnostic-internal-error",
                    f"could not inspect runtime discovery roots: {error}",
                )
            for relative in sorted(stale_candidates):
                code = (
                    "stale-runtime-path-preserved"
                    if runtime_discovery_path(relative)
                    else "stale-nonruntime-path-preserved"
                )
                add(code, f"stale managed path preserved: {relative}", relative)

            actual_hashes: Dict[str, str] = {}
            for relative in activation["paths"]:
                if relative == "AGENTS.md#managed-block":
                    agents_path = target / "AGENTS.md"
                    if agents_path.is_file():
                        try:
                            actual_block = extract_agents_block(
                                agents_path.read_text(encoding="utf-8")
                            )
                        except (OSError, UnicodeError, VibeError):
                            actual_block = None
                        if actual_block is not None:
                            actual_hashes[relative] = sha256_text(actual_block)
                    continue
                actual_path = target / relative
                if actual_path.is_file():
                    try:
                        actual_hashes[relative] = (
                            normalized_agent_install_sha256(actual_path)
                            if relative == "agent-install.json"
                            else sha256(actual_path)
                        )
                    except VibeError:
                        pass
            actual_digest = (
                activation_set_digest(base_fingerprint, actual_hashes)
                if set(actual_hashes) == expected_paths
                else None
            )
            manifest["_doctor_activation"] = {
                "status": "match" if actual_digest == expected_digest else "mismatch",
                "expected_activation_set_sha256": expected_digest,
                "actual_activation_set_sha256": actual_digest,
                "differing_paths": sorted(
                    relative
                    for relative in expected_paths
                    if actual_hashes.get(relative)
                    != activation["path_hashes"].get(relative)
                ),
                "stale_runtime_paths": sorted(
                    item for item in stale_candidates if runtime_discovery_path(item)
                ),
                "stale_nonruntime_paths": sorted(
                    item for item in stale_candidates if not runtime_discovery_path(item)
                ),
            }

    for required in (
        Path(".vibe/project.yaml"),
        Path(".vibe/project-rules.md"),
        Path(".vibe/core/operating-model.md"),
    ):
        if not (target / required).is_file():
            add(
                "required-project-file-missing",
                f"missing required file: {required.as_posix()}",
                required.as_posix(),
            )

    project_config = target / ".vibe/project.yaml"
    if project_config.is_file():
        try:
            parse_feedback_mode(project_config)
        except VibeError as error:
            add("project-config-invalid", str(error), ".vibe/project.yaml")

    if not (target / ONBOARDING_PATH).is_file():
        readiness = "review-required"
        readiness_kind = "derived"
        add(
            "onboarding-state-missing",
            "onboarding state is missing; review repository context before substantive work",
            ONBOARDING_PATH.as_posix(),
        )
    else:
        try:
            readiness, _ = onboarding_readiness(target)
            readiness_kind = (
                "persisted" if readiness in ONBOARDING_STATUSES else "derived"
            )
        except VibeError as error:
            add("onboarding-state-invalid", str(error), ONBOARDING_PATH.as_posix())
            readiness = "invalid"
            readiness_kind = "derived"

    for skill in (target / ".agents/skills").glob("vibe-*/SKILL.md"):
        for error in validate_skill(skill):
            add(
                "skill-contract-invalid",
                error,
                skill.relative_to(target).as_posix(),
            )
    for agent in (target / ".codex/agents").glob("vibe-*.toml"):
        for error in validate_agent(agent):
            add(
                "agent-contract-invalid",
                error,
                agent.relative_to(target).as_posix(),
            )

    if output_format == "json":
        status = "broken" if errors else ("warning" if warnings else "healthy")
        raw_manifest_sha256 = (
            sha256(target / MANIFEST_PATH)
            if (target / MANIFEST_PATH).is_file()
            else None
        )
        print_json(
            result_envelope(
                "doctor",
                status,
                target=str(target),
                kit_version=version_result if versions_ok else None,
                version_integrity={
                    "status": "ok" if versions_ok else "failed",
                    "detail": version_result,
                },
                onboarding={"status": readiness, "kind": readiness_kind},
                manifest_sha256=raw_manifest_sha256,
                target_fingerprint=(
                    {
                        **manifest.get("target_fingerprint", {}),
                        "manifest_sha256": raw_manifest_sha256,
                    }
                    if isinstance(manifest, dict)
                    and isinstance(manifest.get("target_fingerprint"), dict)
                    else None
                ),
                activation=(
                    manifest.get("_doctor_activation")
                    if isinstance(manifest, dict)
                    else None
                ),
                diagnostics=diagnostics,
                diagnostic_registry={
                    "non_blocking_warning_codes": list(
                        DOCTOR_NON_BLOCKING_WARNING_CODES
                    )
                },
                warnings=warnings,
                errors=errors,
                network_used=False,
            )
        )
        return 1 if errors else 0
    if versions_ok:
        print(f"Version integrity: OK ({version_result})")
    print(f"Onboarding readiness: {readiness}")
    for warning in warnings:
        print(f"WARN: {warning}")
    for error in errors:
        print(f"ERROR: {error}", file=sys.stderr)
    if errors:
        return 1
    print(
        f"Vibe Kit doctor passed with {len(warnings)} warning(s): {target}"
    )
    return 0


def parse_feedback_mode_value(raw: str, path: Path) -> str:
    value = raw.strip()
    if value.startswith('"'):
        match = re.fullmatch(r'("(?:[^"\\]|\\.)*")\s*(?:#.*)?', value)
        if not match:
            raise VibeError(f"invalid feedback.mode value in {path}")
        try:
            parsed = json.loads(match.group(1))
        except json.JSONDecodeError as error:
            raise VibeError(f"invalid feedback.mode value in {path}") from error
    elif value.startswith("'"):
        match = re.fullmatch(r"'([^']*)'\s*(?:#.*)?", value)
        if not match:
            raise VibeError(f"invalid feedback.mode value in {path}")
        parsed = match.group(1)
    else:
        match = re.fullmatch(r"([A-Za-z0-9_-]+)\s*(?:#.*)?", value)
        if not match:
            raise VibeError(f"invalid feedback.mode value in {path}")
        parsed = match.group(1)
    if parsed not in FEEDBACK_MODES:
        raise VibeError(
            f"feedback.mode must be one of {', '.join(FEEDBACK_MODES)} in {path}; "
            "fix the project-owned configuration before proactive feedback runs"
        )
    return str(parsed)


def parse_feedback_mode(path: Path) -> Tuple[str, str]:
    if not path.is_file():
        return "ask", "default-missing"
    section_count = 0
    mode_count = 0
    mode: Optional[str] = None
    in_feedback = False
    for line_number, raw_line in enumerate(
        path.read_text(encoding="utf-8").splitlines(), 1
    ):
        if re.match(r"^feedback\s*:", raw_line):
            if not re.fullmatch(r"feedback:\s*(?:#.*)?", raw_line):
                raise VibeError(
                    f"feedback section must be a block mapping in {path}:{line_number}"
                )
            section_count += 1
            if section_count > 1:
                raise VibeError(f"duplicate feedback section in {path}:{line_number}")
            in_feedback = True
            continue
        if not in_feedback:
            continue
        if not raw_line.strip() or raw_line.lstrip().startswith("#"):
            continue
        if raw_line[0] not in (" ", "\t"):
            in_feedback = False
            continue
        if "\t" in raw_line:
            raise VibeError(
                f"tabs are not allowed in the feedback section of {path}:{line_number}"
            )
        if re.match(r"^\s+mode\s*:", raw_line):
            match = re.match(r"^  mode:\s*(.*)$", raw_line)
            if not match:
                raise VibeError(
                    f"feedback.mode must use two-space indentation in {path}:{line_number}"
                )
            mode_count += 1
            if mode_count > 1:
                raise VibeError(f"duplicate feedback.mode in {path}:{line_number}")
            mode = parse_feedback_mode_value(match.group(1), path)
    if mode is None:
        return "ask", "default-missing"
    return mode, "project"


def feedback_mode(target: Path) -> Tuple[str, str]:
    return parse_feedback_mode(target.resolve() / ".vibe/project.yaml")


def feedback_mode_command(target: Path) -> int:
    mode, source = feedback_mode(target)
    print(f"Feedback mode: {mode}")
    print(f"Source: {source}")
    print("Network: not used")
    return 0


def parse_commands(path: Path) -> Dict[str, str]:
    commands: Dict[str, str] = {}
    in_commands = False
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        if raw_line.strip() == "commands:":
            in_commands = True
            continue
        if not in_commands:
            continue
        if raw_line and not raw_line.startswith(" "):
            break
        match = re.match(r"^\s{2}([A-Za-z0-9_-]+):\s*(.*)$", raw_line)
        if not match:
            continue
        key, raw_value = match.groups()
        raw_value = raw_value.strip()
        if not raw_value:
            commands[key] = ""
            continue
        try:
            value = json.loads(raw_value)
        except json.JSONDecodeError:
            value = raw_value
        commands[key] = str(value)
    return commands


def sanitize_verify_stream(target: Path, content: bytes) -> Tuple[str, bool]:
    text = content.decode("utf-8", errors="replace")
    text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text)
    text = "".join(
        character
        for character in text
        if character in "\n\t" or ord(character) >= 32
    )
    canonical_root = str(target.resolve())
    root_aliases = [canonical_root]
    if canonical_root.startswith("/private/"):
        root_aliases.append(canonical_root[len("/private"):])
    for root_alias in sorted(root_aliases, key=len, reverse=True):
        text = text.replace(root_alias, ".")
    for pattern in SECRET_PATTERNS:
        text = pattern.sub("[REDACTED]", text)
    encoded = text.encode("utf-8", errors="replace")
    truncated = len(encoded) > VERIFY_OUTPUT_LIMIT
    if truncated:
        encoded = encoded[-VERIFY_OUTPUT_LIMIT:]
        while True:
            try:
                text = encoded.decode("utf-8")
                break
            except UnicodeDecodeError:
                encoded = encoded[1:]
    else:
        text = encoded.decode("utf-8", errors="replace")
    return text, truncated


def verify_output(
    stdout: bytes, stderr: bytes, target: Path
) -> Dict[str, object]:
    stdout_tail, stdout_truncated = sanitize_verify_stream(target, stdout)
    stderr_tail, stderr_truncated = sanitize_verify_stream(target, stderr)
    return {
        "stdout_tail": stdout_tail,
        "stderr_tail": stderr_tail,
        "stdout_truncated": stdout_truncated,
        "stderr_truncated": stderr_truncated,
    }


def verify(target: Path, only: Sequence[str], output_format: str) -> int:
    target = target.resolve()
    config = target / ".vibe/project.yaml"
    if not config.is_file():
        raise VibeError(f"Project configuration is missing: {config}")
    commands = parse_commands(config)
    requested = [key for key in VERIFY_ORDER if key in set(only)] if only else []
    selected = requested if only else list(VERIFY_ORDER)
    checks: List[Dict[str, object]] = []
    for key in selected:
        command = commands.get(key, "")
        if not command:
            checks.append(
                {
                    "name": key,
                    "configured": False,
                    "applicability": "not-applicable",
                    "required": False,
                    "outcome": "unconfigured",
                    "exit_code": None,
                    "reason_code": "not-configured",
                    "provenance": {
                        "kind": "cli",
                        "task_id": None,
                        "operation_id": None,
                    },
                    "output": verify_output(b"", b"", target),
                }
            )
            continue
        if output_format == "text":
            print(f"\n==> {key}: {command}", flush=True)
        try:
            result = subprocess.run(
                command,
                cwd=str(target),
                shell=True,
                check=False,
                capture_output=True,
            )
        except OSError as error:
            captured = verify_output(b"", str(error).encode("utf-8"), target)
            checks.append(
                {
                    "name": key,
                    "configured": True,
                    "applicability": "applicable",
                    "required": True,
                    "outcome": "skipped",
                    "exit_code": None,
                    "reason_code": "process-start-failed",
                    "provenance": {
                        "kind": "cli",
                        "task_id": None,
                        "operation_id": None,
                    },
                    "output": captured,
                }
            )
            if output_format == "text":
                print(captured["stderr_tail"], file=sys.stderr, end="")
            continue
        captured = verify_output(result.stdout, result.stderr, target)
        outcome = "passed" if result.returncode == 0 else "failed"
        checks.append(
            {
                "name": key,
                "configured": True,
                "applicability": "applicable",
                "required": True,
                "outcome": outcome,
                "exit_code": result.returncode,
                "reason_code": None,
                "provenance": {
                    "kind": "cli",
                    "task_id": None,
                    "operation_id": None,
                },
                "output": captured,
            }
        )
        if output_format == "text":
            if captured["stdout_tail"]:
                print(captured["stdout_tail"], end="")
            if captured["stderr_tail"]:
                print(captured["stderr_tail"], file=sys.stderr, end="")

    summary = {
        outcome: sum(1 for check in checks if check["outcome"] == outcome)
        for outcome in ("passed", "failed", "unconfigured", "skipped")
    }
    if summary["skipped"]:
        status = "blocked"
        exit_code = 2
    elif summary["failed"]:
        status = "failed"
        exit_code = 1
    else:
        status = "passed"
        exit_code = 0
    if output_format == "json":
        print_json(
            result_envelope(
                "verify",
                status,
                target=str(target),
                selection={
                    "mode": "only" if only else "default",
                    "requested": requested,
                    "coverage": "partial" if only else "all-configured",
                },
                producer="cli",
                cli_invoked=True,
                checks=checks,
                summary=summary,
            )
        )
        return exit_code
    configured_names = [
        str(check["name"]) for check in checks if check["configured"]
    ]
    if not configured_names:
        print("No project verification checks are configured.")
    elif status == "passed":
        print("\nVerification passed: " + ", ".join(configured_names))
    elif status == "failed":
        failures = [
            f"{check['name']} ({check['exit_code']})"
            for check in checks
            if check["outcome"] == "failed"
        ]
        print("\nVerification failed: " + ", ".join(failures), file=sys.stderr)
    else:
        skipped = [
            str(check["name"])
            for check in checks
            if check["outcome"] == "skipped"
        ]
        print("\nVerification blocked: " + ", ".join(skipped), file=sys.stderr)
    return exit_code


def normalized_slug(value: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    if not slug:
        raise VibeError("Work-item slug must contain an ASCII letter or digit.")
    return slug


def work_item(target: Path, slug_value: str, size: str, title: Optional[str]) -> int:
    target = target.resolve()
    slug = normalized_slug(slug_value)
    date = dt.date.today().isoformat()
    identifier = dt.date.today().strftime("%Y%m%d") + "-" + slug
    destination = target / "docs/work-items" / identifier
    if destination.exists():
        raise VibeError(f"Work item already exists: {destination}")
    template_root = target / ".vibe/core/templates"
    if not template_root.is_dir():
        raise VibeError("Vibe Kit work-item templates are missing; run doctor or upgrade.")
    replacements = {
        "TITLE": title or slug.replace("-", " ").title(),
        "ID": identifier,
        "SIZE": size.upper(),
        "DATE": date,
    }
    destination.mkdir(parents=True)
    atomic_write_text(
        destination / "brief.md",
        render_template(template_root / "work-item-brief.md", replacements),
    )
    atomic_write_text(
        destination / "verification.md",
        render_template(template_root / "work-item-verification.md", replacements),
    )
    print(f"Created work item: {destination}")
    return 0


def release_payload_files(root: Path, version: str) -> List[Path]:
    files = list(managed_source_files(root))
    for relative in (
        "AGENTS.md",
        "AGENT_INSTALL.md",
        "agent-install.json",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
    ):
        path = root / relative
        if path.is_file():
            files.append(path)
    templates = root / "templates"
    if templates.is_dir():
        files.extend(path for path in templates.rglob("*") if path.is_file())
    release_notes = root / "docs/releases" / f"{version}.md"
    if release_notes.is_file():
        files.append(release_notes)
    unique = {path.relative_to(root): path for path in files}
    result = [unique[key] for key in sorted(unique, key=lambda item: item.as_posix())]
    for path in result:
        if path.is_symlink():
            raise VibeError(f"release payload cannot contain a symlink: {path}")
        if "__pycache__" in path.parts or path.suffix == ".pyc":
            raise VibeError(f"release payload contains generated Python cache: {path}")
    return result


def release_file_mode(relative: str) -> int:
    if relative == "bin/vibe" or relative.endswith("/scripts/vibe_from_plugin.py"):
        return 0o755
    return 0o644


def normalized_zip(
    destination: Path, entries: Dict[str, Tuple[bytes, int]]
) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(
        destination, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9
    ) as archive:
        for name in sorted(entries):
            if not archive_name_is_safe(name):
                raise VibeError(f"unsafe release archive path: {name}")
            content, mode = entries[name]
            info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            info.create_system = 3
            info.external_attr = ((0o100000 | mode) & 0xFFFF) << 16
            info.compress_type = zipfile.ZIP_DEFLATED
            archive.writestr(info, content, compress_type=zipfile.ZIP_DEFLATED, compresslevel=9)


def release_source_metadata(root: Path) -> Dict[str, object]:
    ref: Optional[str] = None
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--verify", "HEAD"],
            cwd=str(root),
            text=True,
            capture_output=True,
            check=False,
        )
        if result.returncode == 0 and re.fullmatch(r"[0-9a-fA-F]{40,64}", result.stdout.strip()):
            ref = result.stdout.strip().lower()
    except OSError:
        pass
    tree_state = "uncommitted"
    if ref is not None:
        try:
            status = subprocess.run(
                ["git", "status", "--porcelain", "--untracked-files=all"],
                cwd=str(root),
                text=True,
                capture_output=True,
                check=False,
            )
            if status.returncode == 0 and not status.stdout.strip():
                tree_state = "clean"
        except OSError:
            pass
    return {"type": "git-working-tree", "ref": ref, "tree_state": tree_state}


def plugin_source_entries(
    root: Path, version: str, expected_payload_tree_sha256: str
) -> Dict[str, Tuple[bytes, int]]:
    plugin_root = root / "distribution/plugin-src/vibe-kit"
    manifest_path = plugin_root / ".codex-plugin/plugin.json"
    if not manifest_path.is_file():
        raise VibeError(f"Plugin source is missing: {manifest_path}")
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise VibeError(f"Plugin manifest is invalid: {error}") from error
    if manifest.get("name") != "vibe-kit" or manifest.get("version") != version:
        raise VibeError("Plugin name/version must match the Vibe Kit release")
    if manifest.get("payload_tree_sha256") != expected_payload_tree_sha256:
        raise VibeError("Plugin payload-tree identity must match the Vibe Kit release payload")
    for forbidden in ("mcpServers", "hooks", "apps"):
        if forbidden in manifest:
            raise VibeError(f"bootstrap Plugin must not declare {forbidden}")
    skill_root = plugin_root / "skills"
    skills = sorted(path.name for path in skill_root.iterdir() if path.is_dir())
    if skills != ["vibe-bootstrap", "vibe-maintain"]:
        raise VibeError("bootstrap Plugin must contain exactly vibe-bootstrap and vibe-maintain")

    entries: Dict[str, Tuple[bytes, int]] = {}
    for path in sorted(plugin_root.rglob("*")):
        if not path.is_file():
            continue
        if path.is_symlink():
            raise VibeError(f"Plugin source cannot contain a symlink: {path}")
        if "__pycache__" in path.parts or path.suffix == ".pyc" or path.name == ".DS_Store":
            continue
        relative = path.relative_to(plugin_root).as_posix()
        entries[relative] = (path.read_bytes(), release_file_mode(relative))
    return entries


def release_protocol(root: Path) -> Dict[str, object]:
    path = root / ".vibe/core/protocol.json"
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise VibeError(f"release protocol is invalid: {error}") from error
    if not isinstance(value, dict):
        raise VibeError("release protocol must be a JSON object")
    return value


def release_marketplace_payload() -> Dict[str, object]:
    return {
        "name": "personal",
        "interface": {"displayName": "Personal Plugins"},
        "plugins": [
            {
                "name": "vibe-kit",
                "source": {"source": "local", "path": "./plugins/vibe-kit"},
                "policy": {
                    "installation": "AVAILABLE",
                    "authentication": "ON_INSTALL",
                },
                "category": "Productivity",
            }
        ],
    }


def package_release(output: Optional[Path], status: str) -> int:
    root = source_root()
    version = framework_version(root)
    validate_target_predecessor_migration_contract(root)
    destination = (
        output.resolve()
        if output is not None
        else (root / "dist" / f"vibe-kit-{version}").resolve()
    )
    if destination.exists() and not destination.is_dir():
        raise VibeError(f"release output is not a directory: {destination}")
    if destination.is_dir() and any(destination.iterdir()):
        raise VibeError(f"release output is not empty: {destination}")

    source_metadata = release_source_metadata(root)
    if status in ("prerelease", "stable") and (
        source_metadata.get("ref") is None
        or source_metadata.get("tree_state") != "clean"
    ):
        raise VibeError(
            f"{status} packaging requires a clean committed Git source; commit the reviewed tree first"
        )
    payload_entries: Dict[str, Tuple[bytes, int]] = {}
    for path in release_payload_files(root, version):
        relative = path.relative_to(root).as_posix()
        payload_entries[relative] = (path.read_bytes(), release_file_mode(relative))
    protocol = release_protocol(root)
    try:
        packaged_contract = json.loads(
            payload_entries["agent-install.json"][0].decode("utf-8"),
            object_pairs_hook=reject_duplicate_json_keys,
        )
        if not isinstance(packaged_contract, dict):
            raise ValueError("contract is not an object")
        _, _, packaged_activation_digest = reference_activation_identity_from_entries(
            {relative: value[0] for relative, value in payload_entries.items()},
            packaged_contract,
            protocol,
        )
        declared_activation_digest = packaged_contract.get("activation", {}).get(
            "activation_set_sha256"
        ) if isinstance(packaged_contract.get("activation"), dict) else None
        if declared_activation_digest != packaged_activation_digest:
            raise ValueError("activation digest is not finalized")
    except (KeyError, UnicodeError, json.JSONDecodeError, ValueError, VibeError) as error:
        raise VibeError(
            "release Agent-install activation identity must complete the v2 two-pass calculation"
        ) from error
    payload_hashes = {
        relative: hashlib.sha256(content).hexdigest()
        for relative, (content, _) in sorted(payload_entries.items())
    }
    payload_digest = payload_tree_sha256_from_hashes(payload_hashes)
    plugin_entries = plugin_source_entries(root, version, payload_digest)

    destination.mkdir(parents=True, exist_ok=True)
    release_name = f"vibe-kit-{version}.zip"
    plugin_name = f"vibe-kit-plugin-{version}.zip"
    release_archive = destination / release_name
    plugin_archive = destination / plugin_name
    normalized_zip(
        release_archive,
        {f"vibe-kit-{version}/{name}": value for name, value in payload_entries.items()},
    )
    combined_plugin_entries = {
        f"vibe-kit/{name}": value for name, value in plugin_entries.items()
    }
    combined_plugin_entries.update(
        {f"vibe-kit/payload/{name}": value for name, value in payload_entries.items()}
    )
    normalized_zip(plugin_archive, combined_plugin_entries)

    marketplace_root = destination / "marketplace"
    plugin_output = marketplace_root / "plugins/vibe-kit"
    for relative, (content, mode) in plugin_entries.items():
        atomic_write_bytes(plugin_output / relative, content, mode)
    for relative, (content, mode) in payload_entries.items():
        atomic_write_bytes(plugin_output / "payload" / relative, content, mode)
    marketplace_path = marketplace_root / "marketplace.json"
    atomic_write_json(marketplace_path, release_marketplace_payload())

    marketplace_files = {
        path.relative_to(marketplace_root).as_posix(): sha256(path)
        for path in sorted((marketplace_root / "plugins").rglob("*"))
        if path.is_file()
    }

    artifact_paths = [release_archive, plugin_archive, marketplace_path]
    artifacts = []
    for path in artifact_paths:
        artifacts.append(
            {
                "path": path.relative_to(destination).as_posix(),
                "sha256": sha256(path),
                "size": path.stat().st_size,
            }
        )
    manifest = {
        "schema_version": RELEASE_MANIFEST_SCHEMA,
        "status": status,
        "kit_version": version,
        "agent_install_schema": AGENT_INSTALL_SCHEMA,
        "manifest_schema": protocol.get("manifest_schema"),
        "core_protocol": protocol.get("core_protocol"),
        "feedback_protocol": protocol.get("feedback_protocol"),
        "agent_install_protocol": protocol.get("agent_install_protocol"),
        "takeover_contract_registry_sha256": protocol.get(
            "takeover_contract_registry_sha256"
        ),
        "predecessor_migrations": protocol.get("predecessor_migrations"),
        "takeover_schema": TAKEOVER_SCHEMA_VERSION,
        "maintenance_bridge_schema": MAINTENANCE_BRIDGE_SCHEMA_VERSION,
        "payload_tree_sha256": payload_digest,
        "activation_set_sha256": load_agent_install_contract(root).get(
            "activation", {}
        ).get("activation_set_sha256"),
        "adapters": protocol.get("adapters"),
        "runtime": {
            "python": ">=3.9",
            "os_supported": ["macOS", "Linux"],
            "os_tested_for_candidate": ["macOS"],
        },
        "source": source_metadata,
        "payload_files": payload_hashes,
        "marketplace_files": marketplace_files,
        "artifacts": artifacts,
    }
    manifest_path = destination / "release-manifest.json"
    atomic_write_json(manifest_path, manifest)
    checksum_paths = artifact_paths + [manifest_path] + [
        marketplace_root / relative for relative in marketplace_files
    ]
    checksums = "".join(
        f"{sha256(path)}  {path.relative_to(destination).as_posix()}\n"
        for path in sorted(checksum_paths, key=lambda item: item.relative_to(destination).as_posix())
    )
    atomic_write_text(destination / "SHA256SUMS", checksums)

    result = validate_release(destination)
    if result != 0:
        return result
    bundle_name = f"vibe-kit-distribution-{version}.zip"
    bundle_path = destination / bundle_name
    bundle_entries = {
        f"vibe-kit-{version}/{path.relative_to(destination).as_posix()}": (
            path.read_bytes(),
            release_file_mode(path.relative_to(destination).as_posix()),
        )
        for path in sorted(destination.rglob("*"))
        if path.is_file() and path != bundle_path
    }
    normalized_zip(bundle_path, bundle_entries)
    bundled_files, bundle_errors = read_normalized_archive(
        bundle_path, f"vibe-kit-{version}"
    )
    expected_bundle_files = {
        path.relative_to(destination).as_posix(): path.read_bytes()
        for path in sorted(destination.rglob("*"))
        if path.is_file() and path != bundle_path
    }
    if bundle_errors or bundled_files != expected_bundle_files:
        details = "; ".join(bundle_errors) or "bundle contents differ from release directory"
        raise VibeError(f"distribution bundle validation failed: {details}")
    print(f"Vibe Kit release candidate built: {destination}")
    print(f"Version: {version}")
    print(f"Artifacts: {release_name}, {plugin_name}, {bundle_name}, marketplace/")
    print(f"Distribution bundle SHA-256: {sha256(bundle_path)}")
    print(f"Publication status: {status}")
    return 0


def archive_name_is_safe(name: str) -> bool:
    if not name or name.startswith("/") or "\\" in name or ":" in name:
        return False
    path = PurePosixPath(name)
    return all(part not in ("", ".", "..") for part in path.parts)


def read_normalized_archive(path: Path, expected_root: str) -> Tuple[Dict[str, bytes], List[str]]:
    errors: List[str] = []
    entries: Dict[str, bytes] = {}
    try:
        with zipfile.ZipFile(path, "r") as archive:
            infos = archive.infolist()
            if len(infos) > RELEASE_ARCHIVE_MAX_FILES:
                errors.append(f"{path.name}: too many archive entries")
                return entries, errors
            total_size = 0
            for info in infos:
                name = info.filename
                if info.is_dir():
                    continue
                if not archive_name_is_safe(name):
                    errors.append(f"{path.name}: unsafe archive path {name!r}")
                    continue
                if info.flag_bits & 0x1:
                    errors.append(f"{path.name}: encrypted entries are not supported")
                    continue
                file_type = (info.external_attr >> 16) & 0o170000
                if file_type == 0o120000:
                    errors.append(f"{path.name}: symlink entries are not allowed")
                    continue
                if info.file_size > RELEASE_ARCHIVE_MAX_FILE_SIZE:
                    errors.append(f"{path.name}: entry is too large: {name}")
                    continue
                total_size += info.file_size
                if total_size > RELEASE_ARCHIVE_MAX_TOTAL_SIZE:
                    errors.append(f"{path.name}: uncompressed payload is too large")
                    break
                prefix = expected_root.rstrip("/") + "/"
                if not name.startswith(prefix):
                    errors.append(f"{path.name}: entry is outside expected root {expected_root}: {name}")
                    continue
                relative = name[len(prefix):]
                if not relative or relative in entries:
                    errors.append(f"{path.name}: invalid or duplicate entry {name}")
                    continue
                entries[relative] = archive.read(info)
    except (OSError, zipfile.BadZipFile) as error:
        errors.append(f"{path.name}: cannot read ZIP: {error}")
    return entries, errors


def validate_agent_install_contract_shape(contract: Dict[str, object]) -> List[str]:
    errors: List[str] = []
    expected_top_level = {
        "schema_version",
        "protocol_version",
        "kit_version",
        "adapter",
        "maintenance_bridge",
        "canonical_source",
        "release_channels",
        "source_identity",
        "lifecycle",
        "activation",
        "takeover",
        "cli",
        "onboarding",
        "privacy",
        "evolution",
        "trust",
    }
    if set(contract) != expected_top_level:
        errors.append("agent install contract top-level fields are unknown or incomplete")
    adapter = contract.get("adapter")
    expected_capabilities = {
        "same_task_reload": {
            "status": "conditional",
            "current_claim": False,
            "required_receipt": "host-reload",
        },
        "automatic_successor_handoff": {
            "status": "conditional",
            "current_claim": False,
            "required_receipt": "host-successor-start",
        },
        "manual_new_task": {
            "status": "supported",
            "required_receipt": "manual-task-start",
        },
    }
    if not isinstance(adapter, dict) or adapter.get("capabilities") != expected_capabilities:
        errors.append("agent install adapter capability claims are unsupported")

    bridge = contract.get("maintenance_bridge")
    expected_bridge = {
        "schema_version": MAINTENANCE_BRIDGE_SCHEMA_VERSION,
        "supported_installed_manifest_schemas": [1],
        "supported_installed_agent_protocols": [0, 1],
        "minimum_installed_kit_version": "0.2.0",
        "maximum_installed_kit_version_exclusive": "0.6.0",
        "target_agent_install_schema": AGENT_INSTALL_SCHEMA,
        "target_agent_install_protocol": AGENT_INSTALL_PROTOCOL,
        "target_cli_result_schema": AGENT_RESULT_SCHEMA,
        "predecessor_migrations": PREDECESSOR_MIGRATION_MIRROR,
        "operations": ["plan-upgrade", "upgrade", "doctor"],
    }
    if bridge != expected_bridge:
        errors.append("agent install maintenance bridge is unsupported")

    source_identity = contract.get("source_identity")
    expected_source_identity = {
        "source_types": list(SOURCE_TYPES[1:3]) + [SOURCE_TYPES[0]],
    }
    if not isinstance(source_identity, dict):
        errors.append("agent install source identity contract is missing")
    else:
        if source_identity.get("source_types") != [
            "github-release",
            "plugin-bundled",
            "offline-bundle",
            "local-payload",
        ]:
            errors.append("agent install source types are unsupported")
        if source_identity.get("payload_tree_algorithm") != (
            "sha256-path-nul-file-sha256-newline-v1"
        ):
            errors.append("agent install payload-tree algorithm is unsupported")
        for key in (
            "github_release_requires",
            "offline_bundle_requires",
            "plugin_bundled_requires",
            "local_payload_requires",
        ):
            value = source_identity.get(key)
            if not isinstance(value, list) or not value or len(set(value)) != len(value):
                errors.append(f"agent install source requirement is invalid: {key}")

    lifecycle = contract.get("lifecycle")
    expected_lifecycle = {
        "stages": [
            "source-resolved",
            "planned",
            "applied",
            "upgraded",
            "activated",
            "adapted",
            "verified",
            "re-evaluated",
            "ready",
        ],
        "stage_states": ["not-started", "satisfied", "blocked", "not-applicable"],
        "overall_statuses": ["in-progress", "ready", "degraded", "blocked"],
        "new_project_operation": "init",
        "existing_project_operation": "adopt",
        "existing_installation_policy": "request-version-change-decision",
        "ready_owner": "host-agent-adapter",
        "cli_ready_claim": False,
    }
    if lifecycle != expected_lifecycle:
        errors.append("agent install lifecycle contract is unsupported")

    activation = contract.get("activation")
    if not isinstance(activation, dict):
        errors.append("agent install activation contract is missing")
    else:
        expected_activation_static = {
            "activation_set_algorithm": ACTIVATION_SET_ALGORITHM,
            "runtime_discovery_roots": list(RUNTIME_DISCOVERY_ROOTS),
            "paths": [
                "none",
                "same-task-reload",
                "automatic-successor-handoff",
                "manual-new-task",
            ],
            "receipt_kinds": [
                "host-reload",
                "host-successor-start",
                "manual-task-start",
            ],
            "stale_runtime_diagnostic": "stale-runtime-path-preserved",
            "stale_nonruntime_diagnostic": "stale-nonruntime-path-preserved",
            "current_repository_capability": "manual-fallback-only",
        }
        for key, expected in expected_activation_static.items():
            if activation.get(key) != expected:
                errors.append(f"agent install activation field is unsupported: {key}")
        declared_paths = activation.get("activation_paths")
        if not isinstance(declared_paths, list) or declared_paths != sorted(
            set(declared_paths)
        ):
            errors.append("agent install activation paths are invalid")
        if not re.fullmatch(
            r"[0-9a-f]{64}", str(activation.get("activation_set_sha256", ""))
        ):
            errors.append("agent install activation-set digest is invalid")

    takeover = contract.get("takeover")
    registry_enums = TAKEOVER_CONTRACT_REGISTRY["enums"]
    if not isinstance(registry_enums, dict):
        raise AssertionError("compiled takeover enum registry is invalid")
    expected_takeover_lists = {
        "evidence_kinds": registry_enums["evidence_kinds"],
        "adapted_outcomes": registry_enums["adapted_outcomes"],
        "re_evaluated_outcomes": registry_enums["re_evaluated_outcomes"],
        "reason_codes": registry_enums["reason_codes"],
        "next_action_codes": registry_enums["next_action_codes"],
        "goal_kinds": registry_enums["goal_kinds"],
        "goal_custody": registry_enums["goal_custody"],
        "goal_continuation": registry_enums["goal_continuation"],
    }
    if not isinstance(takeover, dict):
        errors.append("agent install takeover contract is missing")
    else:
        if takeover.get("schema_version") != TAKEOVER_SCHEMA_VERSION:
            errors.append("agent install takeover schema is unsupported")
        if takeover.get("storage") != "host-task-state-only":
            errors.append("agent install takeover storage boundary is unsupported")
        if takeover.get("unknown_or_inconsistent_state") != "fail-closed":
            errors.append("agent install takeover evolution is unsupported")
        for key, expected in expected_takeover_lists.items():
            if takeover.get(key) != expected:
                errors.append(f"agent install takeover enum is unsupported: {key}")
        if takeover.get("validator") != {
            "command": "validate-takeover",
            "input": "stdin-json",
            "result_schema_version": AGENT_RESULT_SCHEMA,
            "statuses": list(AGENT_COMMAND_STATUSES["validate-takeover"]),
            "persistence": "none",
            "authority": "structural-consistency-only",
        }:
            errors.append("agent install takeover validator contract is unsupported")
        registry = takeover.get("contract_registry")
        registry_digest = takeover.get("contract_registry_sha256")
        if registry != TAKEOVER_CONTRACT_REGISTRY:
            errors.append("agent install takeover contract registry is unsupported")
        if registry_digest != TAKEOVER_CONTRACT_REGISTRY_SHA256 or (
            isinstance(registry, dict)
            and canonical_json_sha256(registry) != registry_digest
        ):
            errors.append("agent install takeover contract registry digest is invalid")

    cli = contract.get("cli")
    if not isinstance(cli, dict):
        return ["agent install contract CLI result contract is missing"]
    if cli.get("result_schema_version") != AGENT_RESULT_SCHEMA:
        errors.append("agent install contract result schema is unsupported")
    expected_statuses = {
        command: list(statuses)
        for command, statuses in AGENT_COMMAND_STATUSES.items()
    }
    if cli.get("command_statuses") != expected_statuses:
        errors.append("agent install contract command statuses are unsupported")
    if cli.get("write_states") != list(WRITE_STATES):
        errors.append("agent install contract write states are unsupported")
    if cli.get("writes_performed_rule") != "false-only-for-none":
        errors.append("agent install contract writes_performed rule is unsupported")
    doctor_contract = cli.get("doctor")
    expected_warning_registry = {
        code: effect
        for code, (level, effect) in DIAGNOSTIC_REGISTRY.items()
        if level == "warning"
    }
    expected_error_codes = [
        code for code, (level, _) in DIAGNOSTIC_REGISTRY.items() if level == "error"
    ]
    if not isinstance(doctor_contract, dict) or doctor_contract != {
        "diagnostic_shape": [
            "code", "level", "readiness_effect", "path", "detail"
        ],
        "warning_registry": expected_warning_registry,
        "error_codes": expected_error_codes,
        "non_blocking_warning_allowlist": list(DOCTOR_NON_BLOCKING_WARNING_CODES),
    }:
        errors.append("agent install doctor diagnostic contract is unsupported")
    verify_contract = cli.get("verify")
    if not isinstance(verify_contract, dict) or verify_contract != {
        "statuses": list(AGENT_COMMAND_STATUSES["verify"]),
        "default_order": list(VERIFY_ORDER),
        "outcomes": ["passed", "failed", "unconfigured", "skipped"],
        "skipped_reasons": [
            "host-permission-denied",
            "host-capability-unavailable",
            "side-effect-not-authorized",
            "execution-interrupted",
            "process-start-failed",
        ],
        "takeover_required_selection": {
            "mode": "default", "coverage": "all-configured"
        },
        "output_tail_bytes": VERIFY_OUTPUT_LIMIT,
        "network_attestation": "not-provided",
    }:
        errors.append("agent install verify contract is unsupported")

    onboarding = contract.get("onboarding")
    if not isinstance(onboarding, dict):
        errors.append("agent install contract onboarding contract is missing")
    else:
        if onboarding.get("schema_version") != 1:
            errors.append("agent install contract onboarding schema is unsupported")
        if onboarding.get("persisted_statuses") != list(ONBOARDING_STATUSES):
            errors.append(
                "agent install contract persisted onboarding states are unsupported"
            )
        if onboarding.get("derived_statuses") != list(DERIVED_ONBOARDING_STATUSES):
            errors.append(
                "agent install contract derived onboarding states are unsupported"
            )
        if onboarding.get("complete_requirements") != {
            "updated_at": "iso-8601",
            "evidence": "non-empty-string-list",
        }:
            errors.append(
                "agent install contract complete onboarding requirements are unsupported"
            )
        if onboarding.get("preserve_project_owned_state") is not True:
            errors.append(
                "agent install contract onboarding preservation rule is unsupported"
            )
        if onboarding.get("adaptation_requires_activation") is not True or (
            onboarding.get("contradiction_policy")
            != "block-without-uncertain-overwrite"
        ):
            errors.append("agent install adaptation contract is unsupported")

    if contract.get("privacy") != {
        "takeover_repository_persistence": False,
        "goal_text_in_cli_receipts": False,
        "goal_text_in_release_artifacts": False,
        "transfer_scope": "minimal-active-objective-and-durable-evidence-references",
    }:
        errors.append("agent install takeover privacy contract is unsupported")

    evolution = contract.get("evolution")
    expected_evolution = {
        "unknown_schema_or_protocol": "fail-closed",
        "unknown_enum": "fail-closed",
        "schema_1_optional_field_rule": "ignorable-without-changing-existing-meaning",
        "breaking_change_rule": "bump-result-schema-and-or-agent-install-protocol",
    }
    if evolution != expected_evolution:
        errors.append("agent install contract evolution rules are unsupported")
    return errors


def validate_agent_install_guide_bytes(content: bytes) -> bool:
    try:
        text = content.decode("utf-8")
    except UnicodeError:
        return False
    return (
        text.startswith("# Agent installation and takeover contract\n")
        and "https://github.com/mintgao/vibe-kit" in text
        and "`agent-install.json`" in text
        and "validate-takeover" in text
    )


def authentication_error(code: str, path: str) -> Dict[str, str]:
    return {"code": code, "path": path}


def installed_takeover_contract_context(
    root: Path,
) -> Tuple[Optional[Dict[str, object]], List[Dict[str, str]]]:
    """Authenticate the installed takeover contract before candidate validation."""
    root = root.resolve()
    errors: List[Dict[str, str]] = []

    def add(code: str, path: str) -> None:
        item = authentication_error(code, path)
        if item not in errors:
            errors.append(item)

    manifest, manifest_version, manifest_display = read_manifest_for_doctor(root)
    versions_ok, _ = version_integrity(root, manifest_version, manifest_display)
    if not versions_ok or manifest is None:
        add("installed-version-integrity-failed", MANIFEST_PATH.as_posix())

    guide_path = root / "AGENT_INSTALL.md"
    contract_path = root / "agent-install.json"
    if not guide_path.is_file():
        add("installed-agent-contract-missing", "AGENT_INSTALL.md")
    else:
        try:
            guide_valid = validate_agent_install_guide_bytes(guide_path.read_bytes())
        except OSError:
            guide_valid = False
        if not guide_valid:
            add("installed-agent-contract-schema-mismatch", "AGENT_INSTALL.md")
    if not contract_path.is_file():
        add("installed-agent-contract-missing", "agent-install.json")
        return None, errors

    try:
        contract = load_agent_install_contract(root)
    except VibeError:
        add("installed-agent-contract-schema-mismatch", "agent-install.json")
        return None, errors

    managed_files = manifest.get("managed_files") if isinstance(manifest, dict) else None
    try:
        contract_hash = sha256(contract_path)
    except OSError:
        contract_hash = None
    try:
        guide_hash = sha256(guide_path) if guide_path.is_file() else None
    except OSError:
        guide_hash = None
    if not isinstance(managed_files, dict) or managed_files.get(
        "agent-install.json"
    ) != contract_hash:
        add("installed-agent-contract-hash-mismatch", "agent-install.json")
    if not isinstance(managed_files, dict) or managed_files.get(
        "AGENT_INSTALL.md"
    ) != guide_hash:
        add("installed-agent-contract-hash-mismatch", "AGENT_INSTALL.md")

    if (
        contract.get("schema_version") != AGENT_INSTALL_SCHEMA
        or contract.get("protocol_version") != AGENT_INSTALL_PROTOCOL
        or contract.get("kit_version") != manifest_version
        or validate_agent_install_contract_shape(contract)
    ):
        add("installed-agent-contract-schema-mismatch", "agent-install.json")

    try:
        protocol = release_protocol(root)
    except VibeError:
        protocol = {}
    adapter = contract.get("adapter")
    codex = protocol.get("adapters", {}).get("codex", {}) if isinstance(
        protocol.get("adapters"), dict
    ) else {}
    if (
        protocol.get("core_protocol") != CORE_PROTOCOL
        or protocol.get("agent_install_protocol") != AGENT_INSTALL_PROTOCOL
        or protocol.get("takeover_contract_registry_sha256")
        != TAKEOVER_CONTRACT_REGISTRY_SHA256
        or not valid_predecessor_migration_mirror(
            protocol.get("predecessor_migrations")
        )
        or not isinstance(adapter, dict)
        or adapter.get("name") != "codex"
        or adapter.get("protocol") != CODEX_ADAPTER_PROTOCOL
        or not isinstance(codex, dict)
        or codex.get("version") != CODEX_ADAPTER_PROTOCOL
        or codex.get("core_protocol") != CORE_PROTOCOL
    ):
        add("installed-core-contract-mismatch", ".vibe/core/protocol.json")

    takeover = contract.get("takeover")
    registry = takeover.get("contract_registry") if isinstance(takeover, dict) else None
    registry_digest = (
        takeover.get("contract_registry_sha256") if isinstance(takeover, dict) else None
    )
    if (
        registry != TAKEOVER_CONTRACT_REGISTRY
        or registry_digest != TAKEOVER_CONTRACT_REGISTRY_SHA256
        or not isinstance(registry, dict)
        or canonical_json_sha256(registry) != TAKEOVER_CONTRACT_REGISTRY_SHA256
    ):
        add("compiled-contract-registry-mismatch", "agent-install.json#/takeover/contract_registry")

    activation_contract = contract.get("activation")
    manifest_activation = manifest.get("activation") if isinstance(manifest, dict) else None
    manifest_fingerprint = (
        manifest.get("target_fingerprint") if isinstance(manifest, dict) else None
    )
    actual_digest: Optional[str] = None
    expected_digest: Optional[str] = None
    try:
        paths = activation_paths(root)
        hashes = activation_path_hashes(root, paths)
        fingerprint = activation_fingerprint_base(root)
        actual_digest = activation_set_digest(fingerprint, hashes)
        expected_digest = (
            activation_contract.get("activation_set_sha256")
            if isinstance(activation_contract, dict)
            else None
        )
        activation_valid = (
            isinstance(activation_contract, dict)
            and activation_contract.get("activation_set_algorithm")
            == ACTIVATION_SET_ALGORITHM
            and activation_contract.get("activation_paths") == paths
            and isinstance(manifest_activation, dict)
            and manifest_activation.get("algorithm") == ACTIVATION_SET_ALGORITHM
            and manifest_activation.get("paths") == paths
            and manifest_activation.get("path_hashes") == hashes
            and manifest_activation.get("activation_set_sha256") == actual_digest
            and isinstance(manifest_fingerprint, dict)
            and manifest_fingerprint.get("activation_set_sha256") == actual_digest
            and expected_digest == actual_digest
        )
    except (OSError, UnicodeError, VibeError):
        activation_valid = False
    if not activation_valid:
        add("installed-activation-identity-mismatch", "agent-install.json#/activation")

    if errors:
        return None, errors
    raw_manifest_sha256 = sha256(root / MANIFEST_PATH)
    context = {
        "project_root": str(root),
        "manifest_sha256": raw_manifest_sha256,
        "activation_set_sha256": actual_digest,
        "target_fingerprint": {
            "kit_version": manifest_version,
            "core_protocol": CORE_PROTOCOL,
            "agent_install_schema": AGENT_INSTALL_SCHEMA,
            "agent_install_protocol": AGENT_INSTALL_PROTOCOL,
            "adapter_name": "codex",
            "adapter_protocol": CODEX_ADAPTER_PROTOCOL,
            "manifest_sha256": raw_manifest_sha256,
            "activation_set_sha256": actual_digest,
        },
    }
    return context, []


def takeover_validation_error(code: str, path: str) -> Dict[str, str]:
    return {"code": code, "path": path}


def validate_takeover_object(
    candidate: object, context: Dict[str, object]
) -> List[Dict[str, str]]:
    """Validate schema-1 takeover structure; never authenticate host evidence truth."""
    errors: List[Dict[str, str]] = []

    def add(code: str, path: str) -> None:
        item = takeover_validation_error(code, path)
        if item not in errors:
            errors.append(item)

    def closed(value: object, fields: Sequence[str], path: str) -> bool:
        if not isinstance(value, dict):
            add("exact-result-shape", path)
            return False
        if set(value) != set(fields):
            add("exact-result-shape", path)
            return False
        return True

    def opaque(value: object, maximum: int = 256) -> bool:
        return (
            isinstance(value, str)
            and 1 <= len(value) <= maximum
            and all(ord(character) >= 32 and character != "\x7f" for character in value)
        )

    def nullable_opaque(value: object, maximum: int = 256) -> bool:
        return value is None or opaque(value, maximum)

    def digest(value: object) -> bool:
        return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None

    def nullable_digest(value: object) -> bool:
        return value is None or digest(value)

    registry = TAKEOVER_CONTRACT_REGISTRY
    shape = registry["result_shape"]
    enums = registry["enums"]
    limits = registry["array_limits"]
    if not isinstance(shape, dict) or not isinstance(enums, dict) or not isinstance(limits, dict):
        return [takeover_validation_error("compiled-contract-registry-mismatch", "$")]
    top_fields = shape["required_top_level"]
    if not closed(candidate, top_fields, "$"):
        return errors
    result = candidate
    if not isinstance(result, dict):
        return errors

    if result.get("takeover_schema_version") != TAKEOVER_SCHEMA_VERSION:
        add("exact-result-shape", "$.takeover_schema_version")
    if not opaque(result.get("takeover_id")):
        add("exact-result-shape", "$.takeover_id")
    if result.get("evidence_origin") not in enums["evidence_origins"]:
        add("exact-result-shape", "$.evidence_origin")
    if not nullable_opaque(result.get("completion_owner_task_id")):
        add("exact-result-shape", "$.completion_owner_task_id")
    project_root = result.get("project_root")
    if not opaque(project_root, 4096) or not isinstance(project_root, str) or (
        not Path(project_root).is_absolute()
        or str(Path(project_root).resolve()) != project_root
    ):
        add("exact-result-shape", "$.project_root")
    elif project_root != context.get("project_root"):
        add("activation-identities-match-target", "$.project_root")
    if result.get("overall_status") not in enums["overall_statuses"]:
        add("exact-result-shape", "$.overall_status")
    if result.get("write_state") not in enums["write_states"]:
        add("exact-result-shape", "$.write_state")
    if result.get("last_completed_stage") is not None and result.get(
        "last_completed_stage"
    ) not in TAKEOVER_STAGE_ORDER:
        add("last-completed-is-last-satisfied-stage", "$.last_completed_stage")

    source = result.get("source")
    if closed(source, shape["required_source_fields"], "$.source"):
        source_type = source.get("type")
        if source_type not in enums["source_types"]:
            add("exact-result-shape", "$.source.type")
        if not opaque(source.get("ref"), 4096):
            add("exact-result-shape", "$.source.ref")
        if not nullable_digest(source.get("artifact_sha256")):
            add("exact-result-shape", "$.source.artifact_sha256")
        if not digest(source.get("payload_tree_sha256")):
            add("exact-result-shape", "$.source.payload_tree_sha256")
        source_rules = registry["source_rules"]
        rule = source_rules.get(source_type) if isinstance(source_rules, dict) else None
        if isinstance(rule, dict):
            artifact_rule = rule.get("artifact_sha256")
            artifact = source.get("artifact_sha256")
            if artifact_rule == "required" and not digest(artifact):
                add("exact-result-shape", "$.source.artifact_sha256")
            if artifact_rule == "must-be-null" and artifact is not None:
                add("exact-result-shape", "$.source.artifact_sha256")

    versions = result.get("versions")
    fingerprint = result.get("target_fingerprint")
    if closed(versions, shape["required_versions_fields"], "$.versions"):
        if not strict_semver(versions.get("from")):
            add("exact-result-shape", "$.versions.from")
        if not strict_semver(versions.get("target")):
            add("exact-result-shape", "$.versions.target")
    if closed(fingerprint, shape["required_fingerprint_fields"], "$.target_fingerprint"):
        expected_static = {
            "core_protocol": CORE_PROTOCOL,
            "agent_install_schema": AGENT_INSTALL_SCHEMA,
            "agent_install_protocol": AGENT_INSTALL_PROTOCOL,
            "adapter_name": "codex",
            "adapter_protocol": CODEX_ADAPTER_PROTOCOL,
        }
        if not strict_semver(fingerprint.get("kit_version")):
            add("exact-result-shape", "$.target_fingerprint.kit_version")
        for key, expected in expected_static.items():
            if fingerprint.get(key) != expected:
                add("activation-identities-match-target", f"$.target_fingerprint.{key}")
        if not nullable_digest(fingerprint.get("manifest_sha256")):
            add("exact-result-shape", "$.target_fingerprint.manifest_sha256")
        if not nullable_digest(fingerprint.get("activation_set_sha256")):
            add("exact-result-shape", "$.target_fingerprint.activation_set_sha256")
        if isinstance(versions, dict) and versions.get("target") != fingerprint.get("kit_version"):
            add("activation-identities-match-target", "$.versions.target")

    activation = result.get("activation")
    if closed(activation, shape["required_activation_fields"], "$.activation"):
        if activation.get("path") not in enums["activation_paths"]:
            add("activation-receipt-bound", "$.activation.path")
        if activation.get("receipt_kind") is not None and activation.get(
            "receipt_kind"
        ) not in enums["receipt_kinds"]:
            add("activation-receipt-bound", "$.activation.receipt_kind")
        for key in ("receipt_id", "active_task_id", "handoff_idempotency_key"):
            if not nullable_opaque(activation.get(key)):
                add("exact-result-shape", f"$.activation.{key}")
        if not opaque(activation.get("source_task_id")):
            add("exact-result-shape", "$.activation.source_task_id")
        for key in ("observed_manifest_sha256", "observed_activation_set_sha256"):
            if not nullable_digest(activation.get(key)):
                add("exact-result-shape", f"$.activation.{key}")

    stages = result.get("stages")
    stage_values: Dict[str, Dict[str, object]] = {}
    all_sequences: List[int] = []
    evidence_by_stage: Dict[str, List[Dict[str, object]]] = {}
    if closed(stages, shape["required_stage_keys"], "$.stages"):
        for stage_name in TAKEOVER_STAGE_ORDER:
            stage = stages.get(stage_name)
            stage_path = f"$.stages.{stage_name}"
            if not closed(stage, shape["required_stage_fields"], stage_path):
                continue
            if not isinstance(stage, dict):
                continue
            stage_values[stage_name] = stage
            state = stage.get("state")
            if state not in enums["stage_states"]:
                add("stage-outcomes-consistent", f"{stage_path}.state")
            evidence = stage.get("evidence")
            if not isinstance(evidence, list) or len(evidence) > int(limits["evidence_per_stage"]):
                add("exact-result-shape", f"{stage_path}.evidence")
                evidence = []
            valid_evidence: List[Dict[str, object]] = []
            for index, item in enumerate(evidence):
                item_path = f"{stage_path}.evidence[{index}]"
                if not closed(item, shape["required_evidence_fields"], item_path):
                    continue
                if not isinstance(item, dict):
                    continue
                if item.get("kind") not in enums["evidence_kinds"]:
                    add("exact-result-shape", f"{item_path}.kind")
                placement = registry["evidence_placement"].get(item.get("kind"), [])
                if stage_name not in placement:
                    add("stage-dependencies-satisfied", f"{item_path}.kind")
                if not opaque(item.get("ref"), 4096):
                    add("exact-result-shape", f"{item_path}.ref")
                if not nullable_digest(item.get("sha256")):
                    add("exact-result-shape", f"{item_path}.sha256")
                if not nullable_opaque(item.get("task_id")):
                    add("exact-result-shape", f"{item_path}.task_id")
                sequence = item.get("sequence")
                if isinstance(sequence, bool) or not isinstance(sequence, int) or sequence < 0:
                    add("exact-result-shape", f"{item_path}.sequence")
                else:
                    all_sequences.append(sequence)
                item_kind = item.get("kind")
                source_task_for_evidence = (
                    activation.get("source_task_id")
                    if isinstance(activation, dict)
                    else None
                )
                active_task_for_evidence = (
                    activation.get("active_task_id")
                    if isinstance(activation, dict)
                    else None
                )
                expected_task = (
                    source_task_for_evidence
                    if stage_name in (
                        "source-resolved", "planned", "applied", "upgraded"
                    )
                    else active_task_for_evidence
                )
                if item.get("task_id") != expected_task:
                    add("activation-receipt-bound", f"{item_path}.task_id")
                if item_kind == "source-attestation" and isinstance(source, dict) and (
                    item.get("sha256") != source.get("payload_tree_sha256")
                ):
                    add("activation-identities-match-target", f"{item_path}.sha256")
                if item_kind in ("activation-receipt", "manual-task-start") and isinstance(
                    activation, dict
                ):
                    if item.get("ref") != activation.get("receipt_id"):
                        add("activation-receipt-bound", f"{item_path}.ref")
                    if item.get("sha256") != activation.get(
                        "observed_activation_set_sha256"
                    ):
                        add("activation-identities-match-target", f"{item_path}.sha256")
                valid_evidence.append(item)
            evidence_by_stage[stage_name] = valid_evidence

    goal = result.get("goal")
    custody_history: List[Dict[str, object]] = []
    if closed(goal, shape["required_goal_fields"], "$.goal"):
        if goal.get("kind") not in enums["goal_kinds"]:
            add("exact-result-shape", "$.goal.kind")
        if goal.get("custody") not in enums["goal_custody"]:
            add("custody-history-valid", "$.goal.custody")
        if goal.get("continuation") not in enums["goal_continuation"]:
            add("custody-history-valid", "$.goal.continuation")
        for key in ("transfer_id", "owner_task_id"):
            if not nullable_opaque(goal.get(key)):
                add("exact-result-shape", f"$.goal.{key}")
        history = goal.get("custody_history")
        if not isinstance(history, list) or len(history) > int(limits["custody_history"]):
            add("custody-history-valid", "$.goal.custody_history")
            history = []
        for index, item in enumerate(history):
            item_path = f"$.goal.custody_history[{index}]"
            if not closed(item, shape["required_custody_history_fields"], item_path):
                continue
            if not isinstance(item, dict):
                continue
            if item.get("state") not in enums["goal_custody"]:
                add("custody-history-valid", f"{item_path}.state")
            if not nullable_opaque(item.get("task_id")):
                add("custody-history-valid", f"{item_path}.task_id")
            sequence = item.get("sequence")
            if isinstance(sequence, bool) or not isinstance(sequence, int) or sequence < 0:
                add("custody-history-valid", f"{item_path}.sequence")
            else:
                all_sequences.append(sequence)
            custody_history.append(item)

    next_action = result.get("next_action")
    if next_action is not None and closed(
        next_action, shape["required_next_action_fields"], "$.next_action"
    ):
        if next_action.get("code") not in enums["next_action_codes"]:
            add("reason-action-consistent", "$.next_action.code")
        detail = next_action.get("detail")
        if not opaque(detail, 512) or (isinstance(detail, str) and ("\r" in detail or "\n" in detail)):
            add("exact-result-shape", "$.next_action.detail")

    # Stage state, outcome, predecessor and evidence placement rules.
    blocked_stages: List[str] = []
    satisfied_stages: List[str] = []
    for stage_name in TAKEOVER_STAGE_ORDER:
        stage = stage_values.get(stage_name)
        if stage is None:
            continue
        state = stage.get("state")
        outcome = stage.get("outcome")
        reason = stage.get("reason_code")
        if state == "satisfied":
            satisfied_stages.append(stage_name)
        if state == "blocked":
            blocked_stages.append(stage_name)
        if stage_name == "adapted":
            allowed = registry["stage_outcome_rules"]["adapted"].get(state, [])
            if outcome not in allowed and not (state == "not-started" and outcome is None):
                add("stage-outcomes-consistent", f"$.stages.{stage_name}.outcome")
        elif stage_name == "re-evaluated":
            allowed = registry["stage_outcome_rules"]["re-evaluated"].get(state, [])
            if outcome not in allowed and not (state == "not-started" and outcome is None):
                add("stage-outcomes-consistent", f"$.stages.{stage_name}.outcome")
        elif outcome is not None:
            add("stage-outcomes-consistent", f"$.stages.{stage_name}.outcome")
        if state == "blocked":
            if reason not in TAKEOVER_REASON_ACTION or TAKEOVER_REASON_STAGE.get(reason) != stage_name:
                add("reason-action-consistent", f"$.stages.{stage_name}.reason_code")
        elif reason is not None:
            add("reason-action-consistent", f"$.stages.{stage_name}.reason_code")
        if state == "not-applicable" and not (
            stage_name == "re-evaluated"
            and isinstance(goal, dict)
            and goal.get("kind") == "maintenance-only"
            and outcome == "maintenance-only"
        ):
            add("only-maintenance-re-evaluation-not-applicable", f"$.stages.{stage_name}")
        if state == "satisfied":
            dependencies = registry["stage_dependencies"].get(stage_name, [])
            if any(stage_values.get(name, {}).get("state") != "satisfied" for name in dependencies):
                add("stage-dependencies-satisfied", f"$.stages.{stage_name}")
            required_evidence = registry["evidence_rules"].get(stage_name, [])
            actual_kinds = {item.get("kind") for item in evidence_by_stage.get(stage_name, [])}
            if any(kind not in actual_kinds for kind in required_evidence):
                add("stage-dependencies-satisfied", f"$.stages.{stage_name}.evidence")
        elif state == "not-started" and evidence_by_stage.get(stage_name):
            add("stage-dependencies-satisfied", f"$.stages.{stage_name}.evidence")
        elif state == "not-applicable" and stage_name == "re-evaluated":
            actual_kinds = {
                item.get("kind") for item in evidence_by_stage.get(stage_name, [])
            }
            if "routing-record" not in actual_kinds:
                add("only-maintenance-re-evaluation-not-applicable", f"$.stages.{stage_name}.evidence")

    if len(blocked_stages) > 1:
        add("stage-dependencies-satisfied", "$.stages")
    if blocked_stages:
        blocked_index = TAKEOVER_STAGE_ORDER.index(blocked_stages[0])
        for later in TAKEOVER_STAGE_ORDER[blocked_index + 1:]:
            if stage_values.get(later, {}).get("state") != "not-started":
                add("stage-dependencies-satisfied", f"$.stages.{later}")
    computed_last = satisfied_stages[-1] if satisfied_stages else None
    if result.get("last_completed_stage") != computed_last:
        add("last-completed-is-last-satisfied-stage", "$.last_completed_stage")

    if len(all_sequences) != len(set(all_sequences)):
        add("custody-sequences-globally-unique", "$.stages")
    custody_sequences = [
        item.get("sequence") for item in custody_history if isinstance(item.get("sequence"), int)
    ]
    if custody_sequences != sorted(custody_sequences) or len(custody_sequences) != len(
        set(custody_sequences)
    ):
        add("custody-history-strictly-increasing", "$.goal.custody_history")

    source_task = activation.get("source_task_id") if isinstance(activation, dict) else None
    active_task = activation.get("active_task_id") if isinstance(activation, dict) else None
    if isinstance(goal, dict):
        kind = goal.get("kind")
        custody = goal.get("custody")
        if kind == "maintenance-only":
            if custody_history or custody != "none" or goal.get("transfer_id") is not None or (
                goal.get("owner_task_id") is not None
                or goal.get("continuation") != "not-applicable"
            ):
                add("custody-history-valid", "$.goal")
        elif kind == "unfinished":
            if not custody_history or custody_history[0].get("state") != "source-owned" or (
                custody_history[0].get("task_id") != source_task
            ):
                add("custody-first-state-valid", "$.goal.custody_history")
            for previous, current in zip(custody_history, custody_history[1:]):
                allowed = TAKEOVER_CUSTODY_TRANSITIONS.get(previous.get("state"), [])
                if current.get("state") not in allowed:
                    add("custody-transitions-direct", "$.goal.custody_history")
            for index, item in enumerate(custody_history):
                state = item.get("state")
                task_id = item.get("task_id")
                expected_history_task = {
                    "source-owned": source_task,
                    "automatic-transfer-pending": source_task,
                    "automatic-successor-owned": active_task,
                    "manual-transfer-required": None,
                    "manual-transfer-pending": active_task,
                    "manual-successor-owned": active_task,
                }.get(state)
                if task_id != expected_history_task:
                    add(
                        "custody-owner-derived",
                        f"$.goal.custody_history[{index}].task_id",
                    )
            if custody_history and custody_history[-1].get("state") != custody:
                add("custody-final-equals-current", "$.goal.custody")
            final_task = custody_history[-1].get("task_id") if custody_history else None
            derived_owner = final_task if custody in (
                "source-owned", "automatic-transfer-pending",
                "automatic-successor-owned", "manual-successor-owned",
            ) else None
            if goal.get("owner_task_id") != derived_owner:
                add("custody-owner-derived", "$.goal.owner_task_id")
            if custody in ("source-owned", "automatic-transfer-pending") and final_task != source_task:
                add("custody-owner-derived", "$.goal.custody_history")
            if custody in ("automatic-successor-owned", "manual-successor-owned") and final_task != active_task:
                add("custody-owner-derived", "$.goal.custody_history")
            if custody == "manual-transfer-required" and final_task is not None:
                add("custody-owner-derived", "$.goal.custody_history")
            if custody == "automatic-transfer-pending" and isinstance(activation, dict) and not opaque(
                activation.get("handoff_idempotency_key")
            ):
                add("custody-owner-derived", "$.activation.handoff_idempotency_key")
            if custody in (
                "automatic-transfer-pending", "automatic-successor-owned",
                "manual-transfer-required", "manual-transfer-pending",
                "manual-successor-owned",
            ) and not opaque(goal.get("transfer_id")):
                add("custody-history-valid", "$.goal.transfer_id")
            if custody == "source-owned" and goal.get("transfer_id") is not None:
                add("custody-history-valid", "$.goal.transfer_id")

    # Activation bindings, event ordering and content identities.
    if isinstance(activation, dict):
        path = activation.get("path")
        receipt_kind = activation.get("receipt_kind")
        if path == "none":
            for key in (
                "receipt_kind", "receipt_id", "active_task_id",
                "handoff_idempotency_key", "observed_manifest_sha256",
                "observed_activation_set_sha256",
            ):
                if activation.get(key) is not None:
                    add("activation-receipt-bound", f"$.activation.{key}")
        else:
            bindings = registry["activation_receipt_bindings"]
            binding = bindings.get(receipt_kind) if isinstance(bindings, dict) else None
            if not isinstance(binding, dict) or binding.get("path") != path:
                add("activation-receipt-bound", "$.activation")
            else:
                relation = binding.get("active_task_relation")
                if relation == "equals-source-task" and active_task != source_task:
                    add("activation-receipt-bound", "$.activation.active_task_id")
                if relation == "differs-from-source-task" and (
                    active_task is None or active_task == source_task
                ):
                    add("activation-receipt-bound", "$.activation.active_task_id")
                key_rule = binding.get("handoff_idempotency_key")
                if key_rule == "required" and not opaque(activation.get("handoff_idempotency_key")):
                    add("activation-receipt-bound", "$.activation.handoff_idempotency_key")
                if key_rule == "must-be-null" and activation.get("handoff_idempotency_key") is not None:
                    add("activation-receipt-bound", "$.activation.handoff_idempotency_key")
                activated_kinds = {
                    item.get("kind") for item in evidence_by_stage.get("activated", [])
                }
                if any(kind not in activated_kinds for kind in binding.get("required_evidence", [])):
                    add("activation-receipt-bound", "$.stages.activated.evidence")
            if not opaque(activation.get("receipt_id")):
                add("activation-receipt-bound", "$.activation.receipt_id")
        if stage_values.get("activated", {}).get("state") == "satisfied":
            expected_fp = context.get("target_fingerprint")
            if fingerprint != expected_fp:
                add("activation-identities-match-target", "$.target_fingerprint")
            if activation.get("observed_manifest_sha256") != context.get("manifest_sha256"):
                add("activation-identities-match-target", "$.activation.observed_manifest_sha256")
            if activation.get("observed_activation_set_sha256") != context.get(
                "activation_set_sha256"
            ):
                add("activation-identities-match-target", "$.activation.observed_activation_set_sha256")
            apply_sequences = [
                item.get("sequence") for item in evidence_by_stage.get("applied", [])
                if item.get("kind") == "apply-receipt" and isinstance(item.get("sequence"), int)
            ]
            activation_sequences = [
                item.get("sequence") for item in evidence_by_stage.get("activated", [])
                if item.get("kind") in ("activation-receipt", "manual-task-start")
                and isinstance(item.get("sequence"), int)
            ]
            if not apply_sequences or not activation_sequences or min(activation_sequences) <= max(apply_sequences):
                add("activation-after-apply", "$.stages.activated.evidence")
            if isinstance(goal, dict) and goal.get("kind") == "unfinished":
                history_sequence = {
                    item.get("state"): item.get("sequence") for item in custody_history
                }
                handoff_sequences = [
                    item.get("sequence")
                    for item in evidence_by_stage.get("activated", [])
                    if item.get("kind") == "handoff-claim"
                    and isinstance(item.get("sequence"), int)
                ]
                if path == "same-task-reload" and (
                    len(custody_history) != 1 or goal.get("custody") != "source-owned"
                ):
                    add("custody-history-valid", "$.goal.custody_history")
                if path == "automatic-successor-handoff":
                    owner_sequence = history_sequence.get("automatic-successor-owned")
                    if (
                        not handoff_sequences
                        or not activation_sequences
                        or min(handoff_sequences) <= min(activation_sequences)
                        or not isinstance(owner_sequence, int)
                        or owner_sequence <= max(handoff_sequences)
                    ):
                        add("successor-custody-terminal", "$.goal.custody_history")
                if path == "manual-new-task":
                    pending_sequence = history_sequence.get("manual-transfer-pending")
                    owner_sequence = history_sequence.get("manual-successor-owned")
                    if (
                        not isinstance(pending_sequence, int)
                        or not activation_sequences
                        or min(activation_sequences) <= pending_sequence
                        or not isinstance(owner_sequence, int)
                        or owner_sequence <= max(activation_sequences)
                    ):
                        add("successor-custody-terminal", "$.goal.custody_history")

    if stage_values.get("applied", {}).get("state") == "satisfied" and result.get(
        "write_state"
    ) != "project-files-written":
        add("write-state-project-files-written", "$.write_state")

    reason = None
    if blocked_stages:
        reason = stage_values[blocked_stages[0]].get("reason_code")
    overall = result.get("overall_status")
    if overall in ("blocked", "degraded"):
        if not blocked_stages or not isinstance(next_action, dict) or (
            TAKEOVER_REASON_ACTION.get(reason) != next_action.get("code")
        ):
            add("reason-action-consistent", "$.next_action")
    elif next_action is not None:
        add("reason-action-consistent", "$.next_action")
    if overall == "degraded" and not (
        result.get("write_state") == "project-files-written"
        and stage_values.get("upgraded", {}).get("state") == "satisfied"
        and stage_values.get("activated", {}).get("state") == "blocked"
        and reason == "manual-new-task-required"
        and isinstance(next_action, dict)
        and next_action.get("code") == "create-new-project-task"
    ):
        add("reason-action-consistent", "$.overall_status")

    ready_satisfied = stage_values.get("ready", {}).get("state") == "satisfied"
    if (overall == "ready") != ready_satisfied:
        add("overall-ready-iff-ready-stage-satisfied", "$.overall_status")
    if ready_satisfied:
        if blocked_stages or result.get("write_state") != "project-files-written":
            add("no-blocking-diagnostic", "$.stages.ready")
        if result.get("completion_owner_task_id") != active_task or active_task is None:
            add("completion-owner-is-active-task", "$.completion_owner_task_id")
        if next_action is not None or stage_values["ready"].get("reason_code") is not None:
            add("ready-has-no-reason-or-next-action", "$.stages.ready")
        if isinstance(goal, dict) and goal.get("kind") == "maintenance-only":
            if stage_values.get("re-evaluated", {}).get("state") != "not-applicable":
                add("only-maintenance-re-evaluation-not-applicable", "$.stages.re-evaluated")
        elif isinstance(goal, dict):
            if stage_values.get("re-evaluated", {}).get("state") != "satisfied" or (
                goal.get("continuation") not in ("ready-to-resume", "resumed")
            ):
                add("unfinished-goal-owner-is-completion-owner", "$.goal")
            if goal.get("owner_task_id") != result.get("completion_owner_task_id"):
                add("unfinished-goal-owner-is-completion-owner", "$.goal.owner_task_id")
            bindings = registry["activation_receipt_bindings"]
            binding = bindings.get(activation.get("receipt_kind")) if isinstance(
                activation, dict
            ) and isinstance(bindings, dict) else None
            if not isinstance(binding, dict) or goal.get("custody") != binding.get(
                "required_custody_at_ready"
            ):
                add("single-active-custodian", "$.goal.custody")
            if activation.get("path") in ("automatic-successor-handoff", "manual-new-task") and (
                result.get("completion_owner_task_id") == source_task
            ):
                add("successor-custody-terminal", "$.completion_owner_task_id")
    elif result.get("completion_owner_task_id") is not None:
        add("completion-owner-is-active-task", "$.completion_owner_task_id")
    return errors


def validate_takeover(root: Path, output_format: str) -> int:
    try:
        context, authentication_errors = installed_takeover_contract_context(root)
    except (OSError, UnicodeError, VibeError):
        context = None
        authentication_errors = [
            authentication_error(
                "installed-version-integrity-failed", MANIFEST_PATH.as_posix()
            )
        ]
    if authentication_errors or context is None:
        result = result_envelope(
            "validate-takeover",
            "error",
            structural_only=True,
            host_evidence_authenticated=False,
            ready_claim=False,
            errors=authentication_errors,
        )
        if output_format == "json":
            print_json(result)
        else:
            print("Takeover validation could not authenticate the installed contract.", file=sys.stderr)
        return 2
    try:
        raw = sys.stdin.read()
        candidate = json.loads(raw, object_pairs_hook=reject_duplicate_json_keys)
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError):
        candidate = None
        validation_errors = [takeover_validation_error("exact-result-shape", "$")]
    else:
        validation_errors = validate_takeover_object(candidate, context)
    status = "invalid" if validation_errors else "valid"
    result = result_envelope(
        "validate-takeover",
        status,
        structural_only=True,
        host_evidence_authenticated=False,
        ready_claim=False,
        errors=validation_errors,
    )
    if output_format == "json":
        print_json(result)
    elif validation_errors:
        for item in validation_errors:
            print(f"INVALID: {item['code']} at {item['path']}", file=sys.stderr)
    else:
        print("Takeover structure is valid; host evidence is not authenticated.")
    return 1 if validation_errors else 0


def canonical_takeover_fixture(context: Dict[str, object]) -> Dict[str, object]:
    """Build the bounded maintenance-only canonical case used by release validation."""
    fingerprint = copy.deepcopy(context["target_fingerprint"])
    source_task = "controlled-source-task"
    active_task = "controlled-manual-successor"

    def evidence(
        kind: str, ref: str, sequence: int, task_id: Optional[str], digest_value: Optional[str] = None
    ) -> Dict[str, object]:
        return {
            "kind": kind,
            "ref": ref,
            "sha256": digest_value,
            "task_id": task_id,
            "sequence": sequence,
        }

    return {
        "takeover_schema_version": TAKEOVER_SCHEMA_VERSION,
        "takeover_id": "controlled-takeover",
        "evidence_origin": "controlled-fixture",
        "completion_owner_task_id": active_task,
        "project_root": context["project_root"],
        "source": {
            "type": "local-payload",
            "ref": "controlled-local-payload",
            "artifact_sha256": None,
            "payload_tree_sha256": "2" * 64,
        },
        "versions": {"from": "0.5.0", "target": fingerprint["kit_version"]},
        "target_fingerprint": fingerprint,
        "overall_status": "ready",
        "last_completed_stage": "ready",
        "write_state": "project-files-written",
        "activation": {
            "path": "manual-new-task",
            "receipt_kind": "manual-task-start",
            "receipt_id": "manual-receipt",
            "source_task_id": source_task,
            "active_task_id": active_task,
            "handoff_idempotency_key": None,
            "observed_manifest_sha256": context["manifest_sha256"],
            "observed_activation_set_sha256": context["activation_set_sha256"],
        },
        "goal": {
            "kind": "maintenance-only",
            "custody": "none",
            "continuation": "not-applicable",
            "transfer_id": None,
            "owner_task_id": None,
            "custody_history": [],
        },
        "stages": {
            "source-resolved": {
                "state": "satisfied", "outcome": None, "reason_code": None,
                "evidence": [evidence("source-attestation", "source-receipt", 0, source_task, "2" * 64)],
            },
            "planned": {
                "state": "satisfied", "outcome": None, "reason_code": None,
                "evidence": [evidence("plan-receipt", "plan-receipt", 1, source_task)],
            },
            "applied": {
                "state": "satisfied", "outcome": None, "reason_code": None,
                "evidence": [evidence("apply-receipt", "apply-receipt", 2, source_task)],
            },
            "upgraded": {
                "state": "satisfied", "outcome": None, "reason_code": None,
                "evidence": [evidence("doctor-receipt", "upgrade-doctor", 3, source_task)],
            },
            "activated": {
                "state": "satisfied", "outcome": None, "reason_code": None,
                "evidence": [evidence("manual-task-start", "manual-receipt", 4, active_task, context["activation_set_sha256"])],
            },
            "adapted": {
                "state": "satisfied", "outcome": "unchanged-complete", "reason_code": None,
                "evidence": [
                    evidence("onboarding-state", ".vibe/onboarding.json", 5, active_task),
                    evidence("adaptation-review", "adaptation-review", 6, active_task),
                ],
            },
            "verified": {
                "state": "satisfied", "outcome": None, "reason_code": None,
                "evidence": [
                    evidence("doctor-receipt", "final-doctor", 7, active_task),
                    evidence("verify-receipt", "default-verify", 8, active_task),
                ],
            },
            "re-evaluated": {
                "state": "not-applicable", "outcome": "maintenance-only", "reason_code": None,
                "evidence": [evidence("routing-record", "maintenance-only", 9, active_task)],
            },
            "ready": {"state": "satisfied", "outcome": None, "reason_code": None, "evidence": []},
        },
        "next_action": None,
    }


def canonical_takeover_invalid_cases():
    """Return bounded canonical mutations for release-time production validation."""
    def dependency(value: Dict[str, object]) -> None:
        value["stages"]["planned"]["state"] = "not-started"
        value["stages"]["planned"]["evidence"] = []

    def action(value: Dict[str, object]) -> None:
        value["next_action"] = {"code": "fix-configured-check", "detail": "Invalid ready action."}

    def activation(value: Dict[str, object]) -> None:
        value["activation"]["active_task_id"] = value["activation"]["source_task_id"]

    def custody(value: Dict[str, object]) -> None:
        value["goal"]["custody"] = "source-owned"

    def false_ready(value: Dict[str, object]) -> None:
        value["overall_status"] = "in-progress"

    return {
        "dependency": dependency,
        "action": action,
        "activation": activation,
        "custody": custody,
        "false-ready": false_ready,
    }


def validate_release(release_dir: Path, output_format: str = "text") -> int:
    release_dir = release_dir.resolve()
    manifest_path = release_dir / "release-manifest.json"
    checksum_path = release_dir / "SHA256SUMS"
    if not manifest_path.is_file() or not checksum_path.is_file():
        raise VibeError("release-manifest.json and SHA256SUMS are required")
    try:
        manifest = json.loads(
            manifest_path.read_text(encoding="utf-8"),
            object_pairs_hook=reject_duplicate_json_keys,
        )
    except (OSError, json.JSONDecodeError, ValueError) as error:
        raise VibeError(f"release manifest is invalid: {error}") from error
    if not isinstance(manifest, dict):
        raise VibeError("release manifest must be a JSON object")

    errors: List[str] = []
    version = str(manifest.get("kit_version", ""))
    if not re.fullmatch(r"\d+\.\d+\.\d+", version):
        errors.append("manifest kit_version must be strict SemVer")
    if manifest.get("schema_version") != RELEASE_MANIFEST_SCHEMA:
        errors.append("unsupported release manifest schema")
    status = manifest.get("status")
    if status not in RELEASE_STATUSES:
        errors.append("release candidate status is missing or unsupported")
    if status in ("prerelease", "stable"):
        source = manifest.get("source")
        if not isinstance(source, dict):
            errors.append(f"{status} source metadata must be an object")
        elif (
            not re.fullmatch(r"[0-9a-f]{40,64}", str(source.get("ref", "")))
            or source.get("tree_state") != "clean"
        ):
            errors.append(f"{status} requires a committed clean source ref")
    release_name = f"vibe-kit-{version}.zip"
    plugin_name = f"vibe-kit-plugin-{version}.zip"

    checksum_entries: Dict[str, str] = {}
    for line in checksum_path.read_text(encoding="utf-8").splitlines():
        match = re.fullmatch(r"([0-9a-f]{64})  (.+)", line)
        if not match or not archive_name_is_safe(match.group(2)):
            errors.append(f"invalid SHA256SUMS line: {line!r}")
            continue
        checksum_entries[match.group(2)] = match.group(1)
    marketplace_hashes = manifest.get("marketplace_files")
    if not isinstance(marketplace_hashes, dict):
        errors.append("manifest marketplace_files must be an object")
        marketplace_hashes = {}
    expected_checksum_paths = {
        release_name,
        plugin_name,
        "marketplace/marketplace.json",
        "release-manifest.json",
    }
    expected_checksum_paths.update(
        "marketplace/" + str(relative) for relative in marketplace_hashes
    )
    if set(checksum_entries) != expected_checksum_paths:
        errors.append("SHA256SUMS does not cover the exact release artifact set")
    for relative, expected in checksum_entries.items():
        path = release_dir / relative
        if not path.is_file():
            errors.append(f"missing checksummed artifact: {relative}")
        elif sha256(path) != expected:
            errors.append(f"checksum mismatch: {relative}")

    artifact_entries = manifest.get("artifacts")
    if not isinstance(artifact_entries, list):
        errors.append("manifest artifacts must be a list")
        artifact_entries = []
    expected_manifest_artifacts = {
        release_name,
        plugin_name,
        "marketplace/marketplace.json",
    }
    seen_artifacts = set()
    for item in artifact_entries:
        if not isinstance(item, dict):
            errors.append("manifest artifact entry must be an object")
            continue
        relative = str(item.get("path", ""))
        seen_artifacts.add(relative)
        path = release_dir / relative
        if not archive_name_is_safe(relative) or not path.is_file():
            errors.append(f"invalid or missing manifest artifact: {relative}")
            continue
        if item.get("sha256") != sha256(path) or item.get("size") != path.stat().st_size:
            errors.append(f"manifest artifact metadata mismatch: {relative}")
    if seen_artifacts != expected_manifest_artifacts:
        errors.append("manifest does not declare the exact artifact set")

    release_entries, release_errors = read_normalized_archive(
        release_dir / release_name, f"vibe-kit-{version}"
    )
    plugin_entries, plugin_errors = read_normalized_archive(
        release_dir / plugin_name, "vibe-kit"
    )
    errors.extend(release_errors)
    errors.extend(plugin_errors)
    payload_hashes = manifest.get("payload_files")
    if not isinstance(payload_hashes, dict):
        errors.append("manifest payload_files must be an object")
        payload_hashes = {}
    actual_payload_hashes = {
        relative: hashlib.sha256(content).hexdigest()
        for relative, content in sorted(release_entries.items())
    }
    if actual_payload_hashes != payload_hashes:
        errors.append("release ZIP payload does not match manifest payload_files")
    actual_payload_tree_sha256 = payload_tree_sha256_from_hashes(
        actual_payload_hashes
    )
    if manifest.get("payload_tree_sha256") != actual_payload_tree_sha256:
        errors.append("release manifest payload-tree identity does not match payload")
    core_version = release_entries.get(".vibe/core/version", b"").decode("utf-8", errors="replace").strip()
    if core_version != version:
        errors.append("release ZIP core version does not match kit_version")
    protocol_bytes = release_entries.get(".vibe/core/protocol.json")
    release_protocol_value: Dict[str, object] = {}
    if protocol_bytes is None:
        errors.append("release ZIP is missing protocol metadata")
    else:
        try:
            loaded_protocol = json.loads(
                protocol_bytes.decode("utf-8"),
                object_pairs_hook=reject_duplicate_json_keys,
            )
            if isinstance(loaded_protocol, dict):
                release_protocol_value = loaded_protocol
            else:
                errors.append("release protocol metadata must be an object")
        except (UnicodeDecodeError, json.JSONDecodeError, ValueError):
            errors.append("release protocol metadata is invalid")
    for protocol_key in (
        "manifest_schema",
        "core_protocol",
        "feedback_protocol",
        "agent_install_protocol",
        "takeover_contract_registry_sha256",
        "predecessor_migrations",
        "adapters",
    ):
        if manifest.get(protocol_key) != release_protocol_value.get(protocol_key):
            errors.append(
                f"release manifest {protocol_key} does not match payload protocol metadata"
            )
    if release_protocol_value.get("agent_install_protocol") != AGENT_INSTALL_PROTOCOL:
        errors.append("release Agent install protocol is unsupported")
    if release_protocol_value.get("core_protocol") != CORE_PROTOCOL:
        errors.append("release core protocol is unsupported")
    if release_protocol_value.get("takeover_contract_registry_sha256") != (
        TAKEOVER_CONTRACT_REGISTRY_SHA256
    ):
        errors.append("release takeover contract registry digest is unsupported")
    release_migration_mirror = release_protocol_value.get("predecessor_migrations")
    if (
        not valid_predecessor_migration_mirror(release_migration_mirror)
        or not valid_predecessor_migration_mirror(
            manifest.get("predecessor_migrations")
        )
        or manifest.get("predecessor_migrations") != release_migration_mirror
    ):
        errors.append("release predecessor-migration registry mirror is unsupported")
    packaged_cli = release_entries.get("bin/vibe")
    try:
        expected_cli = (source_root() / "bin/vibe").read_bytes()
    except OSError:
        expected_cli = b""
    if packaged_cli != expected_cli:
        errors.append("release compiled predecessor-migration registry authority is unsupported")
    codex_protocol = (
        release_protocol_value.get("adapters", {}).get("codex", {})
        if isinstance(release_protocol_value.get("adapters"), dict)
        else {}
    )
    if not isinstance(codex_protocol, dict) or (
        codex_protocol.get("version") != CODEX_ADAPTER_PROTOCOL
        or codex_protocol.get("core_protocol") != CORE_PROTOCOL
        or codex_protocol.get("upgrade_activation")
        != {
            "same_task_reload": "conditional-unclaimed",
            "automatic_successor_handoff": "conditional-unclaimed",
            "manual_new_task": "supported",
        }
    ):
        errors.append("release Codex adapter activation capability is unsupported")
    for required in (
        "bin/vibe",
        "AGENTS.md",
        "AGENT_INSTALL.md",
        "agent-install.json",
        "templates/project/project-rules.md",
        "templates/project/onboarding.json",
    ):
        if required not in release_entries:
            errors.append(f"release ZIP is missing required payload file: {required}")

    install_guide = release_entries.get("AGENT_INSTALL.md")
    if install_guide is not None:
        if not validate_agent_install_guide_bytes(install_guide):
            errors.append("AGENT_INSTALL.md is malformed")

    install_contract_bytes = release_entries.get("agent-install.json")
    install_contract: Dict[str, object] = {}
    if install_contract_bytes is not None:
        try:
            loaded_contract = json.loads(
                install_contract_bytes.decode("utf-8"),
                object_pairs_hook=reject_duplicate_json_keys,
            )
            if isinstance(loaded_contract, dict):
                install_contract = loaded_contract
            else:
                errors.append("agent-install.json must be an object")
        except (UnicodeDecodeError, json.JSONDecodeError, ValueError):
            errors.append("agent-install.json is malformed")
    if install_contract:
        if install_contract.get("schema_version") != AGENT_INSTALL_SCHEMA:
            errors.append("agent install contract schema is unsupported")
        if install_contract.get("protocol_version") != AGENT_INSTALL_PROTOCOL or (
            install_contract.get("protocol_version")
            != release_protocol_value.get("agent_install_protocol")
        ):
            errors.append("agent install contract protocol does not match payload protocol")
        if install_contract.get("kit_version") != version:
            errors.append("agent install contract version does not match release")
        canonical = install_contract.get("canonical_source")
        if not isinstance(canonical, dict) or canonical.get("repository") != (
            "https://github.com/mintgao/vibe-kit"
        ):
            errors.append("agent install contract canonical source is invalid")
        adapter = install_contract.get("adapter")
        codex = release_protocol_value.get("adapters", {}).get("codex", {}) if isinstance(
            release_protocol_value.get("adapters"), dict
        ) else {}
        if not isinstance(adapter, dict) or (
            adapter.get("name") != "codex"
            or adapter.get("protocol") != codex.get("version")
        ):
            errors.append("agent install contract adapter does not match payload protocol")
        channels = install_contract.get("release_channels")
        allowed_statuses = channels.get("allowed_statuses") if isinstance(channels, dict) else None
        if not isinstance(allowed_statuses, list) or status not in allowed_statuses:
            errors.append("agent install contract release channel does not match release status")
        errors.extend(validate_agent_install_contract_shape(install_contract))

        activation_contract = install_contract.get("activation")
        declared_activation_paths = (
            activation_contract.get("activation_paths")
            if isinstance(activation_contract, dict)
            else None
        )
        try:
            actual_activation_paths, activation_hashes, actual_activation_digest = (
                reference_activation_identity_from_entries(
                    release_entries, install_contract, release_protocol_value
                )
            )
        except VibeError:
            actual_activation_paths = []
            activation_hashes = {}
            actual_activation_digest = ""
            errors.append("release activation identity cannot be recomputed")
        if declared_activation_paths != actual_activation_paths:
            errors.append("agent install activation paths do not match release payload")
        if not isinstance(activation_contract, dict) or (
            activation_contract.get("activation_set_algorithm")
            != ACTIVATION_SET_ALGORITHM
            or
            activation_contract.get("activation_set_sha256")
            != actual_activation_digest
        ):
            errors.append("agent install activation-set identity does not match payload")
        if manifest.get("activation_set_sha256") != actual_activation_digest:
            errors.append("release manifest activation-set identity does not match payload")
        if manifest.get("agent_install_schema") != AGENT_INSTALL_SCHEMA:
            errors.append("release manifest Agent-install schema is unsupported")
        if manifest.get("takeover_schema") != TAKEOVER_SCHEMA_VERSION:
            errors.append("release manifest takeover schema is unsupported")
        if manifest.get("maintenance_bridge_schema") != MAINTENANCE_BRIDGE_SCHEMA_VERSION:
            errors.append("release manifest maintenance bridge schema is unsupported")

        # Exercise the production structural validator against bounded canonical cases.
        canonical_context = {
            "project_root": "/canonical/vibe-project",
            "manifest_sha256": "1" * 64,
            "activation_set_sha256": actual_activation_digest,
            "target_fingerprint": {
                "kit_version": version,
                "core_protocol": CORE_PROTOCOL,
                "agent_install_schema": AGENT_INSTALL_SCHEMA,
                "agent_install_protocol": AGENT_INSTALL_PROTOCOL,
                "adapter_name": "codex",
                "adapter_protocol": CODEX_ADAPTER_PROTOCOL,
                "manifest_sha256": "1" * 64,
                "activation_set_sha256": actual_activation_digest,
            },
        }
        canonical_valid = canonical_takeover_fixture(canonical_context)
        if validate_takeover_object(canonical_valid, canonical_context):
            errors.append("production takeover validator rejects canonical valid result")
        for case_name, mutation in canonical_takeover_invalid_cases().items():
            candidate = copy.deepcopy(canonical_valid)
            mutation(candidate)
            if not validate_takeover_object(candidate, canonical_context):
                errors.append(
                    f"production takeover validator accepts canonical invalid case: {case_name}"
                )

    plugin_manifest_bytes = plugin_entries.get(".codex-plugin/plugin.json")
    plugin_manifest: Dict[str, object] = {}
    if plugin_manifest_bytes is None:
        errors.append("Plugin ZIP is missing .codex-plugin/plugin.json")
    else:
        try:
            loaded = json.loads(plugin_manifest_bytes.decode("utf-8"))
            if isinstance(loaded, dict):
                plugin_manifest = loaded
            else:
                errors.append("Plugin manifest must be an object")
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            errors.append(f"Plugin manifest is invalid: {error}")
    if plugin_manifest.get("name") != "vibe-kit" or plugin_manifest.get("version") != version:
        errors.append("Plugin name/version does not match release")
    if plugin_manifest.get("payload_tree_sha256") != actual_payload_tree_sha256:
        errors.append("Plugin payload-tree identity does not match release payload")
    for forbidden in ("mcpServers", "hooks", "apps"):
        if forbidden in plugin_manifest:
            errors.append(f"Plugin declares forbidden capability: {forbidden}")
    skill_names = {
        PurePosixPath(relative).parts[1]
        for relative in plugin_entries
        if relative.startswith("skills/") and len(PurePosixPath(relative).parts) > 2
    }
    if skill_names != {"vibe-bootstrap", "vibe-maintain"}:
        errors.append("Plugin ZIP must contain exactly the bootstrap and maintenance Skills")
    plugin_payload = {
        relative[len("payload/"):]: content
        for relative, content in plugin_entries.items()
        if relative.startswith("payload/")
    }
    if plugin_payload != release_entries:
        errors.append("Plugin bundled payload differs from release ZIP payload")

    expanded_plugin_root = release_dir / "marketplace/plugins/vibe-kit"
    expanded_plugin = {
        path.relative_to(expanded_plugin_root).as_posix(): path.read_bytes()
        for path in sorted(expanded_plugin_root.rglob("*"))
        if path.is_file()
    } if expanded_plugin_root.is_dir() else {}
    expected_expanded_plugin = {
        relative: content
        for relative, content in plugin_entries.items()
    }
    if expanded_plugin != expected_expanded_plugin:
        errors.append("marketplace Plugin files differ from Plugin ZIP")
    actual_marketplace_hashes = {
        "plugins/vibe-kit/" + relative: hashlib.sha256(content).hexdigest()
        for relative, content in sorted(expanded_plugin.items())
    }
    if actual_marketplace_hashes != marketplace_hashes:
        errors.append("marketplace Plugin files do not match release manifest")

    marketplace_path = release_dir / "marketplace/marketplace.json"
    if marketplace_path.is_file():
        try:
            marketplace = json.loads(marketplace_path.read_text(encoding="utf-8"))
            entry = marketplace["plugins"][0]
            if (
                marketplace.get("name") != "personal"
                or entry.get("name") != "vibe-kit"
                or entry.get("source", {}).get("path") != "./plugins/vibe-kit"
            ):
                errors.append("marketplace entry does not point to the bundled Vibe Kit Plugin")
        except (OSError, json.JSONDecodeError, KeyError, IndexError, TypeError, AttributeError) as error:
            errors.append(f"marketplace catalog is invalid: {error}")

    if errors:
        if output_format == "json":
            print_json(
                result_envelope(
                    "validate-release",
                    "invalid",
                    release_directory=str(release_dir),
                    kit_version=version or None,
                    errors=errors,
                    network_used=False,
                )
            )
            return 1
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
        print(f"Release validation failed with {len(errors)} error(s).", file=sys.stderr)
        return 1
    if output_format == "json":
        print_json(
            result_envelope(
                "validate-release",
                "valid",
                release_directory=str(release_dir),
                kit_version=version,
                payload_files=len(release_entries),
                agent_install_schema=install_contract.get("schema_version"),
                agent_install_protocol=release_protocol_value.get(
                    "agent_install_protocol"
                ),
                payload_tree_sha256=actual_payload_tree_sha256,
                activation_set_sha256=(
                    install_contract.get("activation", {}).get(
                        "activation_set_sha256"
                    )
                    if isinstance(install_contract.get("activation"), dict)
                    else None
                ),
                network_used=False,
            )
        )
        return 0
    print(f"Release validation passed: {release_dir}")
    print(f"Version: {version}")
    print(f"Payload files: {len(release_entries)}")
    print("Network: not used")
    return 0


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace(
        "+00:00", "Z"
    )


def feedback_project_name(target: Path) -> str:
    config = target / ".vibe/project.yaml"
    if not config.is_file():
        return target.name
    for line in config.read_text(encoding="utf-8", errors="ignore").splitlines():
        match = re.match(r"^\s{2}name:\s*(.+?)\s*$", line)
        if not match:
            continue
        raw = match.group(1)
        try:
            return str(json.loads(raw))
        except json.JSONDecodeError:
            return raw.strip("'\"")
    return target.name


def feedback_state_root(target: Path, create: bool = False) -> Path:
    root = target / FEEDBACK_ROOT
    if create:
        root.mkdir(parents=True, exist_ok=True)
        local_root = root.parent
        ignore = local_root / ".gitignore"
        if not ignore.exists():
            atomic_write_text(ignore, "*\n!.gitignore\n")
    return root


def feedback_redact_text(
    value: object, target: Path, field: str, required: bool = True
) -> Tuple[str, List[str]]:
    if not isinstance(value, str):
        raise VibeError(f"feedback field {field!r} must be a string")
    text = value.strip()
    if required and not text:
        raise VibeError(f"feedback field {field!r} is required")
    if len(text) > 2000 or text.count("\n") > 4:
        raise VibeError(
            f"feedback field {field!r} is too large; summarize instead of including raw logs or code"
        )
    for pattern in SECRET_PATTERNS:
        if pattern.search(text):
            raise VibeError(
                f"feedback field {field!r} appears to contain a secret; public feedback is blocked"
            )

    redactions: List[str] = []

    def replace(pattern: re.Pattern, replacement: str, kind: str) -> None:
        nonlocal text
        text, count = pattern.subn(replacement, text)
        redactions.extend([kind] * count)

    target_text = str(target.resolve())
    if target_text and target_text in text:
        text = text.replace(target_text, "<PROJECT_ROOT>")
        redactions.append("absolute_path")

    project_name = feedback_project_name(target)
    for private_name in (project_name, target.name):
        if len(private_name) >= 4 and private_name.lower() in text.lower():
            text, count = re.subn(
                re.escape(private_name), "<PROJECT>", text, flags=re.IGNORECASE
            )
            redactions.extend(["project_identity"] * count)

    replace(
        re.compile(
            r"(?<![A-Za-z0-9])/(?:Users|home|private|var|opt|tmp)(?:/[^\s,;]+)+"
        ),
        "<ABSOLUTE_PATH>",
        "absolute_path",
    )
    replace(
        re.compile(r"\b[A-Za-z]:\\(?:[^\s,;]+\\)*[^\s,;]+"),
        "<ABSOLUTE_PATH>",
        "absolute_path",
    )
    replace(
        re.compile(r"\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b", re.IGNORECASE),
        "<EMAIL>",
        "email",
    )
    replace(re.compile(r"https?://[^\s)\]>]+", re.IGNORECASE), "<URL>", "url")
    replace(
        re.compile(r"(?<!\d)(?:\+?\d[\d -]{8,}\d)(?!\d)"),
        "<PHONE>",
        "phone",
    )
    return text, redactions


def feedback_redact_list(
    value: object, target: Path, field: str
) -> Tuple[List[str], List[str]]:
    if value is None:
        return [], []
    if not isinstance(value, list) or len(value) > 5:
        raise VibeError(f"feedback field {field!r} must be a list with at most 5 items")
    sanitized: List[str] = []
    redactions: List[str] = []
    for index, item in enumerate(value):
        clean, found = feedback_redact_text(item, target, f"{field}[{index}]")
        sanitized.append(clean)
        redactions.extend(found)
    return sanitized, redactions


def feedback_fingerprint(signal: Dict[str, object]) -> str:
    raw = "|".join(
        str(signal.get(key, ""))
        for key in ("kind", "component", "summary", "expected")
    ).lower()
    normalized = re.sub(r"[^a-z0-9<>]+", " ", raw).strip()
    return "sha256:" + hashlib.sha256(normalized.encode("utf-8")).hexdigest()


def feedback_preview(report: Dict[str, object], state: Dict[str, object]) -> str:
    signal = report["signal"]
    environment = report["environment"]
    privacy = report["privacy"]
    dedup = report["dedup"]
    reproduction = signal.get("reproduction", [])
    evidence = signal.get("evidence", [])
    lines = [
        f"## Summary\n\n{signal['summary']}",
        f"## Expected\n\n{signal['expected']}",
        f"## Observed\n\n{signal['observed']}",
        f"## Impact\n\n{signal['impact']}",
        f"## Hypothesis\n\n{signal['hypothesis']}",
        f"## Proposed iteration\n\n{signal['proposal']}",
    ]
    if reproduction:
        lines.append(
            "## Generic reproduction\n\n"
            + "\n".join(f"{index}. {item}" for index, item in enumerate(reproduction, 1))
        )
    if evidence:
        lines.append(
            "## Sanitized evidence\n\n" + "\n".join(f"- {item}" for item in evidence)
        )
    lines.extend(
        (
            "## Classification\n\n"
            f"- Kind: `{signal['kind']}`\n"
            f"- Component: `{signal['component']}`\n"
            f"- Severity: `{signal['severity']}`\n"
            f"- Confidence: `{signal['confidence']}`\n"
            f"- Trigger: `{signal['trigger']}`\n"
            f"- Occurrences in this project: `{state.get('occurrence_count', 1)}`",
            "## Minimal environment\n\n"
            f"- Vibe Kit: `{environment['vibe_kit_version']}`\n"
            f"- Workflow: `{environment['workflow']}`\n"
            f"- Agent role: `{environment['agent_role']}`\n"
            f"- Runtime: `{environment['runtime']}`\n"
            f"- Platform family: `{environment['platform_family']}`",
            "## Privacy\n\n"
            f"- Status: `{privacy['status']}`\n"
            f"- Public submission: `{privacy.get('public_submission', 'allowed')}`\n"
            "- Raw code, logs, prompts, conversations and environment values are not included.",
            f"<!-- vibe-kit-feedback:fingerprint={dedup['fingerprint']} -->",
        )
    )
    return "\n\n".join(lines) + "\n"


def feedback_input(args: argparse.Namespace) -> Dict[str, object]:
    if args.input:
        try:
            raw = sys.stdin.read() if args.input == "-" else Path(args.input).read_text(
                encoding="utf-8"
            )
            value = json.loads(raw)
        except (OSError, json.JSONDecodeError) as error:
            raise VibeError(f"cannot read feedback input: {error}") from error
        if not isinstance(value, dict):
            raise VibeError("feedback input must be a JSON object")
        return value
    return {
        "kind": args.kind,
        "component": args.component,
        "title": args.title,
        "summary": args.summary,
        "expected": args.expected,
        "observed": args.observed,
        "impact": args.impact,
        "hypothesis": args.hypothesis,
        "proposal": args.proposal,
        "reproduction": args.reproduction,
        "evidence": args.evidence,
        "workflow": args.workflow,
        "agent_role": args.agent_role,
        "severity": args.severity,
        "confidence": args.confidence,
        "trigger": args.trigger,
        "security_sensitive": bool(getattr(args, "security_sensitive", False)),
    }


def feedback_revision_input(args: argparse.Namespace) -> Dict[str, object]:
    if not args.input:
        raise VibeError("feedback revise requires --input with a JSON object")
    try:
        raw = (
            sys.stdin.read()
            if args.input == "-"
            else Path(args.input).read_text(encoding="utf-8")
        )
        value = json.loads(raw)
    except (OSError, json.JSONDecodeError) as error:
        raise VibeError(f"cannot read feedback revision input: {error}") from error
    if not isinstance(value, dict):
        raise VibeError("feedback revision input must be a JSON object")
    return value


def feedback_build_report(target: Path, raw: Dict[str, object]) -> Dict[str, object]:
    kind = str(raw.get("kind", ""))
    severity = str(raw.get("severity", "medium"))
    confidence = str(raw.get("confidence", "medium"))
    if kind not in FEEDBACK_KINDS:
        raise VibeError(f"feedback kind must be one of: {', '.join(FEEDBACK_KINDS)}")
    if severity not in FEEDBACK_SEVERITIES:
        raise VibeError(
            f"feedback severity must be one of: {', '.join(FEEDBACK_SEVERITIES)}"
        )
    if confidence not in FEEDBACK_CONFIDENCE:
        raise VibeError(
            f"feedback confidence must be one of: {', '.join(FEEDBACK_CONFIDENCE)}"
        )
    security_sensitive = raw.get("security_sensitive", False)
    if not isinstance(security_sensitive, bool):
        raise VibeError("feedback field 'security_sensitive' must be a boolean")

    redactions: List[str] = []
    signal: Dict[str, object] = {
        "kind": kind,
        "severity": severity,
        "confidence": confidence,
    }
    for key in (
        "component",
        "title",
        "summary",
        "expected",
        "observed",
        "impact",
        "hypothesis",
        "proposal",
        "trigger",
    ):
        clean, found = feedback_redact_text(raw.get(key, ""), target, key)
        signal[key] = clean
        redactions.extend(found)
    reproduction, found = feedback_redact_list(raw.get("reproduction"), target, "reproduction")
    signal["reproduction"] = reproduction
    redactions.extend(found)
    evidence, found = feedback_redact_list(raw.get("evidence"), target, "evidence")
    signal["evidence"] = evidence
    redactions.extend(found)

    environment: Dict[str, str] = {}
    defaults = {
        "workflow": "unspecified",
        "agent_role": "unspecified",
        "runtime": f"Python {sys.version_info.major}.{sys.version_info.minor}",
        "platform_family": platform.system() or "Unknown",
    }
    for key, default in defaults.items():
        clean, found = feedback_redact_text(raw.get(key, default), target, key)
        environment[key] = clean
        redactions.extend(found)
    environment["vibe_kit_version"] = framework_version(target)

    counts: Dict[str, int] = {}
    for item in redactions:
        counts[item] = counts.get(item, 0) + 1
    fingerprint = feedback_fingerprint(signal)
    return {
        "schema_version": FEEDBACK_SCHEMA_VERSION,
        "created_at": utc_now(),
        "signal": signal,
        "environment": environment,
        "privacy": {
            "policy": "strict",
            "raw_evidence_persisted": False,
            "status": "redacted" if counts else "clean",
            "public_submission": "blocked" if security_sensitive else "allowed",
            "block_reason": "security-sensitive" if security_sensitive else None,
            "redactions": [
                {"class": key, "count": counts[key]} for key in sorted(counts)
            ],
        },
        "dedup": {"fingerprint": fingerprint, "local": "unique"},
    }


def feedback_record_paths(target: Path, report_id: str) -> Tuple[Path, Path, Path]:
    if not re.fullmatch(r"fb-[0-9]{8}t[0-9]{6}z-[a-f0-9]{8}", report_id):
        raise VibeError(f"invalid feedback report id: {report_id}")
    root = feedback_state_root(target) / report_id
    return root / "report.json", root / "preview.md", root / "state.json"


def load_feedback_record(
    target: Path, report_id: str
) -> Tuple[Dict[str, object], Dict[str, object], Path]:
    report_path, _, state_path = feedback_record_paths(target, report_id)
    if not report_path.is_file() or not state_path.is_file():
        raise VibeError(f"feedback report not found: {report_id}")
    try:
        report = json.loads(report_path.read_text(encoding="utf-8"))
        state = json.loads(state_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise VibeError(f"cannot read feedback report {report_id}: {error}") from error
    if not isinstance(report, dict) or not isinstance(state, dict):
        raise VibeError(f"invalid feedback report: {report_id}")
    state = normalize_feedback_state(state)
    return report, state, report_path.parent


def feedback_attention(
    status: str, reason: str, revision: int = 1
) -> Dict[str, object]:
    return {
        "revision": revision,
        "status": status,
        "reason": reason,
        "last_presented": None,
    }


def normalize_feedback_state(state: Dict[str, object]) -> Dict[str, object]:
    if state.get("state_schema_version") != FEEDBACK_STATE_SCHEMA_VERSION:
        state["state_schema_version"] = FEEDBACK_STATE_SCHEMA_VERSION
        state["attention"] = feedback_attention("legacy", "legacy")
        return state
    attention = state.get("attention")
    if not isinstance(attention, dict):
        state["attention"] = feedback_attention("legacy", "legacy")
        return state
    revision = attention.get("revision", 1)
    if not isinstance(revision, int) or revision < 1:
        revision = 1
    status = str(attention.get("status", "legacy"))
    if status not in ("pending", "presented", "handled-local", "manual", "legacy"):
        status = "legacy"
    reason = str(attention.get("reason", "legacy"))
    if reason not in ("created", "material-resurface", "revised", "legacy", "manual"):
        reason = "legacy"
    last_presented = attention.get("last_presented")
    if last_presented is not None and not isinstance(last_presented, dict):
        last_presented = None
    state["attention"] = {
        "revision": revision,
        "status": status,
        "reason": reason,
        "last_presented": last_presented,
    }
    return state


def feedback_public_submission_allowed(report: Dict[str, object]) -> bool:
    privacy = report.get("privacy", {})
    return isinstance(privacy, dict) and privacy.get("public_submission", "allowed") == "allowed"


def feedback_upsert(
    target: Path, raw: Dict[str, object], attention_status: str
) -> Tuple[Dict[str, object], Dict[str, object], Path, str]:
    target = target.resolve()
    report = feedback_build_report(target, raw)
    root = feedback_state_root(target, create=True)
    fingerprint = str(report["dedup"]["fingerprint"])
    now = utc_now()
    for candidate in sorted(root.glob("fb-*/report.json")):
        try:
            existing = json.loads(candidate.read_text(encoding="utf-8"))
            state_path = candidate.parent / "state.json"
            state = json.loads(state_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(existing, dict) or not isinstance(state, dict):
            continue
        existing_dedup = existing.get("dedup")
        existing_signal = existing.get("signal")
        if not isinstance(existing_dedup, dict) or not isinstance(existing_signal, dict):
            continue
        if existing_dedup.get("fingerprint") != fingerprint:
            continue
        state = normalize_feedback_state(state)
        incoming_signal = report["signal"]
        new_evidence = [
            item
            for item in incoming_signal.get("evidence", [])
            if item not in existing_signal.get("evidence", [])
        ]
        severity_increased = SEVERITY_RANK[str(incoming_signal["severity"])] > SEVERITY_RANK[
            str(existing_signal["severity"])
        ]
        existing_privacy = existing.get("privacy")
        incoming_privacy = report.get("privacy")
        privacy_upgraded = False
        if isinstance(existing_privacy, dict) and isinstance(incoming_privacy, dict):
            if (
                incoming_privacy.get("public_submission") == "blocked"
                and existing_privacy.get("public_submission", "allowed") != "blocked"
            ):
                existing_privacy["public_submission"] = "blocked"
                existing_privacy["block_reason"] = incoming_privacy.get(
                    "block_reason", "security-sensitive"
                )
                privacy_upgraded = True
            if (
                incoming_privacy.get("status") == "redacted"
                and existing_privacy.get("status") == "clean"
            ):
                existing_privacy["status"] = "redacted"
                existing_privacy["redactions"] = incoming_privacy.get("redactions", [])
                privacy_upgraded = True
        state["occurrence_count"] = int(state.get("occurrence_count", 1)) + 1
        state["last_seen"] = now
        if new_evidence:
            existing_signal["evidence"] = (
                list(existing_signal.get("evidence", [])) + new_evidence
            )[:5]
        if severity_increased:
            existing_signal["severity"] = incoming_signal["severity"]
        material = bool(new_evidence or severity_increased or privacy_upgraded)
        if state.get("status") == "dismissed" and not material:
            atomic_write_json(state_path, state)
            return existing, state, candidate.parent, "suppressed"
        if state.get("status") == "submitted":
            existing_dedup["local"] = "duplicate"
            atomic_write_json(candidate, existing)
            atomic_write_json(state_path, state)
            atomic_write_text(candidate.parent / "preview.md", feedback_preview(existing, state))
            return existing, state, candidate.parent, "submitted"
        if material:
            state["status"] = "review-ready"
            state["dismiss_reason"] = None
            prior_attention = state.get("attention", {})
            revision = int(prior_attention.get("revision", 1)) + 1
            state["attention"] = feedback_attention(
                attention_status, "material-resurface", revision
            )
            state["remote"] = {"status": "not_checked", "matching_issue": None}
            state["submission"] = None
        existing_dedup["local"] = "duplicate"
        atomic_write_json(candidate, existing)
        atomic_write_json(state_path, state)
        atomic_write_text(candidate.parent / "preview.md", feedback_preview(existing, state))
        return existing, state, candidate.parent, "resurfaced" if material else "reused"

    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dt%H%M%Sz")
    report_id = f"fb-{stamp}-{fingerprint.split(':', 1)[1][:8]}"
    report["report_id"] = report_id
    state = {
        "state_schema_version": FEEDBACK_STATE_SCHEMA_VERSION,
        "status": "review-ready",
        "occurrence_count": 1,
        "last_seen": now,
        "dismiss_reason": None,
        "remote": {"status": "not_checked", "matching_issue": None},
        "submission": None,
        "attention": feedback_attention(attention_status, "created"),
    }
    report_path, preview_path, state_path = feedback_record_paths(target, report_id)
    report_path.parent.mkdir(parents=True)
    atomic_write_json(report_path, report)
    atomic_write_json(state_path, state)
    atomic_write_text(preview_path, feedback_preview(report, state))
    return report, state, report_path.parent, "created"


def feedback_draft(target: Path, raw: Dict[str, object]) -> int:
    report, state, root, outcome = feedback_upsert(target, raw, "manual")
    report_id = str(report["report_id"])
    if outcome == "created":
        print(f"Feedback draft ready: {report_id}")
        print(f"Preview: {root / 'preview.md'}")
        print(f"Privacy: {report['privacy']['status']}")
    elif outcome == "suppressed":
        print(f"Feedback suppressed by prior dismissal: {report_id}")
    elif outcome == "resurfaced":
        print(f"Feedback resurfaced with material change: {report_id}")
        print(f"Occurrences: {state['occurrence_count']}")
    elif outcome == "submitted":
        print(f"Feedback already submitted; occurrence recorded: {report_id}")
        print(f"Occurrences: {state['occurrence_count']}")
    else:
        print(f"Feedback reused existing candidate: {report_id}")
        print(f"Occurrences: {state['occurrence_count']}")
    print("Network: not used")
    return 0


def feedback_config(target: Path) -> Dict[str, object]:
    defaults: Dict[str, object] = {
        "github_host": "github.com",
        "github_repository": "",
        "labels": [],
    }
    path = target / FEEDBACK_CONFIG_PATH
    if not path.is_file():
        return defaults
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise VibeError(f"cannot read feedback configuration {path}: {error}") from error
    if not isinstance(value, dict):
        raise VibeError(f"invalid feedback configuration: {path}")
    defaults.update(value)
    if not isinstance(defaults.get("labels"), list):
        raise VibeError(f"feedback labels must be a list: {path}")
    return defaults


def feedback_repository(target: Path, explicit: Optional[str]) -> str:
    repository = explicit or str(feedback_config(target).get("github_repository", ""))
    if not repository:
        raise VibeError(
            "No feedback GitHub repository is configured. Local drafting and review remain available; pass --repo owner/repository."
        )
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository):
        raise VibeError("feedback repository must use owner/repository form")
    return repository


def feedback_payload(
    target: Path, report: Dict[str, object], state: Dict[str, object], repository: str
) -> Tuple[str, str, List[str], str]:
    if not feedback_public_submission_allowed(report):
        raise VibeError(
            "public submission is blocked for this security-sensitive feedback; revise it for a public channel or keep it local"
        )
    title = f"[Vibe Kit feedback] {report['signal']['title']}"
    body = feedback_preview(report, state)
    labels = [str(item) for item in feedback_config(target).get("labels", [])]
    canonical = json.dumps(
        {"repository": repository, "title": title, "body": body, "labels": labels},
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    )
    review_hash = "sha256:" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()
    return title, body, labels, review_hash


def feedback_list(target: Path) -> int:
    root = feedback_state_root(target.resolve())
    if not root.is_dir():
        print("No feedback candidates.")
        return 0
    found = 0
    for state_path in sorted(root.glob("fb-*/state.json")):
        try:
            state = json.loads(state_path.read_text(encoding="utf-8"))
            report = json.loads((state_path.parent / "report.json").read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        print(
            f"{state_path.parent.name}\t{state.get('status', 'unknown')}\t"
            f"{state.get('occurrence_count', 1)}\t{report.get('signal', {}).get('title', '')}"
        )
        found += 1
    if not found:
        print("No feedback candidates.")
    return 0


def feedback_dedupe_label(state: Dict[str, object]) -> str:
    attention = state.get("attention", {})
    reason = attention.get("reason") if isinstance(attention, dict) else None
    if reason == "material-resurface":
        return "MATERIAL RESURFACE"
    if reason == "revised":
        return "REVISED LOCAL CANDIDATE"
    if state.get("occurrence_count", 1) != 1:
        return "EXISTING LOCAL CANDIDATE"
    return "UNIQUE LOCAL CANDIDATE"


def feedback_mark_presented(
    root: Path,
    state: Dict[str, object],
    repository: Optional[str],
    review_hash: Optional[str],
) -> None:
    attention = state.get("attention", {})
    if not isinstance(attention, dict):
        attention = feedback_attention("legacy", "legacy")
    attention["status"] = "presented"
    attention["last_presented"] = {
        "repository": repository,
        "review_hash": review_hash,
        "presented_at": utc_now(),
        "revision": attention.get("revision", 1),
    }
    state["attention"] = attention
    atomic_write_json(root / "state.json", state)


def feedback_render_review(
    target: Path,
    report_id: str,
    explicit_repo: Optional[str],
    proactive: bool,
) -> int:
    target = target.resolve()
    report, state, root = load_feedback_record(target, report_id)
    repository = explicit_repo or str(feedback_config(target).get("github_repository", ""))
    public_allowed = feedback_public_submission_allowed(report)
    if repository and public_allowed:
        repository = feedback_repository(target, repository)
        title, body, labels, review_hash = feedback_payload(
            target, report, state, repository
        )
    else:
        title = f"[Vibe Kit feedback] {report['signal']['title']}"
        body = feedback_preview(report, state)
        labels = []
        review_hash = None
    feedback_mark_presented(root, state, repository or None, review_hash)
    if proactive:
        print("Vibe Kit feedback READY — local only")
        print()
        print("发现 1 个可复用的 Vibe Kit 改进点。")
    print(f"Report: {report_id}")
    print(f"Target: {repository or '<not configured>'}")
    privacy_status = str(report["privacy"]["status"]).upper()
    if not public_allowed:
        privacy_status += " / PUBLIC SUBMISSION BLOCKED"
    print(f"Privacy: {privacy_status}")
    print(f"Dedupe: {feedback_dedupe_label(state)}")
    print("Remote access: NOT USED")
    print(f"Labels: {', '.join(labels) if labels else '<none>'}")
    if public_allowed and repository:
        print(f"Review hash: {review_hash}")
        print("--- exact GitHub Issue payload ---")
        print(f"Title: {title}\n")
        print(body, end="")
        print("--- end payload ---")
        if proactive:
            print("建议提交这条反馈。回复“提交”即可。")
            print("也可以回复“稍后”“修改”或“忽略”。")
        else:
            print(
                f"To submit after approving this exact payload:\n"
                f"  ./bin/vibe feedback submit {report_id} --repo {repository} --confirm {review_hash}"
            )
    elif not public_allowed:
        print("Review hash: <unavailable: public submission blocked>")
        print("Public payload: BLOCKED")
        print("The sanitized candidate remains local; revise it before any public submission.")
    else:
        print("Review hash: <unavailable: configure --repo owner/repository>")
        print("Public payload: NOT PREPARED")
        print("The sanitized candidate remains local; configure a repository before review.")
        print("No network was used.")
    print("Network: not used")
    return 0


def feedback_review(target: Path, report_id: str, explicit_repo: Optional[str]) -> int:
    return feedback_render_review(target, report_id, explicit_repo, proactive=False)


def feedback_close(target: Path, raw: Dict[str, object]) -> int:
    target = target.resolve()
    mode, _ = feedback_mode(target)
    if mode == "off":
        return 0
    desired_attention = "pending" if mode == "ask" else "handled-local"
    report, state, root, outcome = feedback_upsert(target, raw, desired_attention)
    report_id = str(report["report_id"])
    if mode == "local":
        if outcome not in ("suppressed", "submitted") and state.get("status") == "review-ready":
            attention = state.get("attention", {})
            if isinstance(attention, dict) and attention.get("status") != "legacy":
                attention["status"] = "handled-local"
                state["attention"] = attention
                atomic_write_json(root / "state.json", state)
        if outcome in ("created", "resurfaced"):
            print(f"Feedback saved locally: {report_id}")
            print("Network: not used")
        return 0
    attention = state.get("attention", {})
    if (
        outcome not in ("suppressed", "submitted")
        and isinstance(attention, dict)
        and attention.get("status") == "pending"
    ):
        return feedback_render_review(target, report_id, None, proactive=True)
    return 0


def feedback_revision_raw(report: Dict[str, object]) -> Dict[str, object]:
    signal = report.get("signal", {})
    environment = report.get("environment", {})
    privacy = report.get("privacy", {})
    if not isinstance(signal, dict) or not isinstance(environment, dict):
        raise VibeError("feedback report is malformed and cannot be revised")
    raw = dict(signal)
    raw.update(
        {
            "workflow": environment.get("workflow", "unspecified"),
            "agent_role": environment.get("agent_role", "unspecified"),
            "security_sensitive": isinstance(privacy, dict)
            and privacy.get("public_submission") == "blocked",
        }
    )
    return raw


def feedback_revise(
    target: Path,
    report_id: str,
    explicit_repo: Optional[str],
    changes: Dict[str, object],
) -> int:
    target = target.resolve()
    report, state, root = load_feedback_record(target, report_id)
    if state.get("status") in ("dismissed", "submitted"):
        raise VibeError(f"{state.get('status')} feedback cannot be revised")
    allowed = {
        "kind",
        "component",
        "title",
        "summary",
        "expected",
        "observed",
        "impact",
        "hypothesis",
        "proposal",
        "reproduction",
        "evidence",
        "workflow",
        "agent_role",
        "severity",
        "confidence",
        "trigger",
        "security_sensitive",
    }
    unknown = sorted(set(changes) - allowed)
    if unknown:
        raise VibeError(f"feedback revision contains unsupported fields: {', '.join(unknown)}")
    raw = feedback_revision_raw(report)
    raw.update(changes)
    revised = feedback_build_report(target, raw)
    old_privacy = report.get("privacy", {})
    new_privacy = revised.get("privacy", {})
    if (
        isinstance(old_privacy, dict)
        and isinstance(new_privacy, dict)
        and old_privacy.get("status") == "redacted"
        and new_privacy.get("status") == "clean"
    ):
        new_privacy["status"] = "redacted"
        new_privacy["redactions"] = old_privacy.get("redactions", [])
    revised["report_id"] = report_id
    revised["created_at"] = report.get("created_at", revised["created_at"])
    fingerprint = revised.get("dedup", {}).get("fingerprint")
    feedback_root = feedback_state_root(target)
    for candidate in sorted(feedback_root.glob("fb-*/report.json")):
        if candidate.parent == root:
            continue
        try:
            other = json.loads(candidate.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if other.get("dedup", {}).get("fingerprint") == fingerprint:
            raise VibeError(
                f"feedback revision collides with existing candidate {candidate.parent.name}; review that candidate instead"
            )
    prior_attention = state.get("attention", {})
    revision = int(prior_attention.get("revision", 1)) + 1 if isinstance(prior_attention, dict) else 2
    state["status"] = "review-ready"
    state["last_seen"] = utc_now()
    state["remote"] = {"status": "not_checked", "matching_issue": None}
    state["submission"] = None
    state["attention"] = feedback_attention("pending", "revised", revision)
    atomic_write_json(root / "report.json", revised)
    atomic_write_json(root / "state.json", state)
    atomic_write_text(root / "preview.md", feedback_preview(revised, state))
    return feedback_render_review(target, report_id, explicit_repo, proactive=True)


def feedback_gh(target: Path) -> Tuple[str, str]:
    executable = shutil.which("gh")
    if not executable:
        raise VibeError(
            "GitHub CLI is required only for feedback check and submit. The local draft is unchanged."
        )
    host = str(feedback_config(target).get("github_host", "github.com"))
    auth = subprocess.run(
        [executable, "auth", "status", "--hostname", host],
        text=True,
        capture_output=True,
        check=False,
    )
    if auth.returncode != 0:
        raise VibeError(
            f"GitHub CLI is not authenticated for {host}. The local draft is unchanged; run gh auth login --hostname {host}."
        )
    return executable, host


def feedback_remote_duplicate(
    target: Path, report: Dict[str, object], repository: str
) -> Optional[Dict[str, object]]:
    executable, _ = feedback_gh(target)
    fingerprint = str(report["dedup"]["fingerprint"])
    result = subprocess.run(
        [
            executable,
            "issue",
            "list",
            "--repo",
            repository,
            "--state",
            "all",
            "--search",
            fingerprint,
            "--json",
            "number,url,title,state",
            "--limit",
            "10",
        ],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        raise RemoteFeedbackError(
            "GitHub duplicate check failed; verify connectivity, authentication and repository access"
        )
    try:
        issues = json.loads(result.stdout or "[]")
    except json.JSONDecodeError as error:
        raise RemoteFeedbackError("GitHub duplicate response was invalid") from error
    if not isinstance(issues, list):
        raise RemoteFeedbackError("GitHub duplicate response was not a list")
    return issues[0] if issues else None


def feedback_check(target: Path, report_id: str, explicit_repo: Optional[str]) -> int:
    target = target.resolve()
    report, state, root = load_feedback_record(target, report_id)
    if not feedback_public_submission_allowed(report):
        raise VibeError(
            "remote duplicate checking is blocked for security-sensitive feedback"
        )
    repository = feedback_repository(target, explicit_repo)
    try:
        duplicate = feedback_remote_duplicate(target, report, repository)
    except RemoteFeedbackError as error:
        print(f"ERROR: Could not verify remote duplicates: {error}", file=sys.stderr)
        print("No issue was created; the local draft is unchanged.", file=sys.stderr)
        return 1
    state["remote"] = {
        "status": "duplicate" if duplicate else "unique",
        "matching_issue": duplicate,
    }
    if duplicate and state.get("status") == "submission-unknown":
        state["status"] = "submitted"
        state["submission"] = {
            "result": "existing",
            "repository": repository,
            "url": duplicate.get("url"),
        }
    elif not duplicate and state.get("status") == "submission-unknown":
        state["status"] = "review-ready"
        state["submission"] = {
            "result": "checked-unique-after-unknown",
            "repository": repository,
        }
    atomic_write_json(root / "state.json", state)
    if duplicate:
        print(f"Feedback already covered by {duplicate.get('url', '<unknown URL>')}")
        print("No new issue was created.")
    else:
        print(f"Remote duplicate check: unique in {repository}")
    return 0


def feedback_submit(
    target: Path,
    report_id: str,
    explicit_repo: Optional[str],
    confirm: Optional[str],
) -> int:
    target = target.resolve()
    report, state, root = load_feedback_record(target, report_id)
    if state.get("status") == "dismissed":
        raise VibeError("dismissed feedback cannot be submitted; create or resurface evidence first")
    if state.get("status") == "submission-unknown":
        raise VibeError(
            "feedback submission outcome is uncertain; run feedback check before any retry"
        )
    if not feedback_public_submission_allowed(report):
        raise VibeError(
            "public submission is blocked for this security-sensitive feedback; no network was used"
        )
    repository = feedback_repository(target, explicit_repo)
    title, body, labels, review_hash = feedback_payload(target, report, state, repository)
    if not confirm or confirm != review_hash:
        raise VibeError(
            "feedback confirmation is missing or stale; run feedback review for this repository and confirm its exact review hash"
        )

    print(f"Target: {repository}")
    print(f"Review hash: {review_hash}")
    print("--- exact GitHub payload ---")
    print(f"Title: {title}\n")
    print(body, end="")
    print("--- end payload ---")

    try:
        duplicate = feedback_remote_duplicate(target, report, repository)
    except RemoteFeedbackError as error:
        state["status"] = "submit-failed"
        state["submission"] = {
            "result": "duplicate-check-failed",
            "category": "remote-duplicate-check",
        }
        atomic_write_json(root / "state.json", state)
        print(f"ERROR: Could not verify remote duplicates: {error}", file=sys.stderr)
        print("No issue was created; retry with the same reviewed hash.", file=sys.stderr)
        return 1
    if duplicate:
        state["status"] = "submitted"
        state["submission"] = {
            "result": "existing",
            "repository": repository,
            "url": duplicate.get("url"),
        }
        atomic_write_json(root / "state.json", state)
        print(f"Feedback already covered by {duplicate.get('url', '<unknown URL>')}")
        print("No new issue was created.")
        return 0

    executable, _ = feedback_gh(target)
    command = [
        executable,
        "issue",
        "create",
        "--repo",
        repository,
        "--title",
        title,
        "--body-file",
        "-",
    ]
    for label in labels:
        command.extend(("--label", label))
    result = subprocess.run(
        command,
        input=body,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        state["status"] = "submission-unknown"
        state["submission"] = {
            "result": "unknown",
            "repository": repository,
            "category": "remote-create",
        }
        atomic_write_json(root / "state.json", state)
        print("ERROR: GitHub issue creation failed or its result is uncertain.", file=sys.stderr)
        print("Search by fingerprint before retrying; the local report is preserved.", file=sys.stderr)
        return 1
    urls = re.findall(r"https://[^\s]+", result.stdout)
    if not urls:
        state["status"] = "submission-unknown"
        state["submission"] = {"result": "unknown", "repository": repository}
        atomic_write_json(root / "state.json", state)
        print("ERROR: GitHub did not return an issue URL; verify before retrying.", file=sys.stderr)
        return 1
    issue_url = urls[-1]
    state["status"] = "submitted"
    state["submission"] = {
        "result": "created",
        "repository": repository,
        "url": issue_url,
        "review_hash": review_hash,
    }
    atomic_write_json(root / "state.json", state)
    print(f"Feedback submitted: {issue_url}")
    return 0


def feedback_dismiss(target: Path, report_id: str, reason: str) -> int:
    target = target.resolve()
    _, state, root = load_feedback_record(target, report_id)
    clean_reason, _ = feedback_redact_text(reason, target, "dismiss reason")
    state["status"] = "dismissed"
    state["dismiss_reason"] = clean_reason
    attention = state.get("attention")
    if isinstance(attention, dict):
        attention["status"] = "handled-local"
        state["attention"] = attention
    atomic_write_json(root / "state.json", state)
    print(f"Feedback dismissed: {report_id}")
    print("The same low-severity fingerprint will stay suppressed until material evidence changes.")
    return 0


def add_feedback_signal_arguments(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--target", default=".")
    parser.add_argument(
        "--input", help="JSON input path, or - for stdin; overrides individual fields"
    )
    parser.add_argument("--kind", choices=FEEDBACK_KINDS, default="workflow-gap")
    parser.add_argument("--component", default="other")
    parser.add_argument("--title")
    parser.add_argument("--summary")
    parser.add_argument("--expected")
    parser.add_argument("--observed")
    parser.add_argument("--impact")
    parser.add_argument("--hypothesis")
    parser.add_argument("--proposal")
    parser.add_argument("--reproduction", action="append", default=[])
    parser.add_argument("--evidence", action="append", default=[])
    parser.add_argument("--workflow", default="unspecified")
    parser.add_argument("--agent-role", default="unspecified")
    parser.add_argument("--severity", choices=FEEDBACK_SEVERITIES, default="medium")
    parser.add_argument("--confidence", choices=FEEDBACK_CONFIDENCE, default="medium")
    parser.add_argument("--trigger", default="explicit-user-request")
    parser.add_argument(
        "--security-sensitive",
        action="store_true",
        help="Keep this feedback local and block public submission.",
    )


def add_format_argument(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--format",
        dest="output_format",
        choices=("text", "json"),
        default="text",
        help="Render the default human-readable result or the versioned Agent JSON result.",
    )


def add_source_arguments(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--source-type",
        default="local-payload",
        help="Selected payload channel recorded in the installation manifest.",
    )
    parser.add_argument("--source-ref", help="Immutable selected tag, Release URL, or commit.")
    parser.add_argument(
        "--artifact-sha256",
        help="SHA-256 verified by the invoking Agent for the selected transferred artifact.",
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="vibe", description="Install and operate the Vibe Kit development workflow."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    for command in ("init", "adopt"):
        child = subparsers.add_parser(command)
        child.add_argument("target", nargs="?", default=".")
        child.add_argument("--name", help="Project name written during first installation")
        add_format_argument(child)
        add_source_arguments(child)

    upgrade_parser = subparsers.add_parser("upgrade")
    upgrade_parser.add_argument("target", nargs="?", default=".")
    add_format_argument(upgrade_parser)
    add_source_arguments(upgrade_parser)

    doctor_parser = subparsers.add_parser("doctor")
    doctor_parser.add_argument("target", nargs="?", default=".")
    add_format_argument(doctor_parser)

    takeover_parser = subparsers.add_parser(
        "validate-takeover",
        description="Validate one host-owned takeover result from standard input.",
    )
    add_format_argument(takeover_parser)

    plan_parser = subparsers.add_parser(
        "plan", description="Preview init, adopt, or upgrade without writing files."
    )
    plan_parser.add_argument("operation", choices=("init", "adopt", "upgrade"))
    plan_parser.add_argument("target", nargs="?", default=".")
    add_format_argument(plan_parser)
    add_source_arguments(plan_parser)

    package_parser = subparsers.add_parser(
        "package", description="Build a deterministic unpublished release candidate."
    )
    package_parser.add_argument(
        "--output", type=Path, help="Empty output directory; defaults to dist/vibe-kit-<version>."
    )
    package_parser.add_argument(
        "--status",
        choices=RELEASE_STATUSES,
        default="release-candidate-unpublished",
        help="Release lifecycle status embedded in release-manifest.json.",
    )

    release_parser = subparsers.add_parser(
        "validate-release", description="Verify a local Vibe Kit release candidate."
    )
    release_parser.add_argument("release_dir")
    add_format_argument(release_parser)

    verify_parser = subparsers.add_parser("verify")
    verify_parser.add_argument("target", nargs="?", default=".")
    verify_parser.add_argument(
        "--only",
        action="append",
        choices=VERIFY_ORDER,
        default=[],
        help="Run only one configured check; repeat to select more than one.",
    )
    add_format_argument(verify_parser)

    item_parser = subparsers.add_parser("work-item")
    item_parser.add_argument("slug")
    item_parser.add_argument("--target", default=".")
    item_parser.add_argument("--size", choices=("S", "M", "L", "s", "m", "l"), default="M")
    item_parser.add_argument("--title")

    feedback_parser = subparsers.add_parser(
        "feedback", description="Create and optionally submit sanitized Vibe Kit feedback."
    )
    feedback_subparsers = feedback_parser.add_subparsers(
        dest="feedback_command", required=True
    )
    draft_parser = feedback_subparsers.add_parser("draft")
    add_feedback_signal_arguments(draft_parser)
    close_parser = feedback_subparsers.add_parser("close")
    add_feedback_signal_arguments(close_parser)
    mode_parser = feedback_subparsers.add_parser("mode")
    mode_parser.add_argument("--target", default=".")

    list_parser = feedback_subparsers.add_parser("list")
    list_parser.add_argument("--target", default=".")
    for feedback_command in ("review", "check"):
        child = feedback_subparsers.add_parser(feedback_command)
        child.add_argument("report_id")
        child.add_argument("--target", default=".")
        child.add_argument("--repo")
    revise_parser = feedback_subparsers.add_parser("revise")
    revise_parser.add_argument("report_id")
    revise_parser.add_argument("--target", default=".")
    revise_parser.add_argument("--repo")
    revise_parser.add_argument(
        "--input", required=True, help="Partial JSON revision path, or - for stdin"
    )
    submit_parser = feedback_subparsers.add_parser("submit")
    submit_parser.add_argument("report_id")
    submit_parser.add_argument("--target", default=".")
    submit_parser.add_argument("--repo")
    submit_parser.add_argument("--confirm")
    dismiss_parser = feedback_subparsers.add_parser("dismiss")
    dismiss_parser.add_argument("report_id")
    dismiss_parser.add_argument("--target", default=".")
    dismiss_parser.add_argument("--reason", required=True)
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        if args.command in ("init", "adopt"):
            return install(
                args.command,
                Path(args.target),
                args.name,
                args.output_format,
                args.source_type,
                args.source_ref,
                args.artifact_sha256,
            )
        if args.command == "upgrade":
            return upgrade(
                Path(args.target),
                args.output_format,
                args.source_type,
                args.source_ref,
                args.artifact_sha256,
            )
        if args.command == "plan":
            return plan(
                args.operation,
                Path(args.target),
                args.output_format,
                args.source_type,
                args.source_ref,
                args.artifact_sha256,
            )
        if args.command == "package":
            return package_release(args.output, args.status)
        if args.command == "validate-release":
            return validate_release(Path(args.release_dir), args.output_format)
        if args.command == "doctor":
            return doctor(Path(args.target), args.output_format)
        if args.command == "validate-takeover":
            return validate_takeover(source_root(), args.output_format)
        if args.command == "verify":
            return verify(Path(args.target), args.only, args.output_format)
        if args.command == "work-item":
            return work_item(Path(args.target), args.slug, args.size, args.title)
        if args.command == "feedback":
            target = Path(args.target)
            if args.feedback_command == "draft":
                return feedback_draft(target, feedback_input(args))
            if args.feedback_command == "close":
                return feedback_close(target, feedback_input(args))
            if args.feedback_command == "mode":
                return feedback_mode_command(target)
            if args.feedback_command == "list":
                return feedback_list(target)
            if args.feedback_command == "review":
                return feedback_review(target, args.report_id, args.repo)
            if args.feedback_command == "check":
                return feedback_check(target, args.report_id, args.repo)
            if args.feedback_command == "revise":
                return feedback_revise(
                    target,
                    args.report_id,
                    args.repo,
                    feedback_revision_input(args),
                )
            if args.feedback_command == "submit":
                return feedback_submit(
                    target, args.report_id, args.repo, args.confirm
                )
            if args.feedback_command == "dismiss":
                return feedback_dismiss(target, args.report_id, args.reason)
    except VibeError as error:
        if getattr(args, "output_format", "text") == "json":
            write_state = error.write_state
            print_json(
                result_envelope(
                    args.command,
                    "error",
                    operation=getattr(args, "operation", args.command),
                    error={"code": error.code, "message": str(error)},
                    write_state=write_state,
                    writes_performed=writes_performed(write_state),
                    recovery=error.recovery,
                )
            )
            return 2
        print(f"error: {error}", file=sys.stderr)
        return 2
    except (OSError, UnicodeError) as error:
        if getattr(args, "output_format", "text") == "json":
            write_state = "none"
            print_json(
                result_envelope(
                    args.command,
                    "error",
                    operation=getattr(args, "operation", args.command),
                    error={"code": "filesystem_error", "message": str(error)},
                    write_state=write_state,
                    writes_performed=writes_performed(write_state),
                    recovery=None,
                )
            )
            return 2
        print(f"error: {error}", file=sys.stderr)
        return 2
    parser.error("unknown command")
    return 2


if __name__ == "__main__":
    sys.exit(main())
