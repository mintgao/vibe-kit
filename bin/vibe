def build_takeover_contract_registry() -> Dict[str, object]:
    """Return the complete compiled schema-1 structural takeover registry."""
    return {
        "result_shape": {
            "additional_properties": False,
            "required_top_level": [
                "takeover_schema_version", "takeover_id", "evidence_origin",
                "completion_owner_task_id", "project_root", "source", "versions",
                "target_fingerprint", "overall_status", "last_completed_stage",
                "write_state", "activation", "goal", "stages", "next_action",
            ],
            "required_source_fields": [
                "type", "ref", "artifact_sha256", "payload_tree_sha256"
            ],
            "required_versions_fields": ["from", "target"],
            "required_fingerprint_fields": [
                "kit_version", "core_protocol", "agent_install_schema",
                "agent_install_protocol", "adapter_name", "adapter_protocol",
                "manifest_sha256", "activation_set_sha256",
            ],
            "required_stage_keys": list(TAKEOVER_STAGE_ORDER),
            "required_stage_fields": ["state", "outcome", "reason_code", "evidence"],
            "required_evidence_fields": ["kind", "ref", "sha256", "task_id", "sequence"],
            "required_activation_fields": [
                "path", "receipt_kind", "receipt_id", "source_task_id",
                "active_task_id", "handoff_idempotency_key",
                "observed_manifest_sha256", "observed_activation_set_sha256",
