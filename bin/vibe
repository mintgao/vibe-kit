EXPECTED_PREDECESSOR_MIGRATION_REGISTRY_SHA256 = (
    "6cbee96e5da8b4d4b5c87403e710aac0740041027a00466f288a670834d1967d"
)
if PREDECESSOR_MIGRATION_REGISTRY_SHA256 != (
    EXPECTED_PREDECESSOR_MIGRATION_REGISTRY_SHA256
):
    raise RuntimeError("compiled predecessor-migration registry digest is invalid")
PREDECESSOR_MIGRATION_MIRROR = {
    "schema_version": 1,
    "registry_sha256": PREDECESSOR_MIGRATION_REGISTRY_SHA256,
    "authority": "target-cli-compiled",
    "modes": ["replace-and-adopt-complete-set"],
}


def valid_predecessor_migration_mirror(value: object) -> bool:
    """Require the exact closed mirror without Python bool/int equality leaks."""
    return (
        isinstance(value, dict)
        and set(value) == {
            "schema_version", "registry_sha256", "authority", "modes"
        }
        and type(value.get("schema_version")) is int
        and value.get("schema_version") == 1
        and isinstance(value.get("registry_sha256"), str)
        and value.get("registry_sha256") == PREDECESSOR_MIGRATION_REGISTRY_SHA256
        and isinstance(value.get("authority"), str)
        and value.get("authority") == "target-cli-compiled"
        and isinstance(value.get("modes"), list)
        and value.get("modes") == ["replace-and-adopt-complete-set"]
    )


